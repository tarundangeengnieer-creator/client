        <ellipse cx="8" cy="6" rx="3.5" ry="7" fill="none" stroke="#94a3b8" stroke-width="1" />
        <line x1="1" y1="6" x2="15" y2="6" stroke="#94a3b8" stroke-width="1" />
        <text x="24" y="10" class="sans" font-size="11.5" font-weight="900" fill="#cbd5e1" letter-spacing="0.5">DOMAIN</text>

        <!-- Malicious Badge -->
