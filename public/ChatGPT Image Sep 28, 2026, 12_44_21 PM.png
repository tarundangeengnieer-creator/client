<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1140 860" width="100%" height="100%">
  <defs>
    <!-- Background Gradients -->
    <radialGradient id="bgGlow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#0b243d" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#040d18" stop-opacity="1" />
    </radialGradient>
    
    <radialGradient id="nodeGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#18bfff" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#18bfff" stop-opacity="0" />
    </radialGradient>

    <radialGradient id="centerBottomReflection" cx="50%" cy="100%" r="50%">
      <stop offset="0%" stop-color="#18bfff" stop-opacity="0.2" />
      <stop offset="100%" stop-color="transparent" stop-opacity="0" />
    </radialGradient>

    <!-- Gauge Gradient -->
    <linearGradient id="gaugeGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffb800" />
      <stop offset="45%" stop-color="#ff6b35" />
      <stop offset="100%" stop-color="#ff365c" />
    </linearGradient>

    <!-- Subtle Grid for Graph Card -->
    <pattern id="cardGrid" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#0e263d" stroke-width="0.8" />
    </pattern>

    <!-- Card Shadow -->
    <filter id="cardGlow" x="-10%" y="-10%" width="120%" height="120%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.5" />
    </filter>

    <filter id="cyanPillGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#18bfff" flood-opacity="0.4" />
    </filter>
  </defs>

  <style>
    .sans { font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .mono { font-family: ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace; }
  </style>

  <!-- Main Container Frame -->
  <rect x="0" y="0" width="1140" height="860" rx="20" fill="url(#bgGlow)" stroke="#0e2b46" stroke-width="1.5" />

  <!-- Bottom Ambience Glow -->
  <ellipse cx="570" cy="855" rx="320" ry="90" fill="url(#centerBottomReflection)" />

  <!-- ========================================================================= -->
  <!-- 1. TOP HEADER BAR                                                         -->
  <!-- ========================================================================= -->
  <g transform="translate(0, 0)">
    <!-- Brand / Breadcrumbs -->
    <g transform="translate(42, 38)">
      <!-- Glowing Shield Logo -->
      <path d="M 0 6 C 0 0 16 -6 18 -6 C 20 -6 36 0 36 6 C 36 24 20 36 18 38 C 16 36 0 24 0 6 Z" fill="#08243a" stroke="#18bfff" stroke-width="2.2" />
      <path d="M 9 10 C 9 6 18 2 18 2 C 18 2 27 6 27 10 C 27 21 18 29 18 29 C 18 29 9 21 9 10 Z" fill="#18bfff" />
      
      <!-- Brand Text -->
      <text x="48" y="24" class="sans" font-size="23" font-weight="900" letter-spacing="-0.5" fill="#18bfff">
        AShield<tspan fill="#ffffff">ER</tspan>
      </text>

      <!-- Breadcrumbs -->
      <text x="180" y="22" class="sans" font-size="14" font-weight="500" fill="#64748b">
        › &nbsp; <tspan fill="#94a3b8">Investigator</tspan> &nbsp; / &nbsp; <tspan fill="#cbd5e1">Case-A2291</tspan>
      </text>
    </g>

    <!-- Top-Right Status -->
    <g transform="translate(740, 36)">
      <!-- Active Threat Indicator -->
      <circle cx="10" cy="14" r="4.5" fill="#ff365c">
        <animate attributeName="opacity" values="1;0.4;1" dur="2s" repeatCount="indefinite" />
      </circle>
      <text x="24" y="18" class="sans" font-size="13" font-weight="800" letter-spacing="0.5" fill="#ff365c">
        ACTIVE THREAT
      </text>

      <!-- Malicious Badge Button -->
      <g transform="translate(150, -6)">
        <rect x="0" y="0" width="190" height="40" rx="10" fill="#200a12" stroke="#ff365c" stroke-width="1.5" />
        <!-- Shield Icon inside Badge -->
        <path d="M 28 11 C 28 9 37 6 38 6 C 39 6 48 9 48 11 C 48 21 39 27 38 28 C 37 27 28 21 28 11 Z" fill="none" stroke="#ff365c" stroke-width="1.8" />
        <path d="M 34 17 L 37 20 L 43 14" fill="none" stroke="#ff365c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <text x="60" y="25" class="sans" font-size="14" font-weight="900" letter-spacing="1" fill="#ff365c">
          MALICIOUS
        </text>
      </g>
    </g>

    <!-- Horizontal Separator -->
    <line x1="24" y1="88" x2="1116" y2="88" stroke="#0e2b46" stroke-width="1" />
  </g>

  <!-- ========================================================================= -->
  <!-- 2. WORKFLOW STEPPER RIBBON                                                -->
  <!-- ========================================================================= -->
  <g transform="translate(24, 102)">
    <!-- Steps Container -->
    <rect x="0" y="0" width="1092" height="52" rx="10" fill="#061322" stroke="#0d263e" stroke-width="1.2" />

    <!-- Step 1: EMAIL (Completed) -->
    <g transform="translate(22, 14)">
      <circle cx="12" cy="12" r="10" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 7 12 L 11 15 L 17 8" fill="none" stroke="#64748b" stroke-width="1.6" stroke-linecap="round" />
      <text x="32" y="16" class="sans" font-size="12" font-weight="700" fill="#cbd5e1" letter-spacing="0.5">EMAIL</text>
      <text x="96" y="16" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>
    </g>

    <!-- Step 2: EXTRACT (Completed) -->
    <g transform="translate(150, 14)">
      <circle cx="12" cy="12" r="10" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 7 12 L 11 15 L 17 8" fill="none" stroke="#64748b" stroke-width="1.6" stroke-linecap="round" />
      <text x="32" y="16" class="sans" font-size="12" font-weight="700" fill="#cbd5e1" letter-spacing="0.5">EXTRACT</text>
      <text x="114" y="16" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>
    </g>

    <!-- Step 3: DETECT (Completed) -->
    <g transform="translate(296, 14)">
      <circle cx="12" cy="12" r="10" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 7 12 L 11 15 L 17 8" fill="none" stroke="#64748b" stroke-width="1.6" stroke-linecap="round" />
      <text x="32" y="16" class="sans" font-size="12" font-weight="700" fill="#cbd5e1" letter-spacing="0.5">DETECT</text>
      <text x="100" y="16" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>
    </g>

    <!-- Step 4: CORRELATE (Completed) -->
    <g transform="translate(426, 14)">
      <circle cx="12" cy="12" r="10" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 7 12 L 11 15 L 17 8" fill="none" stroke="#64748b" stroke-width="1.6" stroke-linecap="round" />
      <text x="32" y="16" class="sans" font-size="12" font-weight="700" fill="#cbd5e1" letter-spacing="0.5">CORRELATE</text>
      <text x="126" y="16" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>
    </g>

    <!-- Step 5: INTELLIGENCE (Completed) -->
    <g transform="translate(582, 14)">
      <circle cx="12" cy="12" r="10" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 7 12 L 11 15 L 17 8" fill="none" stroke="#64748b" stroke-width="1.6" stroke-linecap="round" />
      <text x="32" y="16" class="sans" font-size="12" font-weight="700" fill="#cbd5e1" letter-spacing="0.5">INTELLIGENCE</text>
      <text x="140" y="16" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>
    </g>

    <!-- Step 6: INVESTIGATE (Active highlighted pill) -->
    <g transform="translate(748, 6)">
      <rect x="0" y="0" width="156" height="40" rx="8" fill="#082b42" stroke="#18bfff" stroke-width="1.8" filter="url(#cyanPillGlow)" />
      <!-- Search Glass Icon -->
      <circle cx="28" cy="20" r="6" fill="none" stroke="#18bfff" stroke-width="2" />
      <line x1="33" y1="24.5" x2="40" y2="31" stroke="#18bfff" stroke-width="2" stroke-linecap="round" />
      <text x="48" y="24" class="sans" font-size="12.5" font-weight="900" fill="#ffffff" letter-spacing="0.8">INVESTIGATE</text>
    </g>

    <text x="926" y="30" class="sans" font-size="13" font-weight="400" fill="#475569">›</text>

    <!-- Step 7: REPORT -->
    <g transform="translate(956, 14)">
      <!-- Document Icon -->
      <path d="M 4 2 L 13 2 L 17 6 L 17 22 L 4 22 Z" fill="none" stroke="#64748b" stroke-width="1.6" />
      <path d="M 13 2 L 13 6 L 17 6" fill="none" stroke="#64748b" stroke-width="1.6" />
      <text x="26" y="16" class="sans" font-size="12" font-weight="700" fill="#94a3b8" letter-spacing="0.5">REPORT</text>
    </g>
  </g>

  <!-- ========================================================================= -->
  <!-- 3. MAIN WORKSPACE 3-COLUMN GRID                                           -->
  <!-- ========================================================================= -->

  <!-- ======================== LEFT COLUMN ======================== -->
  <g transform="translate(24, 178)">
    
    <!-- Card 1: Email Details -->
    <g transform="translate(0, 0)">
      <rect x="0" y="0" width="310" height="195" rx="14" fill="#081728" stroke="#0f2b48" stroke-width="1.2" filter="url(#cardGlow)" />
      
      <!-- Card Header -->
      <path d="M 22 22 L 38 22 L 38 34 L 22 34 Z M 22 23 L 30 29 L 38 23" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <text x="46" y="31" class="sans" font-size="14.5" font-weight="800" fill="#ffffff">Email Details</text>

      <!-- Subject Block -->
      <g transform="translate(20, 52)">
        <text x="0" y="12" class="sans" font-size="11.5" font-weight="500" fill="#64748b">Subject</text>
        <text x="0" y="32" class="sans" font-size="13.5" font-weight="800" fill="#f8fafc">Urgent: Verify Your PayPal</text>
        <text x="0" y="50" class="sans" font-size="13.5" font-weight="800" fill="#f8fafc">Account</text>
        <!-- Copy Icon -->
        <g transform="translate(245, 18)" opacity="0.6">
          <rect x="0" y="4" width="13" height="13" rx="2" fill="none" stroke="#94a3b8" stroke-width="1.4" />
          <path d="M 4 4 L 4 0 L 17 0 L 17 13 L 13 13" fill="none" stroke="#94a3b8" stroke-width="1.4" />
        </g>
      </g>

      <!-- Sender Block -->
      <g transform="translate(20, 128)">
        <text x="0" y="10" class="sans" font-size="11.5" font-weight="500" fill="#64748b">Sender</text>
        <text x="0" y="30" class="mono" font-size="12" font-weight="600" fill="#cbd5e1">security-alert@paypal-....</text>
        <!-- Copy Icon -->
        <g transform="translate(245, 16)" opacity="0.6">
          <rect x="0" y="4" width="13" height="13" rx="2" fill="none" stroke="#94a3b8" stroke-width="1.4" />
          <path d="M 4 4 L 4 0 L 17 0 L 17 13 L 13 13" fill="none" stroke="#94a3b8" stroke-width="1.4" />
        </g>
      </g>
    </g>

    <!-- Card 2: Authentication -->
    <g transform="translate(0, 215)">
      <rect x="0" y="0" width="310" height="195" rx="14" fill="#081728" stroke="#0f2b48" stroke-width="1.2" filter="url(#cardGlow)" />
      
      <!-- Card Header -->
      <path d="M 22 21 C 22 17 30 14 30 14 C 30 14 38 17 38 21 C 38 29 30 35 30 35 C 30 35 22 29 22 21 Z" fill="none" stroke="#94a3b8" stroke-width="1.8" />
      <text x="46" y="29" class="sans" font-size="14.5" font-weight="800" fill="#ffffff">Authentication</text>

      <!-- FAILED Badge -->
      <rect x="220" y="14" width="70" height="24" rx="6" fill="#2a0c16" stroke="#ff365c" stroke-width="1.2" />
      <text x="255" y="30" class="sans" font-size="11" font-weight="900" fill="#ff365c" text-anchor="middle" letter-spacing="0.5">FAILED</text>

      <!-- Donut Gauge Chart -->
      <g transform="translate(24, 58)">
        <!-- Track Ring -->
        <circle cx="50" cy="50" r="42" fill="none" stroke="#0d243a" stroke-width="11" />
        <!-- Failed Red Arc (all 3 failed = solid red stroke) -->
        <circle cx="50" cy="50" r="42" fill="none" stroke="#ff365c" stroke-width="11" stroke-dasharray="264" stroke-dashoffset="0" transform="rotate(-90 50 50)" />
        <text x="50" y="50" class="sans" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle">0/3</text>
        <text x="50" y="67" class="sans" font-size="10.5" font-weight="700" fill="#64748b" text-anchor="middle" letter-spacing="0.5">PASS</text>
      </g>

      <!-- Auth Items -->
      <g transform="translate(155, 66)">
        <!-- SPF -->
        <circle cx="5" cy="14" r="3.5" fill="#ff365c" />
        <text x="18" y="18" class="sans" font-size="13" font-weight="700" fill="#cbd5e1">SPF</text>
        <text x="110" y="18" class="sans" font-size="12" font-weight="900" fill="#ff365c" text-anchor="end">FAIL</text>

        <!-- DKIM -->
        <circle cx="5" cy="46" r="3.5" fill="#ff365c" />
        <text x="18" y="50" class="sans" font-size="13" font-weight="700" fill="#cbd5e1">DKIM</text>
        <text x="110" y="50" class="sans" font-size="12" font-weight="900" fill="#ff365c" text-anchor="end">FAIL</text>

        <!-- DMARC -->
        <circle cx="5" cy="78" r="3.5" fill="#ff365c" />
        <text x="18" y="82" class="sans" font-size="13" font-weight="700" fill="#cbd5e1">DMARC</text>
        <text x="110" y="82" class="sans" font-size="12" font-weight="900" fill="#ff365c" text-anchor="end">FAIL</text>
      </g>
    </g>

    <!-- Card 3: Risk Assessment -->
    <g transform="translate(0, 430)">
      <rect x="0" y="0" width="310" height="215" rx="14" fill="#081728" stroke="#0f2b48" stroke-width="1.2" filter="url(#cardGlow)" />

      <!-- Card Header -->
      <g transform="translate(20, 16)">
        <path d="M 4 16 L 4 8 M 10 16 L 10 4 M 16 16 L 16 11" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" />
        <text x="26" y="14" class="sans" font-size="14.5" font-weight="800" fill="#ffffff">Risk Assessment</text>
      </g>

      <!-- CRITICAL Badge -->
      <rect x="210" y="14" width="80" height="24" rx="6" fill="#2a0c16" stroke="#ff365c" stroke-width="1.2" />
      <text x="250" y="30" class="sans" font-size="11" font-weight="900" fill="#ff365c" text-anchor="middle" letter-spacing="0.5">CRITICAL</text>

      <!-- Semi-circular Speedometer Gauge -->
      <g transform="translate(30, 48)">
        <!-- Gauge Track Arc -->
        <path d="M 25 100 A 90 90 0 0 1 225 100" fill="none" stroke="#0d243a" stroke-width="13" stroke-linecap="round" />
        
        <!-- Active Gauge Gradient Arc (fills to 91%) -->
        <path d="M 25 100 A 90 90 0 0 1 216 66" fill="none" stroke="url(#gaugeGrad)" stroke-width="13" stroke-linecap="round" />
        
        <!-- Needle Indicator Knob at 91% -->
        <circle cx="216" cy="66" r="6" fill="#ffffff" stroke="#ff365c" stroke-width="2.5" />

        <!-- Gauge Text Values -->
        <text x="18" y="118" class="sans" font-size="12" font-weight="700" fill="#64748b">0</text>
        <text x="232" y="118" class="sans" font-size="12" font-weight="700" fill="#64748b" text-anchor="end">100</text>

        <!-- Center Score -->
        <text x="125" y="85" class="sans" text-anchor="middle">
          <tspan font-size="34" font-weight="900" fill="#ff365c">91</tspan>
          <tspan font-size="18" font-weight="700" fill="#64748b">/100</tspan>
        </text>

        <!-- Verdict Text -->
        <text x="125" y="108" class="sans" font-size="14" font-weight="900" letter-spacing="1" fill="#ff365c" text-anchor="middle">
          MALICIOUS
        </text>

        <!-- Subtitle -->
        <text x="125" y="142" class="sans" font-size="12.5" font-weight="600" fill="#94a3b8" text-anchor="middle">
          High Risk Phishing Attack
        </text>
      </g>
    </g>

  </g>

  <!-- ======================== CENTER COLUMN ======================== -->
  <g transform="translate(356, 178)">

    <!-- Card 1: Entity Relationship Graph -->
    <g transform="translate(0, 0)">
      <rect x="0" y="0" width="428" height="410" rx="14" fill="#061322" stroke="#0e2b46" stroke-width="1.2" filter="url(#cardGlow)" />
      
      <!-- Graph Grid Background -->
      <rect x="2" y="52" width="424" height="354" fill="url(#cardGrid)" opacity="0.6" />

      <!-- Center Ambient Glow -->
      <circle cx="214" cy="180" r="140" fill="url(#nodeGlow)" />

      <!-- Card Header -->
      <g transform="translate(20, 20)">
        <!-- Network Nodes Icon -->
        <circle cx="4" cy="6" r="3" fill="#18bfff" />
        <circle cx="14" cy="16" r="3" fill="#18bfff" />
        <circle cx="20" cy="4" r="3" fill="#18bfff" />
        <line x1="4" y1="6" x2="14" y2="16" stroke="#18bfff" stroke-width="1.5" />
        <line x1="14" y1="16" x2="20" y2="4" stroke="#18bfff" stroke-width="1.5" />

        <text x="32" y="13" class="sans" font-size="14.5" font-weight="800" fill="#ffffff">Entity Relationship Graph</text>
      </g>

      <!-- Header Subtitle / Expand -->
      <text x="360" y="28" class="sans" font-size="11.5" font-weight="600" fill="#64748b" text-anchor="end">5 primary</text>
      <text x="360" y="42" class="sans" font-size="11.5" font-weight="600" fill="#64748b" text-anchor="end">nodes</text>
      <g transform="translate(390, 22)">
        <path d="M 0 4 L 4 0 L 10 0 M 10 0 L 10 6" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
        <path d="M 10 6 L 6 10 L 0 10 M 0 10 L 0 4" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
      </g>

      <!-- Connecting Lines from Central Node to Child Nodes -->
      <g stroke="#1b4b72" stroke-width="2" stroke-linecap="round">
        <line x1="214" y1="170" x2="68" y2="280" />
        <line x1="214" y1="170" x2="164" y2="280" />
        <line x1="214" y1="170" x2="264" y2="280" />
        <line x1="214" y1="170" x2="360" y2="280" />
      </g>

      <!-- 1. Central EMAIL (Source) Node -->
      <g transform="translate(214, 150)">
        <circle cx="0" cy="0" r="38" fill="#082035" stroke="#18bfff" stroke-width="3" filter="url(#cyanPillGlow)" />
        <circle cx="0" cy="0" r="28" fill="#041220" stroke="#0e3557" stroke-width="1.5" />
        <!-- Email Icon -->
        <path d="M -11 -7 L 11 -7 L 11 7 L -11 7 Z M -11 -6 L 0 2 L 11 -6" fill="none" stroke="#18bfff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="0" y="52" class="sans" font-size="13" font-weight="900" fill="#18bfff" text-anchor="middle" letter-spacing="0.5">EMAIL</text>
        <text x="0" y="68" class="sans" font-size="11.5" font-weight="500" fill="#64748b" text-anchor="middle">(Source)</text>
      </g>

      <!-- 2. Child Node 1: IP (Malicious) -->
      <g transform="translate(68, 280)">
        <circle cx="0" cy="0" r="24" fill="#081728" stroke="#38bdf8" stroke-width="1.8" />
        <!-- Monitor Icon -->
        <rect x="-8" y="-7" width="16" height="11" rx="1.5" fill="none" stroke="#cbd5e1" stroke-width="1.6" />
        <line x1="-3" y1="7" x2="3" y2="7" stroke="#cbd5e1" stroke-width="1.6" />
        <line x1="0" y1="4" x2="0" y2="7" stroke="#cbd5e1" stroke-width="1.6" />
        <text x="0" y="38" class="sans" font-size="12" font-weight="800" fill="#ffffff" text-anchor="middle">IP</text>
        <text x="0" y="52" class="sans" font-size="10.5" font-weight="700" fill="#ff365c" text-anchor="middle">(Malicious)</text>
      </g>

      <!-- 3. Child Node 2: DOMAIN (Impersonation) -->
      <g transform="translate(164, 280)">
        <circle cx="0" cy="0" r="24" fill="#081728" stroke="#38bdf8" stroke-width="1.8" />
        <!-- Globe Icon -->
        <circle cx="0" cy="0" r="9" fill="none" stroke="#cbd5e1" stroke-width="1.6" />
        <ellipse cx="0" cy="0" rx="4.5" ry="9" fill="none" stroke="#cbd5e1" stroke-width="1.2" />
        <line x1="-9" y1="0" x2="9" y2="0" stroke="#cbd5e1" stroke-width="1.2" />
        <text x="0" y="38" class="sans" font-size="12" font-weight="800" fill="#ffffff" text-anchor="middle">DOMAIN</text>
        <text x="0" y="52" class="sans" font-size="10.5" font-weight="600" fill="#94a3b8" text-anchor="middle">(Impersonation)</text>
      </g>

      <!-- 4. Child Node 3: URL (Suspicious) -->
      <g transform="translate(264, 280)">
        <circle cx="0" cy="0" r="24" fill="#081728" stroke="#38bdf8" stroke-width="1.8" />
        <!-- Link Icon -->
        <path d="M -5 2 L -2 5 A 4 4 0 0 0 4 -1 L 1 -4" fill="none" stroke="#cbd5e1" stroke-width="1.6" stroke-linecap="round" />
        <path d="M 5 -2 L 2 -5 A 4 4 0 0 0 -4 1 L -1 4" fill="none" stroke="#cbd5e1" stroke-width="1.6" stroke-linecap="round" />
        <text x="0" y="38" class="sans" font-size="12" font-weight="800" fill="#ffffff" text-anchor="middle">URL</text>
        <text x="0" y="52" class="sans" font-size="10.5" font-weight="700" fill="#ffb800" text-anchor="middle">(Suspicious)</text>
      </g>

      <!-- 5. Child Node 4: ATTACHMENT (Malicious) -->
      <g transform="translate(360, 280)">
        <circle cx="0" cy="0" r="24" fill="#081728" stroke="#38bdf8" stroke-width="1.8" />
        <!-- Document Icon -->
        <path d="M -5 -7 L 2 -7 L 6 -3 L 6 7 L -5 7 Z" fill="none" stroke="#cbd5e1" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M 2 -7 L 2 -3 L 6 -3" fill="none" stroke="#cbd5e1" stroke-width="1.6" />
        <text x="0" y="38" class="sans" font-size="11" font-weight="800" fill="#ffffff" text-anchor="middle">ATTACHMENT</text>
        <text x="0" y="52" class="sans" font-size="10.5" font-weight="700" fill="#ff365c" text-anchor="middle">(Malicious)</text>
      </g>
    </g>

    <!-- Card 2: Key Findings -->
    <g transform="translate(0, 430)">
