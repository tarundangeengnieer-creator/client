=> {    if (ui.currentPath === \'/login\') {      return <LoginPage />;    }    if (ui.currentPath === \'/\' || ui.currentPath === \'/overview\') {      return <SecurityOverviewPage />;    }    if (ui.currentPath === \'/inbox\' || ui.currentPath === \'/cases\') {      return <CaseInboxPage />;    }    if (ui.currentPath.startsWith(\'/case\')) {      return <CaseDetailPage />;    }    if (ui.currentPath.startsWith(\'/investigation\') || ui.currentPath === \'/ingest\') {      return <InvestigationPage />;    }    if (ui.currentPath.startsWith(\'/hunting\')) {      return <HuntingPlaceholder />;    }    if (ui.currentPath.startsWith(\'/reports\')) {      return <CaseDetailPage />;    }    if (ui.currentPath.startsWith(\'/evidence\')) {      return <CaseDetailPage />;    }    if (ui.currentPath.startsWith(\'/admin/health\')) {      return <HealthPlaceholder />;    }    if (ui.currentPath.startsWith(\'/settings\')) {      return <SettingsPlaceholder />;    }    return <NotFoundPage />;  };  return (    <ErrorBoundary>      <AppShell>        {renderRoute()}      </AppShell>    </ErrorBoundary>  );}"
