RowMenu(false);\n                    onOpenWorkspace(caseItem, e);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <ExternalLink className=\"w-3.5 h-3.5 text-blue-500\" />\n                  <span>Open Workspace</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    setShowRowMenu(false);\n                    onQuickPeek(caseItem.id, e);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <Eye className=\"w-3.5 h-3.5 text-sky-500\" />\n                  <span>Quick Peek</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    navigator.clipboard.writeText(caseItem.id);\n                    uiStore.addToast(\'info\', `Copied Case #${caseItem.id} to clipboard`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                  <span>Copy Case ID</span>\n                </button>\n\n                <div className=\"my-1 border-t border-slate-100 dark:border-slate-800\" />\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    casesStore.setCaseVerdict(caseItem.id, Verdict.MALICIOUS);\n                    uiStore.addToast(\'warning\', `Marked Case #${caseItem.id} as Malicious`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 cursor-pointer\"\n                >\n                  <ShieldAlert className=\"w-3.5 h-3.5\" />\n                  <span>Mark Malicious</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    casesStore.setCaseVerdict(caseItem.id, Verdict.BENIGN);\n                    uiStore.addToast(\'success\', `Marked Case #${caseItem.id} as Benign`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer\"\n                >\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  <span>Mark Benign</span>\n                </button>\n              </div>\n            )}\n          </td>"
