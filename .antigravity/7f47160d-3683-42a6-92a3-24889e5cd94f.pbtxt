-slate-200/90 dark:border-slate-800/80 flex flex-col justify-between select-none z-40 lg:z-20 shrink-0 h-full transition-transform duration-200 ease-in-out ${\n        ui.isMobileSidebarOpen ? \'translate-x-0 shadow-2xl\' : \'-translate-x-full lg:translate-x-0\'\n      }`}\n    >\n      {/* Top Header & Brand */}\n      <div>\n        <div className=\"px-5 pt-6 pb-5 flex items-center justify-between\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"flex items-center gap-3 cursor-pointer group min-w-0\"\n          >\n            {/* Blue Shield Icon with Checkmark matching reference image */}\n            <div className=\"w-9 h-9 rounded-xl bg-[#1a68ff] flex items-center justify-center text-white shadow-sm shrink-0\">\n              <svg className=\"w-5 h-5 fill-current\" viewBox=\"0 0 24 24\">\n                <path d=\"M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1.06 14.54L6.7 12.3a.75.75 0 0 1 1.06-1.06l3.18 3.18 6.36-6.36a.75.75 0 0 1 1.06 1.06l-7.42 7.42z\" />\n              </svg>\n            </div>\n\n            {/* Wordmark and Tagline */}\n            <div className=\"min-w-0\">\n              <div className=\"font-black text-slate-900 dark:text-white text-base tracking-wider leading-none\">\n                ASHIELDER\n              </div>\n              <p className=\"text-[8.5px] font-semibold text-slate-400 dark:text-slate-500 tracking-widest uppercase mt-1 leading-tight\">\n                SECURE \342\200\242 ANALYSE \342\200\242 PROTECT\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => uiStore.setMobileSidebarOpen(false)}\n            className=\"lg:hidden p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors ml-2 shrink-0 cursor-pointer\"\n            aria-label=\"Close navigation\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Main Navigation Items */}\n        <nav className=\"px-3 py-2 space-y-1\">\n          {navItems.map((item) => {\n            const active = isCurrentActive(item.path);\n            return (\n              <button\n                key={item.id}\n                id={`sidebar-nav-${item.id}`}\n                type=\"button\"\n                onClick={() => uiStore.navigate(item.path)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-left cursor-pointer ${\n                  active\n                    ? \'bg-[#edf4ff] text-[#1a68ff] font-semibold dark:bg-blue-950/60 dark:text-sky-400\'\n                    : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-900/60\'\n                }`}\n              >\n                <span className={active ? \'text-[#1a68ff] dark:text-sky-400\' : \'text-slate-500 dark:text-slate-400\'}>\n                  {item.icon}\n                </span>\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Bottom Auxiliary Section matching Reference Image */}\n      <div className=\"p-3 space-y-2\">\n        {/* Bottom Card: \"AI-Powered Email Forensic Intelligence, Safer Institutions, Stronger India\" with India map silhouette */}\n        <div className=\"rounded-xl border border-slate-200/90 dark:border-slate-800 bg-[#edf3f9]/70 dark:bg-slate-900/80 p-3.5 flex items-center justify-between gap-2 overflow-hidden shadow-2xs\">\n          <div className=\"min-w-0 pr-1\">\n            <p className=\"text-[11px] font-bold text-slate-800 dark:text-slate-200 leading-tight\">\n              AI-Powered Email Forensic Intelligence\n            </p>\n            <p className=\"text-[10.5px] text-slate-500 dark:text-slate-400