      target_content: "        <div className=\"px-4.5 pt-5 pb-4 flex items-center justify-between\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"cursor-pointer group min-w-0 transition-opacity hover:opacity-95\"\n            title=\"ASHIELDER - Feasible & Viable\"\n          >\n            <AshielderLogo\n              size=\"md\"\n              variant=\"full\"\n              theme={ui.theme === \'dark\' ? \'dark\' : \'light\'}\n            />\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => uiStore.setMobileSidebarOpen(false)}\n            className=\"lg:hidden p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors ml-2 shrink-0 cursor-pointer\"\n            aria-label=\"Close navigation\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>"
      replacement_content: "        <div className=\"relative px-4 pt-5 pb-3.5 flex items-center justify-between\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"cursor-pointer group min-w-0 transition-opacity hover:opacity-95\"\n            title=\"ASHIELDER - Return to Overview\"\n          >\n            <AshielderLogo\n              size=\"md\"\n              variant=\"full\"\n              theme={ui.theme === \'dark\' ? \'dark\' : \'light\'}\n              onDotsClick={(e) => {\n                e.stopPropagation();\n                setShowOptions((prev) => !prev);\n              }}\n            />\n          </div>\n\n          <div className=\"flex items-center gap-0.5 shrink-0 ml-1\">\n            {/* Dedicated 3-Dots Options Menu Button */}\n            <button\n              id=\"sidebar-more-options-btn\"\n              type=\"button\"\n              onClick={(e) => {\n                e.stopPropagation();\n                setShowOptions((prev) => !prev);\n              }}\n              className={`p-1.5 rounded-lg transition-colors cursor-pointer ${\n                showOptions\n                  ? \'bg-blue-50 text-blue-600 dark:bg-slate-800 dark:text-sky-400\'\n                  : \'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80\'\n              }`}\n              title=\"Workstation Options & Actions (3 Dots)\"\n              aria-label=\"Workstation Options\"\n            >\n              <MoreVertical className=\"w-4 h-4\" />\n            </button>\n\n            {/* Mobile Sidebar Close */}\n            <button\n              type=\"button\"\n              onClick={() => uiStore.setMobileSidebarOpen(false)}\n              className=\"lg:hidden p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shrink-0 cursor-pointer\"\n              aria-label=\"Close navigation\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* 3-Dots Dropdown Popover */}\n          {showOptions && (\n            <div\n              ref={optionsRef}\n              className=\"absolute left-3 right-3 top-full mt-1 bg-white dark:bg-[#0c1322] border border-slate-200 dark:border-slate-800 rounded-xl shadow-2xl p-2 z-50 text-xs animate-in fade-in zoom-in-95 duration-100\"\n            >\n              {/* Header Info */}\n              <div className=\"px-2.5 py-2 border-b border-slate-100 dark:border-slate-800/80\">\n                <div className=\"font-bold text-slate-900 dark:text-slate-100 flex items-center justify-between\">\n                  <span>ASHIELDER Workstation</span>\n                  <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-sky-400 font-mono font-medium\">v1.0.4</span>\n                </div>\n                <div className=\"flex items-center gap-1.5 mt-1 text-[11px] text-emerald-600 dark:text-emerald-400 font-medium\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n                  <span>Engine Active \342\200\242 CDGI SOC</span>\n                </div>\n              </div>\n\n              {/* Quick Navigation / Actions */}\n              <div className=\"py-1.5 space-y-0.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.navigate(\'/overview\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <ShieldAlert className=\"w-3.5 h-3.5 text-blue-500 shrink-0\" />\n                  <span>Security Overview</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.navigate(\'/investigation\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <Search className=\"w-3.5 h-3.5 text-sky-500 shrink-0\" />\n                  <span>New Investigation / Ingest</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.navigate(\'/hunting\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <Database className=\"w-3.5 h-3.5 text-indigo-500 shrink-0\" />\n                  <span>Threat Intelligence Hub</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.navigate(\'/evidence\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <Archive className=\"w-3.5 h-3.5 text-emerald-500 shrink-0\" />\n                  <span>Evidence Vault</span>\n                </button>\n              </div>\n\n              {/* Auxiliary / Settings / Theme */}\n              <div className=\"pt-1.5 mt-1 border-t border-slate-100 dark:border-slate-800/80 space-y-0.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.navigate(\'/settings\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <Settings className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                  <span>Workstation Settings</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowOptions(false);\n                    uiStore.toggleTheme();\n                  }}\n                  className=\"w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 text-left transition-colors cursor-pointer\"\n                >\n                  <div className=\"flex items-center gap-2.5\">\n                    {ui.theme === \'dark\' ? (\n                      <Sun className=\"w-3.5 h-3.5 text-amber-400 shrink-0\" />\n                    ) : (\n                      <Moon className=\"w-3.5 h-3.5 text-slate-600 shrink-0\" />\n                    )}\n                    <span>Theme Mode</span>\n                  </div>\n                  <span className=\"text-[10.5px] text-slate-400 capitalize\">{ui.theme}</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>"
    }
