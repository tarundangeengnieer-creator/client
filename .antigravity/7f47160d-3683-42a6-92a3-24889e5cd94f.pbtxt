      arguments_json: "{\"Content\":\"import React from \'react\';\\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\\nimport {\\n  LayoutDashboard,\\n  Search,\\n  Globe,\\n  FileText,\\n  Archive,\\n  Settings,\\n  X,\\n  Sun,\\n  Moon,\\n  Shield,\\n  Check,\\n} from \'lucide-react\';\\n\\ninterface NavItem {\\n  id: string;\\n  path: string;\\n  label: string;\\n  icon: React.ReactNode;\\n}\\n\\nexport const Sidebar: React.FC = () => {\\n  const ui = useUI();\\n\\n  // Primary Navigation items matching the reference image\\n  const navItems: NavItem[] = [\\n    {\\n      id: \'dashboard\',\\n      path: \'/overview\',\\n      label: \'Dashboard\',\\n      icon: <LayoutDashboard className=\\\"w-4 h-4\\\" />,\\n    },\\n    {\\n      id: \'investigation\',\\n      path: \'/investigation\',\\n      label: \'Investigation\',\\n      icon: <Search className=\\\"w-4 h-4\\\" />,\\n    },\\n    {\\n      id: \'threat-intel\',\\n      path: \'/hunting\',\\n      label: \'Threat Intelligence\',\\n      icon: <Globe className=\\\"w-4 h-4\\\" />,\\n    },\\n    {\\n      id: \'reports\',\\n      path: \'/reports\',\\n      label: \'Reports\',\\n      icon: <FileText className=\\\"w-4 h-4\\\" />,\\n    },\\n    {\\n      id: \'evidence\',\\n      path: \'/evidence\',\\n      label: \'Evidence Vault\',\\n      icon: <Archive className=\\\"w-4 h-4\\\" />,\\n    },\\n    {\\n      id: \'settings\',\\n      path: \'/settings\',\\n      label: \'Settings\',\\n      icon: <Settings className=\\\"w-4 h-4\\\" />,\\n    },\\n  ];\\n\\n  const isCurrentActive = (itemPath: string) => {\\n    if (itemPath === \'/overview\' && (ui.currentPath === \'/\' || ui.currentPath === \'/overview\')) {\\n      return true;\\n    }\\n    if (itemPath === \'/investigation\' && (ui.currentPath.startsWith(\'/investigation\') || ui.currentPath === \'/ingest\')) {\\n      return true;\\n    }\\n    return ui.currentPath.startsWith(itemPath);\\n  };\\n\\n  return (\\n    <aside\\n      id=\\\"app-sidebar\\\"\\n      className={`fixed lg:static inset-y-0 left-0 w-60 bg-white dark:bg-[#060a14] border-r border-slate-200/90 dark:border-slate-800/80 flex flex-col justify-between select-none z-40 lg:z-20 shrink-0 h-full transition-transform duration-200 ease-in-out ${\\n        ui.isMobileSidebarOpen ? \'translate-x-0 shadow-2xl\' : \'-translate-x-full lg:translate-x-0\'\\n      }`}\\n    >\\n      {/* Top Header & Brand */}\\n      <div>\\n        <div className=\\\"px-5 pt-6 pb-5 flex items-center justify-between\\\">\\n          <div\\n            onClick={() => uiStore.navigate(\'/overview\')}\\n            className=\\\"flex items-center gap-3 cursor-pointer group min-w-0\\\"\\n          >\\n            {/* Blue Shield Icon with Checkmark matching reference image */}\\n            <div className=\\\"w-9 h-9 rounded-xl bg-[#1a68ff] flex items-center justify-center text-white shadow-sm shrink-0\\\">\\n              <svg className=\\\"w-5 h-5 fill-current\\\" viewBox=\\\"0 0 24 24\\\">\\n                <path d=\\\"M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1.06 14.54L6.7 12.3a.75.75 0 0 1 1.06-1.06l3.18 3.18 6.36-6.36a.75.75 0 0 1 1.06 1.06l-7.42 7.42z\\\" />\\n              </svg>\\n            </div>\\n\\n            {/* Wordmark and Tagline */}\\n            <div className=\\\"min-w-0\\\">\\n              <div className=\\\"font-black text-slate-900 dark:text-white text-base tracking-wider leading-none\\\">\\n                ASHIELDER\\n              </div>\\n              <p className=\\\"text-[8.5px] font-semibold text-slate-400 dark:text-slate-500 tracking-widest uppercase mt-1 leading-tight\\\">\\n                SECURE \342\200\242 ANALYSE \342\200\242 PROTECT\\n              </p>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => uiStore.setMobileSidebarOpen(false)}\\n            className=\\\"lg:hidden p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors ml-2 shrink-0 cursor-pointer\\\"\\n            aria-label=\\\"Close navigation\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Main Navigation Items */}\\n        <nav className=\\\"px-3 py-2 space-y-1\\\">\\n          {navItems.map((item) => {\\n            const active = isCurrentActive(item.path);\\n            return (\\n              <button\\n                key={item.id}\\n                id={`sidebar-nav-${item.id}`}\\n                type=\\\"button\\\"\\n                onClick={() => uiStore.navigate(item.path)}\\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-left cursor-pointer ${\\n                  active\\n                    ? \'bg-[#edf4ff] text-[#1a68ff] font-semibold dark:bg-blue-950/60 dark:text-sky-400\'\\n                    : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-900/60\'\\n                }`}\\n              >\\n                <span className={active ? \'text-[#1a68ff] dark:text-sky-400\' : \'text-slate-500 dark:text-slate-400\'}>\\n                  {item.icon}\\n                </span>\\n                <span>{item.label}</span>\\n              </button>\\n            );\\n          })}\\n        </nav>\\n      </div>\\n\\n      {/* Bottom Auxiliary Section matching Reference Image */}\\n      <div className=\\\"p-3 space-y-2\\\">\\n        {/* Bottom Card: \\\"AI-Powered Email Forensic Intelligence, Safer Institutions, Stronger India\\\" with India map silhouette */}\\n        <div className=\\\"rounded-xl border border-slate-200/90 dark:border-slate-800 bg-[#edf3f9]/70 dark:bg-slate-900/80 p-3.5 flex items-center justify-between gap-2 overflow-hidden shadow-2xs\\\">\\n          <div className=\\\"min-w-0 pr-1\\\">\\n            <p className=\\\"text-[11px] font-bold text-slate-800 dark:text-slate-200 leading-tight\\\">\\n              AI-Powered Email Forensic Intelligence\\n            </p>\\n            <p className=\\\"text-[10.5px] text-slate-500 dark:text-slate-400 mt-1 leading-tight\\\">\\n              Safer Institutions\\n            </p>\\n            <p className=\\\"text-[11px] font-bold text-[#1a68ff] dark:text-sky-400 leading-tight\\\">\\n              Stronger India\\n            </p>\\n          </div>\\n\\n          {/* India SVG Silhouette matching exact coordinates */}\\n          <div className=\\\"w-11 h-12 shrink-0 opacity-80 dark:opacity-60 flex items-center justify-center\\\">\\n            <svg\\n              viewBox=\\\"550 113 68 64\\\"\\n              className=\\\"w-full h-full text-slate-400 dark:text-slate-500 fill-current\\\"\\n            >\\n              <path d=\\\"M616.286,130.136L616.446,130.979L615.67,131.385L615.854,132.754L614.262,132.352L611.39,133.886L611.454,135.158L610.23,137.023L610.118,138.106L609.126,139.938L607.39,139.43L607.302,141.732L606.798,142.488L607.038,143.432L605.942,143.959L604.766,140.435L604.158,140.442L603.79,141.86L602.574,140.709L603.262,139.445L604.254,139.317L605.278,137.437L603.998,137.057L601.942,137.087L599.822,136.782L599.63,135.24L598.566,135.127L596.806,134.168L596.022,135.677L597.622,136.854L596.238,137.681L595.742,138.49L597.11,139.088L596.734,140.427L597.502,142.097L597.846,143.925L597.534,144.737L596.022,144.711L593.278,145.17L593.406,146.844L592.222,148.156L589.022,149.653L586.534,152.267L584.862,153.67L582.654,155.126L582.646,156.145L581.542,156.694L579.534,157.492L578.502,157.608L577.83,159.301L578.294,162.193L578.414,164.036L577.47,166.146L577.462,169.923L576.31,170.032L575.302,171.724L575.974,172.458L573.95,173.09L573.206,174.598L572.31,175.237L570.206,173.161L569.182,170.051L568.326,167.809L567.55,166.76L566.366,164.623L565.814,161.844L565.43,160.456L563.406,157.405L562.486,153.099L5