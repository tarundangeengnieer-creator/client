        target_content: "    persistState(updatedCases, updatedInvs);\n    notifyCases();\n  },\n\n  toggleSelect(id: string): void {"
        replacement_content: "    persistState(updatedCases, updatedInvs);\n    notifyCases();\n  },\n\n  updateCaseVerdict(id: string, verdict: Verdict): void {\n    const updatedCases = currentCasesState.cases.map((c) => {\n      if (c.id === id) {\n        return {\n          ...c,\n          verdict,\n          riskScore:\n            verdict === Verdict.MALICIOUS\n              ? Math.max(85, c.riskScore)\n              : verdict === Verdict.BENIGN\n              ? Math.min(15, c.riskScore)\n              : c.riskScore,\n        };\n      }\n      return c;\n    });\n    const updatedInvs = { ...currentCasesState.investigations };\n    if (updatedInvs[id]) {\n      updatedInvs[id] = {\n        ...updatedInvs[id],\n        verdict,\n        risk_score:\n          verdict === Verdict.MALICIOUS\n            ? Math.max(85, updatedInvs[id].risk_score)\n            : verdict === Verdict.BENIGN\n            ? Math.min(15, updatedInvs[id].risk_score)\n            : updatedInvs[id].risk_score,\n      };\n    }\n    currentCasesState = {\n      ...currentCasesState,\n      cases: updatedCases,\n      investigations: updatedInvs,\n    };\n    persistState(updatedCases, updatedInvs);\n    notifyCases();\n  },\n\n  toggleSelect(id: string): void {"
      }
      num_matches: 1
    }
