      replacement_content: "              <div className=\"relative\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowMoreActions((prev) => !prev)}\n                  className={`p-2 rounded-lg border transition-colors shadow-2xs cursor-pointer ${\n                    showMoreActions\n                      ? \'bg-blue-50 text-blue-600 border-blue-200 dark:bg-slate-800 dark:text-sky-400 dark:border-slate-700\'\n                      : \'bg-white dark:bg-[#0e1627] hover:bg-slate-50 dark:hover:bg-slate-800 border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400\'\n                  }`}\n                  title=\"More Actions (3 Dots)\"\n                >\n                  <MoreHorizontal className=\"w-4 h-4\" />\n                </button>\n\n                {showMoreActions && (\n                  <div\n                    onClick={(e) => e.stopPropagation()}\n                    className=\"absolute right-0 top-full mt-1.5 w-56 bg-white dark:bg-[#0e1627] border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-1.5 z-40 text-xs text-left animate-in fade-in duration-100\"\n                  >\n                    <div className=\"px-2.5 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n                      Forensic Actions\n                    </div>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setShowMoreActions(false);\n                        handleDownloadReport();\n                      }}\n                      className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n                    >\n                      <Download className=\"w-3.5 h-3.5 text-blue-500\" />\n                      <span>Download PDF Brief</span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setShowMoreActions(false);\n                        navigator.clipboard.writeText(JSON.stringify(caseData, null, 2));\n                        uiStore.addToast(\'success\', \'Case JSON payload copied to clipboard\');\n                      }}\n                      className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n                    >\n                      <Copy className=\"w-3.5 h-3.5 text-sky-500\" />\n                      <span>Copy Full JSON Data</span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setShowMoreActions(false);\n                        uiStore.addToast(\'info\', \'STIX 2.1 Threat Bundle generated and ready for export\');\n                      }}\n                      className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n                    >\n                      <Share2 className=\"w-3.5 h-3.5 text-indigo-500\" />\n                      <span>Export STIX 2.1 Bundle</span>\n                    </button>\n                    <div className=\"my-1 border-t border-slate-100 dark:border-slate-800\" />\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setShowMoreActions(false);\n                        uiStore.addToast(\'success\', \'Case submitted to SIEM & SOAR webhook integration\');\n                      }}\n                      className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n                    >\n     