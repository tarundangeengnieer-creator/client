    instruction: "Make the 3-dots button in standard density row interactive with action popover"
    replacement_infos {
      original_chunk {
        target_content: "          {/* Actions */}\n          <td className=\"w-20 px-3 align-middle text-right\">\n            <div className=\"flex items-center justify-end gap-1\">\n              <button\n                type=\"button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onQuickPeek(caseItem.id, e);\n                }}\n                title=\"Quick Peek (Space)\"\n                className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <Eye className=\"w-4 h-4\" />\n              </button>\n              <button\n                type=\"button\"\n                className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </td>"
        replacement_content: "          {/* Actions */}\n          <td className=\"w-20 px-3 align-middle text-right relative\">\n            <div className=\"flex items-center justify-end gap-1\">\n              <button\n                type=\"button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onQuickPeek(caseItem.id, e);\n                }}\n                title=\"Quick Peek (Space)\"\n                className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <Eye className=\"w-4 h-4\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  setShowRowMenu((prev) => !prev);\n                }}\n                className={`p-1 rounded transition-colors cursor-pointer ${\n                  showRowMenu\n                    ? \'text-blue-600 dark:text-sky-400 bg-slate-100 dark:bg-slate-800\'\n                    : \'text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800\'\n                }`}\n                title=\"More row actions (3 dots)\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* 3-Dots Action Popover */}\n            {showRowMenu && (\n              <div\n                ref={menuRef}\n                onClick={(e) => e.stopPropagation()}\n                className=\"absolute right-3 top-full mt-1 w-48 bg-white dark:bg-[#0d1627] border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-1 z-30 text-xs text-left animate-in fade-in duration-100\"\n              >\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    setShowRowMenu(false);\n                    onOpenWorkspace(caseItem, e);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <ExternalLink className=\"w-3.5 h-3.5 text-blue-500\" />\n                  <span>Open Workspace</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    setShowRowMenu(false);\n                    onQuickPeek(caseItem.id, e);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <Eye className=\"w-3.5 h-3.5 text-sky-500\" />\n                  <span>Quick Peek</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    navigator.clipboard.writeText(caseItem.id);\n                    uiStore.addToast(\'info\', `Copied Case #${caseItem.id} to clipboard`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/80 cursor-pointer\"\n                >\n                  <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                  <span>Copy Case ID</span>\n                </button>\n\n                <div className=\"my-1 border-t border-slate-100 dark:border-slate-800\" />\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    casesStore.setCaseVerdict(caseItem.id, Verdict.MALICIOUS);\n                    uiStore.addToast(\'warning\', `Marked Case #${caseItem.id} as Malicious`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 cursor-pointer\"\n                >\n                  <ShieldAlert className=\"w-3.5 h-3.5\" />\n                  <span>Mark Malicious</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowRowMenu(false);\n                    casesStore.setCaseVerdict(caseItem.id, Verdict.BENIGN);\n                    uiStore.addToast(\'success\', `Marked Case #${caseItem.id} as Benign`);\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer\"\n                >\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  <span>Mark Benign</span>\n                </button>\n              </div>\n            )}\n          </td>"
      }
