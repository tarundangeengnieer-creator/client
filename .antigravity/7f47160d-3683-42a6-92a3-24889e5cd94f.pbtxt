    end_line: 259
    content: "/**\n * ASHIELDER Global UI Store\n * Manages transient interface state, drawer toggles, active case HUD, and global search.\n */\n\nimport { useSyncExternalStore } from \'react\';\nimport { Verdict } from \'../contracts/backend.ts\';\n\nexport interface ToastItem {\n  id: string;\n  type: \'info\' | \'success\' | \'warning\' | \'error\';\n  message: string;\n  durationMs?: number;\n}\n\nexport interface UIState {\n  currentPath: string;\n  activeCaseId: string | null;\n  activeCaseVerdict: Verdict | null;\n  activeCaseRisk: number | null;\n  activeCaseConfidence: number | null;\n  activeCaseSubject: string | null;\n  activeTab: string;\n  \n  // Drawer states\n  isCopilotOpen: boolean;\n  isEvidenceInspectorOpen: boolean;\n  selectedEvidenceId: string | null;\n  isQuickPeekOpen: boolean;\n  quickPeekCaseId: string | null;\n  isMobileSidebarOpen: boolean;\n\n  // Search & Modals\n  isSearchOpen: boolean;\n  searchQuery: string;\n\n  // Workstation controls\n  piiMaskingEnabled: boolean;\n  theme: \'light\' | \'dark\';\n  toasts: ToastItem[];\n}\n\nfunction getInitialTheme(): \'light\' | \'dark\' {\n  if (typeof window === \'undefined\') return \'dark\';\n  try {\n    const saved = localStorage.getItem(\'ashielder_theme\');\n    if (saved === \'dark\' || saved === \'light\') return saved;\n  } catch {\n    // ignore\n  }\n  return \'dark\';\n}\n\nfunction applyTheme(theme: \'light\' | \'dark\') {\n  if (typeof document !== \'undefined\') {\n    if (theme === \'dark\') {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }\n  try {\n    localStorage.setItem(\'ashielder_theme\', theme);\n  } catch {\n    // ignore\n  }\n}\n\nconst initialTheme = getInitialTheme();\napplyTheme(initialTheme);\n\nconst initialUIState: UIState = {\n  currentPath: \'/overview\',\n  activeCaseId: \'A2291\',\n  activeCaseVerdict: null,\n  activeCaseRisk: null,\n  activeCaseConfidence: null,\n  activeCaseSubject: null,\n  activeTab: \'summary\',\n  isCopilotOpen: false,\n  isEvidenceInspectorOpen: false,\n  selectedEvidenceId: null,\n  isQuickPeekOpen: false,\n  quickPeekCaseId: null,\n  isMobileSidebarOpen: false,\n  isSearchOpen: false,\n  searchQuery: \'\',\n  piiMaskingEnabled: true,\n  theme: initialTheme,\n  toasts: [],\n};\n\nlet currentUIState: UIState = initialUIState;\nconst uiListeners = new Set<() => void>();\n\nfunction notifyUI() {\n  uiListeners.forEach((fn) => fn());\n}\n\nexport const uiStore = {\n  getSnapshot(): UIState {\n    return currentUIState;\n  },\n\n  subscribe(listener: () => void): () => void {\n    uiListeners.add(listener);\n    return () => uiListeners.delete(listener);\n  },\n\n  navigate(path: string): void {\n    if (currentUIState.currentPath === path && !currentUIState.isMobileSidebarOpen) return;\n    currentUIState = {\n      ...currentUIState,\n      currentPath: path,\n      isMobileSidebarOpen: false,\n    };\n    notifyUI();\n  },\n\n  toggleMobileSidebar(): void {\n    currentUIState = {\n      ...currentUIState,\n      isMobileSidebarOpen: !currentUIState.isMobileSidebarOpen,\n    };\n    notifyUI();\n  },\n\n  setMobileSidebarOpen(open: boolean): void {\n    if (currentUIState.isMobileSidebarOpen === open) return;\n    currentUIState = {\n      ...currentUIState,\n      isMobileSidebarOpen: open,\n    };\n    notifyUI();\n  },\n\n  setActiveCase(\n    caseId: string | null,\n    subject?: string,\n    verdict?: Verdict,\n    risk?: number,\n    confidence?: number\n  ): void {\n    currentUIState = {\n      ...currentUIState,\n      activeCaseId: caseId,\n      activeCaseSubject: subject ?? null,\n      activeCaseVerdict: verdict ?? null,\n      activeCaseRisk: risk ?? null,\n      activeCaseConfidence: confidence ?? null,\n    };\n    notifyUI();\n  },\n\n  setActiveTab(tab: string): void {\n    currentUIState = {\n      ...currentUIState,\n      activeTab: tab,\n    };\n    notifyUI();\n  },\n\n  openCopilot(open: boolean = true): void {\n    currentUIState = {\n      ...currentUIState,\n      isCopilotOpen: open,\n    };\n    notifyUI();\n  },\n\n  openEvidenceInspector(evidenceId: string | null): void {\n    currentUIState = {\n      ...currentUIState,\n      isEvidenceInspectorOpen: Boolean(evidenceId),\n      selectedEvidenceId: evidenceId,\n    };\n    notifyUI();\n  },\n\n  openQuickPeek(caseId: string | null): void {\n    currentUIState = {\n      ...currentUIState,\n      isQuickPeekOpen: Boolean(caseId),\n      quickPeekCaseId: caseId,\n    };\n    notifyUI();\n  },\n\n  closeQuickPeek(): void {\n    this.openQuickPeek(null);\n  },\n\n  setSearchOpen(open: boolean): void {\n    currentUIState = {\n      ...currentUIState,\n      isSearchOpen: open,\n      searchQuery: open ? currentUIState.searchQuery : \'\',\n    };\n    notifyUI();\n  },\n\n  setSearchQuery(query: string): void {\n    currentUIState = {\n      ...currentUIState,\n      searchQuery: query,\n    };\n    notifyUI();\n  },\n\n  togglePiiMasking(): void {\n    currentUIState = {\n      ...currentUIState,\n      piiMaskingEnabled: !currentUIState.piiMaskingEnabled,\n    };\n    notifyUI();\n  },\n\n  setTheme(theme: \'light\' | \'dark\'): void {\n    if (currentUIState.theme === theme) return;\n    currentUIState = {\n      ...currentUIState,\n      theme,\n    };\n    applyTheme(theme);\n    notifyUI();\n  },\n\n  toggleTheme(): void {\n    const nextTheme = currentUIState.theme === \'dark\' ? \'light\' : \'dark\';\n    this.setTheme(nextTheme);\n  },\n\n  addToast(type: ToastItem[\'type\'], message: string, durationMs: number = 4000): void {\n    const id = `toast-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`;\n    const newToast: ToastItem = { id, type, message, durationMs };\n\n    currentUIState = {\n      ...currentUIState,\n      toasts: [...currentUIState.toasts, newToast],\n    };\n    notifyUI();\n\n    setTimeout(() => {\n      uiStore.removeToast(id);\n    }, durationMs);\n  },\n\n  removeToast(id: string): void {\n    currentUIState = {\n      ...currentUIState,\n      toasts: currentUIState.toasts.filter((t) => t.id !== id),\n    };\n    notifyUI();\n  },\n};\n\nexport function useUI(): UIState {\n  return useSyncExternalStore(uiStore.subscribe, uiStore.getSnapshot);\n}\n"
    raw_content: "/**\n * ASHIELDER Global UI Store\n * Manages transient interface state, drawer toggles, active case HUD, and global search.\n */\n\nimport { useSyncExternalStore } from \'react\';\nimport { Verdict } from \'../contracts/backend.ts\';\n\nexport interface ToastItem {\n  id: string;\n  type: \'info\' | \'success\' | \'warning\' | \'error\';\n  message: string;\n  durationMs?: number;\n}\n\nexport interface UIState {\n  currentPath: string;\n  activeCaseId: string | null;\n  activeCaseVerdict: Verdict | null;\n  activeCaseRisk: number | null;\n  activeCaseConfidence: number | null;\n  activeCaseSubject: string | null;\n  activeTab: string;\n  \n  // Drawer states\n  isCopilotOpen: boolean;\n  isEvidenceInspectorOpen: boolean;\n  selectedEvidenceId: string | null;\n  isQuickPeekOpen: boolean;\n  quickPeekCaseId: string | null;\n  isMobileSidebarOpen: boolean;\n\n  // Search & Modals\n  isSearchOpen: boolean;\n  searchQuery: string;\n\n  // Workstation controls\n  piiMaskingEnabled: boolean;\n  theme: \'light\' | \'dark\';\n  toasts: ToastItem[];\n}\n\nfunction getInitialTheme(): \'light\' | \'dark\' {\n  if (typeof window === \'undefined\') return \'dark\';\n  try {\n    const saved = localStorage.getItem(\'ashielder_theme\');\n    if (saved === \'dark\' || saved === \'light\') return saved;\n  } catch {\n    // ignore\n  }\n  return \'dark\';\n}\n\nfunction applyTheme(theme: \'light\' | \'dark\') {\n  if (typeof document !== \'undefined\') {\n    if (theme === \'dark\') {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }\n  try {\n    localStorage.setItem(\'ashielder_theme\', theme);\n  } catch {\n    // ignore\n  }\n}\n\nconst initialTheme = getInitialTheme();\napplyTheme(initialTheme);\n\nconst initialUIState: UIState = {\n  currentPath: \'/overview\',\n  activeCaseId: \'A2291\',\n  activeCaseVerdict: null,\n  activeCaseRisk: null,\n  activeCaseConfidence: null,\n  activeCaseSubject: null,\n  activeTab: \'summary\',\n  isCopilotOpen: false,\n  isEvidenceInspectorOpen: false,\n  selectedEvidenceId: null,\n  isQuickPeekOpen: false,\n  quickPeekCaseId: null,\n  isMobileSidebarOpen: false,\n  isSearchOpen: false,\n  searchQuery: \'\',\n  piiMaskingEnabled: true,\n  theme: initialTheme,\n  toasts: [],\n};\n\nlet currentUIState: UIState = initialUIState;\nconst uiListeners = new Set<() => void>();\n\nfunction notifyUI() {\n  uiListeners.forEach((fn) => fn());\n}\n\nexport const uiStore = {\n  getSnapshot(): UIState {\n    return currentUIState;\n  },\n\n  subscribe(listener: () => void): () => void {\n    uiListeners.add(listener);\n    return () => uiListeners.delete(listener);\n  },\n\n  navigate(path: string): void {\n    if (currentUIState.currentPath === path && !currentUIState.isMobileSidebarOpen) return;\n    currentUIState = {\n      ...currentUIState,\n      currentPath: path,\n      isMobileSidebarOpen: false,\n    };\n    notifyUI();\n  },\n\n  toggleMobileSidebar(): void {\n    currentUIState = {\n      ...currentUIState,\n      isMobileSidebarOpen: !currentUIState.isMobileSidebarOpen,\n    };\n    notifyUI();\n  },\n\n  setMobileSidebarOpen(open: boolean): void {\n    if (currentUIState.isMobileSidebarOpen === open) return;\n    currentUIState = {\n      ...currentUIState,\n      isMobileSidebarOpen: open,\n    };\n    notifyUI();\n  },\n\n  setActiveCase(\n    caseId: string | null,\n    subject?: string,\n    verdict?: Verdict,\n    risk?: number,\n    confidence?: number\n  ): void {\n    currentUIState = {\n      ...currentUIState,\n      activeCaseId: caseId,\n      activeCaseSubject: subject ?? null,\n      activeCaseVerdict: verdict ?? null,\n      activeCaseRisk: risk ?? null,\n      activeCaseConfidence: confidence ?? null,\n    };\n    notifyUI();\n  },\n\n  setActiveTab(tab: string): void {\n    currentUIState = {\n      ...currentUIState,\n      activeTab: tab,\n    };\n    notifyUI();\n  },\n\n  openCopilot(open: boolean = true): void {\n    currentUIState = {\n      ...currentUIState,\n      isCopilotOpen: open,\n    };\n    notifyUI();\n  },\n\n  openEvidenceInspector(evidenceId: string | null): void {\n    currentUIState = {\n      ...currentUIState,\n      isEvidenceInspectorOpen: Boolean(evidenceId),\n      selectedEvidenceId: evidenceId,\n    };\n    notifyUI();\n  },\n\n  openQuickPeek(caseId: string | null): void {\n    currentUIState = {\n      ...currentUIState,\n      isQuickPeekOpen: Boolean(caseId),\n      quickPeekCaseId: caseId,\n    };\n    notifyUI();\n  },\n\n  closeQuickPeek(): void {\n    this.openQuickPeek(null);\n  },\n\n  setSearchOpen(open: boolean): void {\n    currentUIState = {\n      ...currentUIState,\n      isSearchOpen: open,\n      searchQuery: open ? currentUIState.searchQuery : \'\',\n    };\n    notifyUI();\n  },\n\n  setSearchQuery(query: string): void {\n    currentUIState = {\n      ...currentUIState,\n      searchQuery: query,\n    };\n    notifyUI();\n  },\n\n  togglePiiMasking(): void {\n    currentUIState = {\n      ...currentUIState,\n      piiMaskingEnabled: !currentUIState.piiMaskingEnabled,\n    };\n    notifyUI();\n  },\n\n  setTheme(theme: \'light\' | \'dark\'): void {\n    if (currentUIState.theme === theme) return;\n    currentUIState = {\n      ...currentUIState,\n      theme,\n    };\n    applyTheme(theme);\n    notifyUI();\n  },\n\n  toggleTheme(): void {\n    const nextTheme = currentUIState.theme === \'dark\' ? \'light\' : \'dark\';\n    this.setTheme(nextTheme);\n  },\n\n  addToast(type: ToastItem[\'type\'], message: string, durationMs: number = 4000): void {\n    const id = `toast-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`;\n    const newToast: ToastItem = { id, type, message, durationMs };\n\n    currentUIState = {\n      ...currentUIState,\n      toasts: [...currentUIState.toasts, newToast],\n    };\n    notifyUI();\n\n    setTimeout(() => {\n      uiStore.removeToast(id);\n    }, durationMs);\n  },\n\n  removeToast(id: string): void {\n    currentUIState = {\n      ...currentUIState,\n      toasts: currentUIState.toasts.filter((t) => t.id !== id),\n    };\n    notifyUI();\n  },\n};\n\nexport function useUI(): UIState {\n  return useSyncExternalStore(uiStore.subscribe, uiStore.getSnapshot);\n}\n"
