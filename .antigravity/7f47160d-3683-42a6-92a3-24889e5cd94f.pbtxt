    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { AshielderLogo } from \'../ui/AshielderLogo.tsx\';\nimport {\n  LayoutDashboard,\n  Search,\n  Globe,\n  FileText,\n  Archive,\n  Settings,\n  X,\n  Sun,\n  Moon,\n  Shield,\n  Check,\n} from \'lucide-react\';\n\ninterface NavItem {\n  id: string;\n  path: string;\n  label: string;\n  icon: React.ReactNode;\n}\n\nexport const Sidebar: React.FC = () => {\n  const ui = useUI();\n\n  // Primary Navigation items matching the reference image\n  const navItems: NavItem[] = [\n    {\n      id: \'dashboard\',\n      path: \'/overview\',\n      label: \'Dashboard\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'investigation\',\n      path: \'/investigation\',\n      label: \'Investigation\',\n      icon: <Search className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'threat-intel\',\n      path: \'/hunting\',\n      label: \'Threat Intelligence\',\n      icon: <Globe className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'reports\',\n      path: \'/reports\',\n      label: \'Reports\',\n      icon: <FileText className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'evidence\',\n      path: \'/evidence\',\n      label: \'Evidence Vault\',\n      icon: <Archive className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'settings\',\n      path: \'/settings\',\n      label: \'Settings\',\n      icon: <Settings className=\"w-4 h-4\" />,\n    },\n  ];"
        replacement_content: "import React from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { AshielderLogo } from \'../ui/AshielderLogo.tsx\';\nimport {\n  ShieldAlert,\n  Search,\n  Database,\n  FileText,\n  Archive,\n  Settings,\n  X,\n  Sun,\n  Moon,\n  Shield,\n  Check,\n} from \'lucide-react\';\n\ninterface NavItem {\n  id: string;\n  path: string;\n  label: string;\n  icon: React.ReactNode;\n}\n\nexport const Sidebar: React.FC = () => {\n  const ui = useUI();\n\n  // Primary Navigation items matching the reference image\n  const navItems: NavItem[] = [\n    {\n      id: \'dashboard\',\n      path: \'/overview\',\n      label: \'Dashboard\',\n      icon: <ShieldAlert className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'investigation\',\n      path: \'/investigation\',\n      label: \'Investigation\',\n      icon: <Search className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'threat-intel\',\n      path: \'/hunting\',\n      label: \'Threat Intelligence\',\n      icon: <Database className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'reports\',\n      path: \'/reports\',\n      label: \'Reports\',\n      icon: <FileText className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'evidence\',\n      path: \'/evidence\',\n      label: \'Evidence Vault\',\n      icon: <Archive className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'settings\',\n      path: \'/settings\',\n      label: \'Settings\',\n      icon: <Settings className=\"w-4 h-4\" />,\n    },\n  ];"
      }
