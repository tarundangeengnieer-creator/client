    instruction: "Add state and imports for row 3-dots action menu in CaseTableRow"
    replacement_infos {
      original_chunk {
        target_content: "import React, { memo } from \'react\';\nimport { CaseViewModel, TableDensityMode } from \'../../domain/case.ts\';\nimport { Verdict } from \'../../contracts/backend.ts\';\nimport { defangEmail } from \'../../lib/defang.ts\';\nimport { formatScore } from \'../../lib/formatters.ts\';\nimport {\n  Eye,\n  ShieldAlert,\n  ShieldCheck,\n  AlertTriangle,\n  HelpCircle,\n  Clock,\n  Zap,\n  MoreHorizontal,\n  ChevronRight,\n} from \'lucide-react\';\n\ninterface CaseTableRowProps {\n  caseItem: CaseViewModel;\n  density: TableDensityMode;\n  isSelected: boolean;\n  isFocused: boolean;\n  onToggleSelect: (id: string, e: React.MouseEvent) => void;\n  onQuickPeek: (id: string, e: React.MouseEvent) => void;\n  onOpenWorkspace: (caseItem: CaseViewModel, e: React.MouseEvent) => void;\n}\n\nexport const CaseTableRow: React.FC<CaseTableRowProps> = memo(\n  ({\n    caseItem,\n    density,\n    isSelected,\n    isFocused,\n    onToggleSelect,\n    onQuickPeek,\n    onOpenWorkspace,\n  }) => {"
        replacement_content: "import React, { memo, useState, useRef, useEffect } from \'react\';\nimport { CaseViewModel, TableDensityMode } from \'../../domain/case.ts\';\nimport { Verdict } from \'../../contracts/backend.ts\';\nimport { defangEmail } from \'../../lib/defang.ts\';\nimport { formatScore } from \'../../lib/formatters.ts\';\nimport { casesStore } from \'../../stores/cases-store.ts\';\nimport { uiStore } from \'../../stores/ui-store.ts\';\nimport {\n  Eye,\n  ShieldAlert,\n  ShieldCheck,\n  AlertTriangle,\n  HelpCircle,\n  Clock,\n  Zap,\n  MoreHorizontal,\n  ChevronRight,\n  ExternalLink,\n  Copy,\n} from \'lucide-react\';\n\ninterface CaseTableRowProps {\n  caseItem: CaseViewModel;\n  density: TableDensityMode;\n  isSelected: boolean;\n  isFocused: boolean;\n  onToggleSelect: (id: string, e: React.MouseEvent) => void;\n  onQuickPeek: (id: string, e: React.MouseEvent) => void;\n  onOpenWorkspace: (caseItem: CaseViewModel, e: React.MouseEvent) => void;\n}\n\nexport const CaseTableRow: React.FC<CaseTableRowProps> = memo(\n  ({\n    caseItem,\n    density,\n    isSelected,\n    isFocused,\n    onToggleSelect,\n    onQuickPeek,\n    onOpenWorkspace,\n  }) => {\n    const [showRowMenu, setShowRowMenu] = useState(false);\n    const menuRef = useRef<HTMLDivElement>(null);\n\n    useEffect(() => {\n      const handleClickOutside = (e: MouseEvent) => {\n        if (menuRef.current && !menuRef.current.contains(e.target as Node)) {\n          setShowRowMenu(false);\n        }\n      };\n      if (showRowMenu) {\n        document.addEventListener(\'mousedown\', handleClickOutside);\n      }\n      return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n    }, [showRowMenu]);"
      }
      num_matches: 1
    }
  }
}
