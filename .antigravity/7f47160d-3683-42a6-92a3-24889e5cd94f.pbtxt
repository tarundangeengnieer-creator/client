verlays */}      <GlobalSearchModal />      <ToastContainer />      {/* Keyboard Shortcuts Help Modal */}      <Modal        isOpen={showShortcuts}        onClose={() => setShowShortcuts(false)}        title=\"FORENSIC WORKSTATION KEYBOARD SHORTCUTS\"        description=\"High-velocity analyst navigation shortcuts\"        maxWidth=\"md\"      >        <div className=\"space-y-3 font-mono text-xs\">          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">            <span className=\"text-slate-700\">Global Search / Jump</span>            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">              Ctrl + K / \342\214\230K            </kbd>          </div>          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">            <span className=\"text-slate-700\">Toggle Shortcuts Guide</span>            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">              ?            </kbd>          </div>          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">            <span className=\"text-slate-700\">Navigate to Security Overview</span>            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">              G then O            </kbd>          </div>          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">            <span className=\"text-slate-700\">Navigate to Case Inboxes</span>            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">              G then I            </kbd>          </div>        </div>      </Modal>    </div>  );};"
