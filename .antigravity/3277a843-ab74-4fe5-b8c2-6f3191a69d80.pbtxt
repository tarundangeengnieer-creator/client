    content: "import React, { useState } from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { AshielderLogo } from \'../ui/AshielderLogo.tsx\';\nimport {\n  LayoutDashboard,\n  Mail,\n  Crosshair,\n  FileText,\n  ShieldCheck,\n  Settings,\n  HelpCircle,\n  Activity,\n  ChevronDown,\n  Shield,\n  UploadCloud,\n  CheckCircle2,\n  LogOut,\n  User,\n} from \'lucide-react\';\n\ninterface NavItem {\n  id: string;\n  path: string;\n  label: string;\n  icon: React.ReactNode;\n}\n\nexport const Sidebar: React.FC = () => {\n  const ui = useUI();\n  const [showProfileMenu, setShowProfileMenu] = useState(false);\n\n  const navItems: NavItem[] = [\n    {\n      id: \'overview\',\n      path: \'/overview\',\n      label: \'Overview\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'cases\',\n      path: \'/inbox\',\n      label: \'Cases\',\n      icon: <Mail className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'investigations\',\n      path: \'/investigations\',\n      label: \'Investigations\',\n      icon: <Crosshair className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'reports\',\n      path: \'/reports\',\n      label: \'Reports\',\n      icon: <FileText className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'evidence\',\n      path: \'/evidence\',\n      label: \'Evidence\',\n      icon: <ShieldCheck className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'settings\',\n      path: \'/settings\',\n      label: \'Settings\',\n      icon: <Settings className=\"w-4 h-4\" />,\n    },\n  ];\n\n  const isCurrentActive = (itemPath: string) => {\n    if (itemPath === \'/overview\' && (ui.currentPath === \'/\' || ui.currentPath === \'/overview\')) {\n      return true;\n    }\n    if (itemPath === \'/inbox\' && (ui.currentPath === \'/inbox\' || ui.currentPath === \'/cases\' || ui.currentPath.startsWith(\'/case/\'))) {\n      return true;\n    }\n    return ui.currentPath.startsWith(itemPath);\n  };\n\n  return (\n    <aside\n      id=\"app-sidebar\"\n      className=\"w-60 bg-[#0b1329] border-r border-slate-800/80 flex flex-col justify-between select-none z-20 shrink-0 h-full\"\n    >\n      {/* Top Header & Brand */}\n      <div>\n        <div className=\"px-4 pt-5 pb-5 border-b border-slate-800/60\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"flex items-center gap-3 cursor-pointer group\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-slate-900/90 border border-slate-700/60 flex items-center justify-center group-hover:border-sky-500/50 transition-all shadow-md shrink-0\">\n              <AshielderLogo variant=\"icon\" size=\"sm\" theme=\"light\" />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"flex items-center leading-none\">\n                <span className=\"font-black text-[#0284c7] text-lg tracking-tight\">A</span>\n                <span className=\"font-black text-white text-lg tracking-tight\">SHIELDER</span>\n              </div>\n              {/* Official Saffron-White-Green Tricolor Bar */}\n              <div className=\"flex items-center h-[2.5px] w-14 rounded-full overflow-hidden my-1 shadow-xs\">\n                <span className=\"h-full w-1/3 bg-[#f97316]\" />\n                <span className=\"h-full w-1/3 bg-slate-200\" />\n                <span className=\"h-full w-1/3 bg-[#16a34a]\" />\n              </div>\n              <p className=\"text-[9px] font-semibold text-slate-400 tracking-tight leading-tight\">\n                Smarter Threat Detection.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Main Navigation Items */}\n        <nav className=\"p-3 space-y-1\">\n          {navItems.map((item) => {\n            const active = isCurrentActive(item.path);\n            return (\n              <button\n                key={item.id}\n                id={`sidebar-nav-${item.id}`}\n                type=\"button\"\n                onClick={() => uiStore.navigate(item.path)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-left ${\n                  active\n                    ? \'bg-blue-600 text-white shadow-sm\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-slate-900/60\'\n                }`}\n              >\n                <span className={active ? \'text-white\' : \'text-slate-400\'}>{item.icon}</span>\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Bottom Auxiliary Links & User Profile */}\n      <div className=\"p-3 border-t border-slate-800/70 space-y-2\">\n        {/* Ingest raw .eml button shortcut */}\n        <button\n          id=\"sidebar-quick-ingest\"\n          type=\"button\"\n          onClick={() => uiStore.navigate(\'/ingest\')}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-sky-300 hover:bg-slate-900/60 transition-colors text-left\"\n        >\n          <UploadCloud className=\"w-4 h-4 text-sky-400\" />\n          <span>Ingest RFC 822 .eml</span>\n        </button>\n\n        {/* Help */}\n        <button\n          id=\"sidebar-help\"\n          type=\"button\"\n          onClick={() => {\n            uiStore.addToast(\'info\', \'Keyboard shortcuts: Press ? to view all operational keys.\');\n          }}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900/60 transition-colors text-left\"\n        >\n          <HelpCircle className=\"w-4 h-4\" />\n          <span>Help</span>\n        </button>\n\n        {/* System Status with green pulse */}\n        <div className=\"flex items-center justify-between px-3.5 py-2 text-xs text-slate-400\">\n          <div className=\"flex items-center gap-2.5\">\n            <Activity className=\"w-4 h-4 text-slate-400\" />\n            <span>System Status</span>\n          </div>\n          <span className=\"flex items-center gap-1.5 text-[11px] text-emerald-400\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n          </span>\n        </div>\n\n        {/* Tarun Dange SOC Analyst Profile Card */}\n        <div className=\"pt-2 border-t border-slate-800/60 relative\">\n          <button\n            id=\"sidebar-user-profile-btn\"\n            type=\"button\"\n            onClick={() => setShowProfileMenu((prev) => !prev)}\n            className=\"w-full flex items-center justify-between p-2 rounded-xl bg-slate-900/50 hover:bg-slate-900 border border-slate-800/60 transition-colors text-left\"\n          >\n            <div className=\"flex items-center gap-2.5 min-w-0\">\n              <div className=\"w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs\">\n                TD\n              </div>\n              <div className=\"min-w-0 leading-tight\">\n                <p className=\"text-xs font-semibold text-white truncate\">Tarun Dange</p>\n                <p className=\"text-[11px] text-slate-400\">SOC Analyst</p>\n                <div className=\"flex items-center gap-1 text-[10px] text-emerald-400 mt-0.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" />\n                  <span>Online</span>\n                </div>\n              </div>\n            </div>\n            <ChevronDown className=\"w-4 h-4 text-slate-400 shrink-0 ml-1\" />\n          </button>\n\n          {/* Profile Dropdown */}\n          {showProfileMenu && (\n            <div className=\"absolute bottom-full left-2 right-2 mb-2 bg-[#0d1733] border border-slate-700/80 rounded-xl shadow-xl p-1.5 z-30 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.navigate(\'/settings\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <User className=\"w-3.5 h-3.5\" />\n                <span>Analyst Profile</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Active Tenant: CDGI SOC Operations Center\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>CDGI SOC Verified</span>\n              </button>\n              <div className=\"my-1 border-t border-slate-800\" />\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Workstation session active. Offline-first local store.\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-rose-400 hover:bg-rose-950/40 rounded-lg text-left\"\n              >\n                <LogOut className=\"w-3.5 h-3.5\" />\n                <span>Sign Out</span>\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n    </aside>\n  );\n};\n"
