    content: "      `\"${(c.primaryIoc || \'\').replace(/\"/g, \'\"\"\')}\"`,\n    ]);\n\n    const csvContent = \'data:text/csv;charset=utf-8,\' + [headers.join(\',\'), ...rows.map((r) => r.join(\',\'))].join(\'\\n\');\n    const encodedUri = encodeURI(csvContent);\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', encodedUri);\n    link.setAttribute(\'download\', `ashielder_cases_export_${new Date().toISOString().substring(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    uiStore.addToast(\'success\', `Exported ${filteredCases.length} cases to CSV`);\n  };\n\n  const handleExportJson = () => {\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(filteredCases, null, 2));\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', dataStr);\n    link.setAttribute(\'download\', `ashielder_cases_${Date.now()}.json`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    uiStore.addToast(\'success\', `Exported ${filteredCases.length} cases to JSON`);\n  };\n\n  return (\n    <div className=\"p-6 max-w-7xl mx-auto w-full space-y-6\">\n      {/* 1. TOP METRIC CARDS matching Image 1 */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4\">\n        {/* Total Cases */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">TOTAL CASES</span>\n            <div className=\"w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600\">\n              <Mail className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-slate-900 mt-2\">{metrics.total}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Ingested Queue</div>\n        </div>\n\n        {/* Malicious */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">MALICIOUS</span>\n            <div className=\"w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-600\">\n              <ShieldAlert className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-rose-600 mt-2\">{metrics.malicious.toString().padStart(2, \'0\')}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Quarantine Ready</div>"
    raw_content: "import React, { useEffect, useRef, useCallback } from \'react\';\nimport { useCases, casesStore, RiskFilter, ConfidenceFilter, SortField } from \'../../stores/cases-store.ts\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { CaseViewModel, TableDensityMode } from \'../../domain/case.ts\';\nimport { Verdict } from \'../../contracts/backend.ts\';\nimport { CaseTableRow } from \'./CaseTableRow.tsx\';\nimport { QuickPeekDrawer } from \'./QuickPeekDrawer.tsx\';\nimport {\n  Inbox,\n  Plus,\n  Download,\n  Filter,\n  Search,\n  Zap,\n  ShieldAlert,\n  ShieldCheck,\n  AlertTriangle,\n  HelpCircle,\n  Clock,\n  ArrowUpDown,\n  RotateCcw,\n  CheckSquare,\n  Trash2,\n  Lock,\n  CheckCircle2,\n  SlidersHorizontal,\n  Mail,\n  ArrowUpRight,\n} from \'lucide-react\';\n\nexport const CaseInboxPage: React.FC = () => {\n  const ui = useUI();\n  const casesState = useCases();\n  const searchInputRef = useRef<HTMLInputElement>(null);\n\n  const filteredCases = casesStore.getFilteredCases();\n  const metrics = casesStore.getMetrics();\n  const selectedCount = casesState.selectedCaseIds.size;\n  const isAllSelected =\n    filteredCases.length > 0 &&\n    filteredCases.every((c) => casesState.selectedCaseIds.has(c.id));\n\n  // Open workspace for a case\n  const handleOpenWorkspace = useCallback((caseItem: CaseViewModel) => {\n    uiStore.setActiveCase(\n      caseItem.id,\n      caseItem.subject,\n      caseItem.verdict,\n      caseItem.riskScore,\n      caseItem.confidence\n    );\n    uiStore.navigate(`/case/${caseItem.id}`);\n  }, []);\n\n  // Quick peek\n  const handleQuickPeek = useCallback((caseId: string) => {\n    uiStore.openQuickPeek(caseId);\n  }, []);\n\n  // Keyboard navigation for Inbox (`J`, `K`, `Space`, `Enter`, `X`, `/`)\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if ([\'INPUT\', \'TEXTAREA\', \'SELECT\'].includes((e.target as HTMLElement).tagName)) {\n        if (e.key === \'Escape\') {\n          (e.target as HTMLElement).blur();\n        }\n        return;\n      }\n\n      if (ui.isQuickPeekOpen) {\n        return;\n      }\n\n      if (e.key === \'j\' || e.key === \'ArrowDown\') {\n        e.preventDefault();\n        casesStore.moveFocus(1, filteredCases.length);\n      } else if (e.key === \'k\' || e.key === \'ArrowUp\') {\n        e.preventDefault();\n        casesStore.moveFocus(-1, filteredCases.length);\n      } else if (e.key === \' \') {\n        e.preventDefault();\n        const focusedCase = filteredCases[casesState.focusedIndex];\n        if (focusedCase) {\n          handleQuickPeek(focusedCase.id);\n        }\n      } else if (e.key === \'Enter\') {\n        e.preventDefault();\n        const focusedCase = filteredCases[casesState.focusedIndex];\n        if (focusedCase) {\n          handleOpenWorkspace(focusedCase);\n        }\n      } else if (e.key === \'x\' || e.key === \'X\') {\n        e.preventDefault();\n        const focusedCase = filteredCases[casesState.focusedIndex];\n        if (focusedCase) {\n          casesStore.toggleSelect(focusedCase.id);\n        }\n      } else if (e.key === \'/\') {\n        e.preventDefault();\n        searchInputRef.current?.focus();\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [filteredCases, casesState.focusedIndex, ui.isQuickPeekOpen, handleQuickPeek, handleOpenWorkspace]);\n\n  // Export handlers\n  const handleExportCsv = () => {\n    const headers = [\n      \'Case ID\',\n      \'Verdict\',\n      \'Risk Score\',\n      \'Confidence\',\n      \'Sender\',\n      \'Recipient\',\n      \'Subject\',\n      \'Timestamp\',\n      \'Primary IOC\',\n    ];\n    const rows = filteredCases.map((c) => [\n      c.id,\n      c.verdict,\n      c.riskScore,\n      c.confidence,\n      `\"${c.sender.replace(/\"/g, \'\"\"\')}\"`,\n      `\"${c.recipient.replace(/\"/g, \'\"\"\')}\"`,\n      `\"${c.subject.replace(/\"/g, \'\"\"\')}\"`,\n      c.timestamp,\n      `\"${(c.primaryIoc || \'\').replace(/\"/g, \'\"\"\')}\"`,\n    ]);\n\n    const csvContent = \'data:text/csv;charset=utf-8,\' + [headers.join(\',\'), ...rows.map((r) => r.join(\',\'))].join(\'\\n\');\n    const encodedUri = encodeURI(csvContent);\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', encodedUri);\n    link.setAttribute(\'download\', `ashielder_cases_export_${new Date().toISOString().substring(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    uiStore.addToast(\'success\', `Exported ${filteredCases.length} cases to CSV`);\n  };\n\n  const handleExportJson = () => {\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(filteredCases, null, 2));\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', dataStr);\n    link.setAttribute(\'download\', `ashielder_cases_${Date.now()}.json`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    uiStore.addToast(\'success\', `Exported ${filteredCases.length} cases to JSON`);\n  };\n\n  return (\n    <div className=\"p-6 max-w-7xl mx-auto w-full space-y-6\">\n      {/* 1. TOP METRIC CARDS matching Image 1 */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4\">\n        {/* Total Cases */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">TOTAL CASES</span>\n            <div className=\"w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600\">\n              <Mail className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-slate-900 mt-2\">{metrics.total}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Ingested Queue</div>\n        </div>\n\n        {/* Malicious */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">MALICIOUS</span>\n            <div className=\"w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-600\">\n              <ShieldAlert className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-rose-600 mt-2\">{metrics.malicious.toString().padStart(2, \'0\')}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Quarantine Ready</div>\n        </div>\n\n        {/* Suspicious */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">SUSPICIOUS</span>\n            <div className=\"w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-500\">\n              <AlertTriangle className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-amber-500 mt-2\">{metrics.suspicious.toString().padStart(2, \'0\')}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Analyst Review</div>\n        </div>\n\n        {/* Investigating */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">INVESTIGATING</span>\n            <div className=\"w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center text-sky-600\">\n              <Clock className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-blue-600 mt-2\">05</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Adaptive Loops</div>\n        </div>\n\n        {/* Benign */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">BENIGN</span>\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600\">\n              <ShieldCheck className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-emerald-600 mt-2\">{metrics.benign.toString().padStart(2, \'0\')}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Auto-Verified Clean</div>\n        </div>\n\n        {/* Inconclusive */}\n        <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider\">INCONCLUSIVE</span>\n            <div className=\"w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500\">\n              <HelpCircle className=\"w-4 h-4\" />\n            </div>\n          </div>\n          <div className=\"text-2xl font-black text-slate-700 mt-2\">{metrics.inconclusive.toString().padStart(2, \'0\')}</div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5\">Evidence Exhausted</div>\n        </div>\n      </div>\n\n      {/* 2. TOOLBAR & CONTROLS CARD */}\n      <div className=\"bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        {/* Left: Search input */}\n        <div className=\"relative flex-1 max-w-md\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            ref={searchInputRef}\n            type=\"text\"\n            placeholder=\"Search Case ID, Sender, Subject, IoC (press \'/\' to focus)...\"\n            value={casesState.searchQuery}\n            onChange={(e) => casesStore.setSearchQuery(e.target.value)}\n            className=\"w-full pl-9 pr-8 py-2 bg-slate-50 hover:bg-slate-100/60 focus:bg-white border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\"\n          />\n          {casesState.searchQuery && (\n            <button\n              type=\"button\"\n              onClick={() => casesStore.setSearchQuery(\'\')}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs cursor-pointer\"\n            >\n              \303\227\n            </button>\n          )}\n        </div>\n\n        {/* Right: Filters & Action Buttons */}\n        <div className=\"flex items-center gap-2.5 flex-wrap text-xs\">\n          {/* Verdict Filter */}\n          <div className=\"flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5\">\n            <span className=\"text-slate-500 text-xs\">Verdict:</span>\n            <select\n              value={casesState.verdictFilter}\n              onChange={(e) =>\n                casesStore.setVerdictFilter(e.target.value as \'ALL\' | Verdict)\n              }\n              aria-label=\"Filter by verdict\"\n              className=\"bg-transparent text-slate-800 text-xs font-semibold focus:outline-none cursor-pointer\"\n            >\n              <option value=\"ALL\">ALL</option>\n              <option value={Verdict.MALICIOUS}>Malicious</option>\n              <option value={Verdict.SUSPICIOUS}>Suspicious</option>\n              <option value={Verdict.BENIGN}>Benign</option>\n              <option value={Verdict.INCONCLUSIVE}>Inconclusive</option>\n            </select>\n          </div>\n\n          {/* Density Mode */}\n          <div className=\"flex items-center rounded-lg border border-slate-200 bg-slate-50 p-1\">\n            <button\n              type=\"button\"\n              onClick={() => casesStore.setDensityMode(\'compact\')}\n              className={`px-2.5 py-1 rounded text-xs font-medium cursor-pointer transition-colors ${\n                casesState.densityMode === \'compact\'\n                  ? \'bg-white text-blue-600 shadow-2xs font-semibold\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Compact\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => casesStore.setDensityMode(\'standard\')}\n              className={`px-2.5 py-1 rounded text-xs font-medium cursor-pointer transition-colors ${\n                casesState.densityMode === \'standard\'\n                  ? \'bg-white text-blue-600 shadow-2xs font-semibold\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Standard\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => casesStore.setDensityMode(\'preview\')}\n              className={`px-2.5 py-1 rounded text-xs font-medium cursor-pointer transition-colors ${\n                casesState.densityMode === \'preview\'\n                  ? \'bg-white text-blue-600 shadow-2xs font-semibold\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Preview\n            </button>\n          </div>\n\n          {/* Export CSV */}\n          <button\n            type=\"button\"\n            onClick={handleExportCsv}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors shadow-2xs cursor-pointer\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Export CSV</span>\n          </button>\n\n          {/* Ingest EML */}\n          <button\n            type=\"button\"\n            onClick={() => uiStore.navigate(\'/ingest\')}\n            className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold transition-colors shadow-xs cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Ingest .eml</span>\n          </button>\n        </div>\n      </div>\n\n      {/* 3. BATCH OPERATIONS BAR (if 1+ cases selected) */}\n      {selectedCount > 0 && (\n        <div className=\"p-3 bg-blue-50 border border-blue-200 rounded-xl flex items-center justify-between gap-4 text-xs animate-fadeIn\">\n          <div className=\"flex items-center gap-2 text-blue-900 font-semibold\">\n            <CheckSquare className=\"w-4 h-4 text-blue-600\" />\n            <span>{selectedCount} case{selectedCount > 1 ? \'s\' : \'\'} selected</span>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                casesStore.bulkQuarantine();\n                uiStore.addToast(\'warning\', `Quarantined ${selectedCount} cases`);\n              }}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-semibold transition-colors cursor-pointer\"\n            >\n              <Lock className=\"w-3.5 h-3.5\" />\n              <span>Quarantine Selected</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => {\n                casesStore.bulkMarkReviewed();\n                uiStore.addToast(\'success\', `Marked ${selectedCount} cases reviewed`);\n              }}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg font-semibold transition-colors cursor-pointer\"\n            >\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n              <span>Mark Reviewed</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => casesStore.clearSelection()}\n              className=\"text-slate-500 hover:text-slate-800 underline ml-2 cursor-pointer\"\n            >\n              Clear\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* 4. MASTER TRIAGE TABLE CARD */}\n      <div className=\"bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50/80 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-[11px] select-none\">\n              <tr>\n                <th className=\"w-8 px-3 py-3 text-center\">\n                  <input\n                    type=\"checkbox\"\n                    checked={isAllSelected}\n                    onChange={() =>\n                      casesStore.selectAll(filteredCases.map((c) => c.id))\n                    }\n                    aria-label=\"Select all cases in view\"\n                    className=\"w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-0 cursor-pointer\"\n                  />\n                </th>\n                <th className=\"w-28 px-3 py-3\">#</th>\n                <th className=\"px-3 py-3\">Subject</th>\n                <th className=\"w-32 px-3 py-3\">Risk</th>\n                <th className=\"w-28 px-3 py-3\">Status</th>\n                <th className=\"w-36 px-3 py-3\">Received</th>\n                <th className=\"w-16 px-3 py-3 text-right\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {filteredCases.length === 0 ? (\n                <tr>\n                  <td colSpan={7} className=\"py-16 text-center text-slate-400\">\n                    <div className=\"flex flex-col items-center justify-center space-y-2\">\n                      <Filter className=\"w-8 h-8 text-slate-400\" />\n                      <p className=\"text-sm font-semibold text-slate-700\">No cases match the active filter criteria</p>\n                      <p className=\"text-xs text-slate-500\">\n                        Try resetting your search query or selecting ALL verdicts.\n                      </p>\n                      <button\n                        type=\"button\"\n                        onClick={() => casesStore.resetFilters()}\n                        className=\"mt-3 px-3 py-1.5 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-semibold cursor-pointer\"\n                      >\n                        Reset All Filters\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ) : (\n                filteredCases.map((caseItem, idx) => (\n                  <CaseTableRow\n                    key={caseItem.id}\n                    caseItem={caseItem}\n                    density={casesState.densityMode}\n                    isSelected={casesState.selectedCaseIds.has(caseItem.id)}\n                    isFocused={casesState.focusedIndex === idx}\n                    onToggleSelect={(id) => casesStore.toggleSelect(id)}\n                    onQuickPeek={(id) => handleQuickPeek(id)}\n                    onOpenWorkspace={(item) => handleOpenWorkspace(item)}\n                  />\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Quick Peek Drawer */}\n      <QuickPeekDrawer />\n    </div>\n  );\n};\n"
    num_lines: 449
    num_bytes: 19200
  }
}
