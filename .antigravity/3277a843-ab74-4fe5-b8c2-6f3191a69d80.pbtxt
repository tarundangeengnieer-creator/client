    end_line: 69
    content: "export const CaseDetailPage: React.FC = () => {\n  const ui = useUI();\n  const caseId = ui.activeCaseId || \'A2291\';\n  const caseData = casesStore.getCase(caseId) || {\n    id: \'A2291\',\n    subject: \'Invoice Payment Update - Action Required\',\n    sender: \'support@paypal1-secure.com\',\n    recipient: \'user@company.com\',\n    timestamp: \'2025-08-12T10:24:00Z\',\n    verdict: \'MALICIOUS\',\n    riskScore: 87.0,\n    confidence: 0.87,\n    originIp: \'185.220.101.5\',\n    originCountry: \'Germany\',\n    primaryIoc: \'paypal1-secure.com/invoice\',\n  };\n\n  const investigation = casesStore.getInvestigation(caseId);\n\n  const [activeTab, setActiveTab] = useState<\'summary\' | \'findings\' | \'journey\' | \'evidence\' | \'history\' | \'report\'>(\'summary\');\n  const [copiedUrl, setCopiedUrl] = useState(false);\n  const [isReinvestigating, setIsReinvestigating] = useState(false);\n\n  const handleCopyUrl = () => {\n    navigator.clipboard.writeText(\'https://paypal1-secure.com/invoice\');\n    setCopiedUrl(true);\n    setTimeout(() => setCopiedUrl(false), 2000);\n    uiStore.addToast(\'info\', \'Suspicious URL copied to clipboard\');\n  };\n\n  const handleReinvestigate = () => {\n    setIsReinvestigating(true);\n    uiStore.addToast(\'info\', `Autonomous re-investigation triggered for Case #${caseId}`);\n    setTimeout(() => {\n      setIsReinvestigating(false);\n      uiStore.addToast(\'success\', `Case #${caseId} telemetry verified with 8 forensic tools.`);\n    }, 1200);\n  };\n\n  const handleDownloadReport = () => {\n    uiStore.addToast(\'success\', `Exported formal incident report for Case #${caseId}`);"
    raw_content: "import React, { useState } from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { casesStore, CaseViewModel } from \'../../stores/cases-store.ts\';\nimport {\n  Mail,\n  ShieldAlert,\n  AlertTriangle,\n  CheckCircle2,\n  XCircle,\n  Download,\n  RotateCw,\n  MoreHorizontal,\n  ChevronRight,\n  Shield,\n  FileText,\n  Activity,\n  Archive,\n  History,\n  Copy,\n  Check,\n  ExternalLink,\n  Lock,\n  Globe,\n  Server,\n  ArrowRight,\n  AlertCircle,\n  Terminal,\n} from \'lucide-react\';\n\nexport const CaseDetailPage: React.FC = () => {\n  const ui = useUI();\n  const caseId = ui.activeCaseId || \'A2291\';\n  const caseData = casesStore.getCase(caseId) || {\n    id: \'A2291\',\n    subject: \'Invoice Payment Update - Action Required\',\n    sender: \'support@paypal1-secure.com\',\n    recipient: \'user@company.com\',\n    timestamp: \'2025-08-12T10:24:00Z\',\n    verdict: \'MALICIOUS\',\n    riskScore: 87.0,\n    confidence: 0.87,\n    originIp: \'185.220.101.5\',\n    originCountry: \'Germany\',\n    primaryIoc: \'paypal1-secure.com/invoice\',\n  };\n\n  const investigation = casesStore.getInvestigation(caseId);\n\n  const [activeTab, setActiveTab] = useState<\'summary\' | \'findings\' | \'journey\' | \'evidence\' | \'history\' | \'report\'>(\'summary\');\n  const [copiedUrl, setCopiedUrl] = useState(false);\n  const [isReinvestigating, setIsReinvestigating] = useState(false);\n\n  const handleCopyUrl = () => {\n    navigator.clipboard.writeText(\'https://paypal1-secure.com/invoice\');\n    setCopiedUrl(true);\n    setTimeout(() => setCopiedUrl(false), 2000);\n    uiStore.addToast(\'info\', \'Suspicious URL copied to clipboard\');\n  };\n\n  const handleReinvestigate = () => {\n    setIsReinvestigating(true);\n    uiStore.addToast(\'info\', `Autonomous re-investigation triggered for Case #${caseId}`);\n    setTimeout(() => {\n      setIsReinvestigating(false);\n      uiStore.addToast(\'success\', `Case #${caseId} telemetry verified with 8 forensic tools.`);\n    }, 1200);\n  };\n\n  const handleDownloadReport = () => {\n    uiStore.addToast(\'success\', `Exported formal incident report for Case #${caseId}`);\n    setActiveTab(\'report\');\n  };\n\n  return (\n    <div className=\"p-6 max-w-7xl mx-auto w-full space-y-6\">\n      {/* 1. CASE HEADER CARD */}\n      <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-6\">\n          {/* Left: Case Title & Metadata */}\n          <div className=\"flex items-start gap-4\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0\">\n              <Mail className=\"w-6 h-6\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <div className=\"flex flex-wrap items-center gap-2.5\">\n                <h1 className=\"text-2xl font-black text-slate-900 tracking-tight\">Case #{caseData.id}</h1>\n                <span className=\"flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200 text-xs font-bold\">\n                  <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n                  <span>Malicious</span>\n                </span>\n              </div>\n\n              <h2 className=\"text-base font-semibold text-slate-800\">\n                {caseData.subject}\n              </h2>\n\n              <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 pt-0.5\">\n                <div>\n                  <span className=\"text-slate-400\">From: </span>\n                  <span className=\"font-mono text-slate-700\">{caseData.sender}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">To: </span>\n                  <span className=\"font-mono text-slate-700\">{caseData.recipient}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">Received: </span>\n                  <span className=\"text-slate-700\">12 Aug 2025, 10:24 AM</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Circular Gauges & Action Buttons */}\n          <div className=\"flex flex-wrap items-center gap-5 shrink-0 self-start lg:self-center\">\n            {/* Confidence Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-2\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-blue-600\"\n                    strokeDasharray=\"87, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-xs font-bold text-slate-800\">87%</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-slate-800\">87%</div>\n                <div className=\"text-[11px] text-slate-500 font-medium\">Confidence</div>\n              </div>\n            </div>\n\n            {/* Risk Level Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-3 border-r border-slate-200\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-rose-500\"\n                    strokeDasharray=\"90, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-[11px] font-bold text-rose-600\">High</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-rose-600\">High</div>\n                <div className=\"text-[11px] text-slate-500 font-medium\">Risk Level</div>\n              </div>\n            </div>\n\n            {/* Actions: Download Report & Re-investigate */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={handleDownloadReport}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#0b1329] hover:bg-slate-900 text-white text-xs font-semibold transition-colors shadow-xs cursor-pointer\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>Download Report</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleReinvestigate}\n                disabled={isReinvestigating}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold transition-colors shadow-2xs cursor-pointer\"\n              >\n                <RotateCw className={`w-3.5 h-3.5 ${isReinvestigating ? \'animate-spin text-blue-600\' : \'\'}`} />\n                <span>Re-investigate</span>\n              </button>\n\n              <button\n                type=\"button\"\n                className=\"p-2 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-500 transition-colors shadow-2xs cursor-pointer\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. TAB NAVIGATION BAR */}\n      <div className=\"border-b border-slate-200 flex items-center gap-8 text-sm select-none\">\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'summary\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'summary\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Summary\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'findings\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'findings\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Findings\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'journey\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'journey\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Investigation Journey\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'evidence\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'evidence\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Evidence (6)\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'history\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'history\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Historical Context (3)\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'report\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'report\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Report\n        </button>\n      </div>\n\n      {/* 3. ACTIVE TAB CONTENT */}\n      {activeTab === \'summary\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {/* Col 1: Executive Summary */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-2 pb-2 border-b border-slate-100\">\n                <FileText className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"font-bold text-slate-900 text-sm\">Executive Summary</h3>\n              </div>\n\n              <p className=\"text-xs text-slate-600 leading-relaxed\">\n                This email is likely a phishing attempt impersonating PayPal. It contains a suspicious link leading to a lookalike domain and uses deceptive language to create urgency.\n              </p>\n\n              {/* Key Threat Box */}\n              <div className=\"p-3.5 rounded-xl bg-rose-50 border border-rose-100 flex items-start gap-3\">\n                <ShieldAlert className=\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\" />\n                <div>\n                  <div className=\"text-xs font-bold text-rose-900\">\n                    Key Threat: <span className=\"text-rose-700\">Impersonation + Credential Theft</span>\n                  </div>\n                  <p className=\"text-[11px] text-rose-800/80 mt-0.5 leading-snug\">\n                    Targeted credentials harvester mimicking official PayPal payment dispute workflow.\n                  </p>\n                </div>\n              </div>\n\n              {/* Attack Metadata List */}\n              <div className=\"pt-2 space-y-2 text-xs border-t border-slate-100\">\n                <div className=\"flex justify-between py-1\">\n                  <span className=\"text-slate-400\">Sender Domain:</span>\n                  <span className=\"font-mono text-slate-700 font-medium\">paypal1-secure.com</span>\n                </div>\n                <div className=\"flex justify-between py-1\">\n                  <span className=\"text-slate-400\">Return-Path:</span>\n                  <span className=\"font-mono text-slate-700\">bounce@paypal1-secure.com</span>\n                </div>\n                <div className=\"flex justify-between py-1\">\n                  <span className=\"text-slate-400\">Origin IP:</span>\n                  <span className=\"font-mono text-slate-700 font-medium\">185.220.101.5 (Germany)</span>\n                </div>\n                <div className=\"flex justify-between py-1\">\n                  <span className=\"text-slate-400\">Authentication:</span>\n                  <span className=\"text-slate-700 font-medium\">SPF Pass \342\200\242 DKIM None \342\200\242 DMARC Fail</span>\n                </div>\n                <div className=\"flex justify-between py-1\">\n                  <span className=\"text-slate-400\">Primary IoC:</span>\n                  <span className=\"font-mono text-rose-600 font-semibold truncate max-w-[180px]\">\n                    paypal1-secure.com/invoice\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400 flex items-center justify-between\">\n              <span>Investigation Engine: ASH-Adaptive v3.2</span>\n              <span className=\"font-mono text-emerald-600\">8 Tools Executed</span>\n            </div>\n          </div>\n\n          {/* Col 2: Key Findings */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between pb-2 border-b border-slate-100\">\n                <div className=\"flex items-center gap-2\">\n                  <Shield className=\"w-4 h-4 text-blue-600\" />\n                  <h3 className=\"font-bold text-slate-900 text-sm\">Key Findings</h3>\n                </div>\n                <span className=\"text-xs font-semibold text-slate-400\">6 Items</span>\n              </div>\n\n              {/* 6 Key Findings */}\n              <div className=\"space-y-3 mt-3\">\n                {/* 1. Suspicious Domain */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <AlertCircle className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">Suspicious Domain</p>\n                      <p className=\"text-[11px] text-slate-500 truncate\">paypal1-secure.com (lookalike registered 4h ago)</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-rose-50 text-rose-600 font-semibold text-[10px]\">\n                    Malicious\n                  </span>\n                </div>\n\n                {/* 2. Lookalike Brand */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">Lookalike Brand</p>\n                      <p className=\"text-[11px] text-slate-500 truncate\">Impersonates PayPal brand headers</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-amber-50 text-amber-600 font-semibold text-[10px]\">\n                    Warning\n                  </span>\n                </div>\n\n                {/* 3. SPF Check */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">SPF Check</p>\n                      <p className=\"text-[11px] text-slate-500 truncate\">Pass (Host permitted in rogue SPF record)</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[10px]\">\n                    Success\n                  </span>\n                </div>\n\n                {/* 4. DKIM Check */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">DKIM Check</p>\n                      <p className=\"text-[11px] text-slate-500 truncate\">Not found (Missing cryptographic signature)</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-amber-50 text-amber-600 font-semibold text-[10px]\">\n                    Warning\n                  </span>\n                </div>\n\n                {/* 5. Suspicious URL */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <AlertCircle className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">Suspicious URL</p>\n                      <p className=\"text-[11px] text-rose-600 font-medium truncate\">1 malicious URL detected in body</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-rose-50 text-rose-600 font-semibold text-[10px]\">\n                    Malicious\n                  </span>\n                </div>\n\n                {/* 6. Attachment Scan */}\n                <div className=\"flex items-start justify-between p-2 rounded-lg hover:bg-slate-50 transition-colors\">\n                  <div className=\"flex items-start gap-2.5 min-w-0\">\n                    <span className=\"w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5\">\n                      <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p className=\"text-xs font-semibold text-slate-800\">Attachment Scan</p>\n                      <p className=\"text-[11px] text-slate-500 truncate\">No malware detected (0 payload files)</p>\n                    </div>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[10px]\">\n                    Success\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'findings\')}\n              className=\"mt-4 pt-3 border-t border-slate-100 w-full flex items-center justify-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700 transition-colors cursor-pointer\"\n            >\n              <span>View All Findings</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          {/* Col 3: Threat Preview */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between pb-2 border-b border-slate-100\">\n                <div className=\"flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-blue-600\" />\n                  <h3 className=\"font-bold text-slate-900 text-sm\">Threat Preview</h3>\n                </div>\n                <span className=\"px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-semibold flex items-center gap-1\">\n                  <Lock className=\"w-2.5 h-2.5 text-slate-500\" />\n                  Safe Render\n                </span>\n              </div>\n\n              {/* Simulated Phishing Email Render */}\n              <div className=\"mt-3 p-4 rounded-xl bg-slate-50/70 border border-slate-200 text-xs space-y-3 font-sans\">\n                {/* Email headers */}\n                <div className=\"space-y-1 pb-2.5 border-b border-slate-200/80 text-[11px] text-slate-500 font-mono\">\n                  <p>\n                    <strong className=\"text-slate-700 font-sans\">From:</strong> PayPal Support &lt;support@paypal1-secure.com&gt;\n                  </p>\n                  <p>\n                    <strong className=\"text-slate-700 font-sans\">To:</strong> user@company.com\n                  </p>\n                  <p>\n                    <strong className=\"text-slate-700 font-sans\">Date:</strong> 12 Aug 2025, 10:24 AM\n                  </p>\n                </div>\n\n                {/* Email Body */}\n                <div className=\"pt-1 space-y-3 bg-white p-3.5 rounded-lg border border-slate-200/60 shadow-2xs\">\n                  {/* Brand Header Mock */}\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"w-7 h-7 rounded bg-blue-600 text-white font-black italic flex items-center justify-center text-sm\">\n                      P\n                    </div>\n                    <span className=\"font-extrabold text-blue-900 tracking-tight text-sm\">PayPal</span>\n                  </div>\n\n                  <h4 className=\"font-bold text-slate-900 text-xs\">Payment Confirmation Required</h4>\n\n                  <p className=\"text-[11px] text-slate-600 leading-relaxed\">\n                    Dear customer, We detected an unusual transaction of $349.00 USD on your account. If you did not authorize this, please review and cancel the invoice immediately.\n                  </p>\n\n                  {/* Phishing Call to Action */}\n                  <div className=\"pt-1\">\n                    <button\n                      type=\"button\"\n                      onClick={() => uiStore.addToast(\'warning\', \'Live click intercepted: URL points to phishing harvester!\')}\n                      className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-bold transition-colors cursor-pointer shadow-xs\"\n                    >\n                      View Invoice\n                    </button>\n                  </div>\n\n                  <p className=\"text-[10px] text-slate-400 pt-1 border-t border-slate-100\">\n                    PayPal Pte. Ltd. All rights reserved.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Suspicious URL Warning Banner with Copy */}\n            <div className=\"mt-4 p-3 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-between gap-2\">\n              <div className=\"flex items-center gap-2 min-w-0\">\n                <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0\" />\n                <div className=\"min-w-0\">\n                  <div className=\"text-[10px] font-bold text-rose-700 uppercase tracking-wider\">\n                    Suspicious URL Detected\n                  </div>\n                  <div className=\"text-xs font-mono text-rose-900 truncate\">\n                    https://paypal1-secure.com/invoice\n                  </div>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={handleCopyUrl}\n                className=\"px-2.5 py-1 rounded bg-white hover:bg-rose-100 border border-rose-200 text-rose-700 text-[11px] font-semibold flex items-center gap-1 shrink-0 transition-colors cursor-pointer\"\n              >\n                {copiedUrl ? <Check className=\"w-3 h-3 text-emerald-600\" /> : <Copy className=\"w-3 h-3\" />}\n                <span>{copiedUrl ? \'Copied\' : \'Copy\'}</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 4. FINDINGS TAB */}\n      {activeTab === \'findings\' && (\n        <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs space-y-6\">\n          <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n            <div>\n              <h3 className=\"font-bold text-slate-900 text-base\">Comprehensive Forensic Findings</h3>\n              <p className=\"text-xs text-slate-500\">Autonomous evaluation results across RFC 822 headers, domains, and network indicators</p>\n            </div>\n            <span className=\"px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200\">\n              Verdict: MALICIOUS (Risk 87/100)\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {/* Finding 1 */}\n            <div className=\"p-4 rounded-xl border border-rose-200 bg-rose-50/30 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                  <AlertCircle className=\"w-4 h-4 text-rose-600\" />\n                  Domain Typosquatting & Impersonation\n                </span>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-700\">CRITICAL</span>\n              </div>\n              <p className=\"text-xs text-slate-600\">\n                The sender domain <code className=\"text-rose-700 bg-white px-1 rounded\">paypal1-secure.com</code> uses deceptive string concatenation mimicking PayPal Inc. Registered only 4 hours prior via an anonymous registrar in Panama.\n              </p>\n            </div>\n\n            {/* Finding 2 */}\n            <div className=\"p-4 rounded-xl border border-rose-200 bg-rose-50/30 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                  <AlertCircle className=\"w-4 h-4 text-rose-600\" />\n                  Credential Harvesting Hyperlink\n                </span>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-700\">CRITICAL</span>\n              </div>\n              <p className=\"text-xs text-slate-600\">\n                Extracted URL <code className=\"text-rose-700 bg-white px-1 rounded\">https://paypal1-secure.com/invoice</code> loads an unauthenticated fake login form requesting payment card details and SSN.\n              </p>\n            </div>\n\n            {/* Finding 3 */}\n            <div className=\"p-4 rounded-xl border border-amber-200 bg-amber-50/30 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                  <AlertTriangle className=\"w-4 h-4 text-amber-600\" />\n                  Cryptographic Authentication Discrepancy\n                </span>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-700\">WARNING</span>\n              </div>\n              <p className=\"text-xs text-slate-600\">\n                DKIM signature is absent. While SPF passed against the malicious disposable host, DMARC alignment failed against official PayPal authentication policy (p=reject).\n              </p>\n            </div>\n\n            {/* Finding 4 */}\n            <div className=\"p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5\">\n                  <Globe className=\"w-4 h-4 text-blue-600\" />\n                  Anonymized Routing Relay\n                </span>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-slate-200 text-slate-700\">EVIDENCE</span>\n              </div>\n              <p className=\"text-xs text-slate-600\">\n                Origin relay IP <code className=\"text-slate-800 bg-white px-1 rounded\">185.220.101.5</code> is a known active Tor Exit Node in Frankfurt, Germany (AS205100).\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 5. INVESTIGATION JOURNEY TAB */}\n      {activeTab === \'journey\' && (\n        <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs space-y-6\">\n          <div className=\"border-b border-slate-100 pb-3\">\n            <h3 className=\"font-bold text-slate-900 text-base\">Autonomous Investigation Journey</h3>\n            <p className=\"text-xs text-slate-500\">Node-by-node execution trace of the multi-stage adaptive forensic loop</p>\n          </div>\n\n          <div className=\"relative pl-6 space-y-6 before:absolute before:left-[11px] before:top-3 before:bottom-3 before:w-[2px] before:bg-blue-200\">\n            {/* Step 1 */}\n            <div className=\"relative flex items-start gap-4\">\n              <div className=\"w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold ring-4 ring-blue-50 shrink-0\">\n                1\n              </div>\n              <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 w-full\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-xs text-slate-900\">Ingestion & RFC 822 Header Parsing</span>\n                  <span className=\"text-[11px] font-mono text-slate-400\">18ms</span>\n                </div>\n                <p className=\"text-xs text-slate-600 mt-1\">\n                  Extracted MIME structures, decoded base64 payload, and hashed full email payload with SHA-256.\n                </p>\n              </div>\n            </div>\n\n            {/* Step 2 */}\n            <div className=\"relative flex items-start gap-4\">\n              <div className=\"w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold ring-4 ring-blue-50 shrink-0\">\n                2\n              </div>\n              <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 w-full\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-xs text-slate-900\">Authentication Protocol Verification</span>\n                  <span className=\"text-[11px] font-mono text-slate-400\">142ms</span>\n                </div>\n                <p className=\"text-xs text-slate-600 mt-1\">\n                  Resolved DNS TXT records for SPF, checked DKIM public keys, and evaluated DMARC policy. Detected alignment failure.\n                </p>\n              </div>\n            </div>\n\n            {/* Step 3 */}\n            <div className=\"relative flex items-start gap-4\">\n              <div className=\"w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs font-bold ring-4 ring-rose-50 shrink-0\">\n                3\n              </div>\n              <div className=\"bg-rose-50/50 p-4 rounded-xl border border-rose-200 w-full\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-xs text-rose-900\">URL Canonicalization & Threat Feed Cross-Match</span>\n                  <span className=\"text-[11px] font-mono text-rose-600\">310ms</span>\n                </div>\n                <p className=\"text-xs text-rose-800 mt-1\">\n                  Discovered lookalike token in host part. Target flagged in antiphishing feeds as credential harvester.\n                </p>\n              </div>\n            </div>\n\n            {/* Step 4 */}\n            <div className=\"relative flex items-start gap-4\">\n              <div className=\"w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold ring-4 ring-emerald-50 shrink-0\">\n                4\n              </div>\n              <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 w-full\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-xs text-slate-900\">Final Verdict & Confidence Threshold Reached</span>\n                  <span className=\"text-[11px] font-mono text-slate-400\">Total: 1840ms</span>\n                </div>\n                <p className=\"text-xs text-slate-600 mt-1\">\n                  Confidence score achieved 0.87 (target: 0.80). Investigation halted with final recommendation: <strong>QUARANTINE</strong>.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 6. EVIDENCE TAB */}\n      {activeTab === \'evidence\' && (\n        <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n            <div>\n              <h3 className=\"font-bold text-slate-900 text-base\">Court-Admissible Evidence Atoms (6)</h3>\n              <p className=\"text-xs text-slate-500\">Cryptographically verifiable hashes and forensic chain of custody</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => uiStore.addToast(\'success\', \'Evidence bundle verified against tamper registry.\')}\n              className=\"text-xs font-semibold text-blue-600 hover:underline\"\n            >\n              Verify Hashes\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {[\n              {\n                id: \'EVD-DOM-01\',\n                type: \'Domain Lookalike\',\n                val: \'paypal1-secure.com\',\n                sha: \'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\',\n              },\n              {\n                id: \'EVD-URL-01\',\n                type: \'Malicious URL\',\n                val: \'https://paypal1-secure.com/invoice\',\n                sha: \'8f434346648f6b96df89dda901c5176b10a6d83961dd3c1ac88b59b2dc327aa4\',\n              },\n              {\n                id: \'EVD-IP-01\',\n                type: \'Tor Exit Origin\',\n                val: \'185.220.101.5:443\',\n                sha: \'ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb\',\n              },\n              {\n                id: \'EVD-SPF-01\',\n                type: \'DNS SPF Record\',\n                val: \'v=spf1 ip4:185.220.101.0/24 -all\',\n                sha: \'18ac3e7343f016890c510e93f935261169d9e3f565436429830faf093400e1a2\',\n              },\n              {\n                id: \'EVD-HDR-01\',\n                type: \'Raw RFC 822 Header Block\',\n                val: \'Message-ID: <202508121024.PAYPAL-ALERT@paypal1-secure.com>\',\n                sha: \'4b227777d4dd1fc61c6f884f48641d02b4d121d3fd328cb08b5531fcacdabf8a\',\n              },\n              {\n                id: \'EVD-TXT-01\',\n                type: \'NLP Threat Intent Vector\',\n                val: \'Urgent Action Required (0.912 Score)\',\n                sha: \'ef2d127de37b942baad06145e54b0c619a1f22327b2ebbcfbec78f5564afe39d\',\n              },\n            ].map((evd) => (\n              <div key={evd.id} className=\"p-3 rounded-lg border border-slate-200 bg-slate-50/60 flex items-center justify-between text-xs\">\n                <div className=\"space-y-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-bold text-slate-800\">{evd.id}</span>\n                    <span className=\"px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold text-[10px]\">\n                      {evd.type}\n                    </span>\n                  </div>\n                  <p className=\"font-mono text-slate-700 font-medium\">{evd.val}</p>\n                  <p className=\"text-[10px] text-slate-400 font-mono\">SHA-256: {evd.sha}</p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    navigator.clipboard.writeText(evd.sha);\n                    uiStore.addToast(\'info\', `Copied hash for ${evd.id}`);\n                  }}\n                  className=\"p-1.5 rounded hover:bg-slate-200 text-slate-500 transition-colors\"\n                  title=\"Copy SHA-256\"\n                >\n                  <Copy className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* 7. HISTORICAL CONTEXT TAB */}\n      {activeTab === \'history\' && (\n        <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n          <div className=\"border-b border-slate-100 pb-3\">\n            <h3 className=\"font-bold text-slate-900 text-base\">Historical Threat Correlations (3)</h3>\n            <p className=\"text-xs text-slate-500\">Related cluster signatures and past campaign attacks in the CDGI SOC repository</p>\n          </div>\n\n          <div className=\"space-y-3 text-xs\">\n            <div className=\"p-4 rounded-xl border border-slate-200 hover:border-blue-400 transition-colors cursor-pointer\">\n              <div className=\"flex items-center justify-between font-semibold text-slate-800\">\n                <span>Campaign: \"Invoice-Phish-Wave-DE\"</span>\n                <span className=\"text-rose-600 font-bold\">96% Similarity</span>\n              </div>\n              <p className=\"text-slate-600 mt-1\">\n                Shares identical German Tor Exit relay (185.220.101.5) and registrar profile observed on 11 Aug 2025.\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-xl border border-slate-200 hover:border-blue-400 transition-colors cursor-pointer\">\n              <div className=\"flex items-center justify-between font-semibold text-slate-800\">\n                <span>Cluster: \"Lookalike Financial Brands\"</span>\n                <span className=\"text-amber-600 font-bold\">88% Similarity</span>\n              </div>\n              <p className=\"text-slate-600 mt-1\">\n                Domain naming syntax matches previous attacks mimicking Wells Fargo and Bank of America.\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-xl border border-slate-200 hover:border-blue-400 transition-colors cursor-pointer\">\n              <div className=\"flex items-center justify-between font-semibold text-slate-800\">\n                <span>Target Correlation: \"Finance & Accounting Sector\"</span>\n                <span className=\"text-blue-600 font-bold\">81% Similarity</span>\n              </div>\n              <p className=\"text-slate-600 mt-1\">\n                Recipients across 4 different corporate mailboxes received duplicate invoice lure variations within 1 hour.\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 8. REPORT TAB */}\n      {activeTab === \'report\' && (\n        <div className=\"bg-white rounded-xl p-8 border border-slate-200/80 shadow-xs space-y-6 max-w-4xl mx-auto\">\n          <div className=\"flex items-center justify-between pb-4 border-b-2 border-slate-900\">\n            <div>\n              <div className=\"text-xs font-mono font-bold text-slate-500 tracking-wider\">CDGI SOC FORENSIC REPORT</div>\n              <h2 className=\"text-xl font-black text-slate-900 mt-0.5\">INCIDENT DOSSIER: #{caseData.id}</h2>\n            </div>\n            <div className=\"text-right text-xs\">\n              <div className=\"font-bold text-slate-800\">SECURITY CLASSIFICATION</div>\n              <div className=\"text-rose-600 font-bold font-mono\">CONFIDENTIAL // SOC-ACTIONABLE</div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 text-xs\">\n            <div>\n              <span className=\"text-slate-400\">Timestamp:</span>\n              <p className=\"font-semibold text-slate-800\">12 Aug 2025, 10:24 AM UTC</p>\n            </div>\n            <div>\n              <span className=\"text-slate-400\">Lead Analyst:</span>\n              <p className=\"font-semibold text-slate-800\">Tarun Dange (SOC Analyst)</p>\n            </div>\n            <div>\n              <span className=\"text-slate-400\">Target User:</span>\n              <p className=\"font-semibold text-slate-800\">{caseData.recipient}</p>\n            </div>\n            <div>\n              <span className=\"text-slate-400\">Final Verdict:</span>\n              <p className=\"font-bold text-rose-600\">MALICIOUS (Quarantine Enforced)</p>\n            </div>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs leading-relaxed space-y-2\">\n            <h4 className=\"font-bold text-slate-900\">Analyst Conclusion</h4>\n            <p className=\"text-slate-700\">\n              The incoming message was verified by the ASHielder autonomous pipeline as a targeted credential harvesting phishing attack. The sender simulated PayPal payment notification workflows to deceive the employee into authenticating with their corporate credentials on rogue host <code>paypal1-secure.com</code>.\n            </p>\n            <p className=\"text-slate-700\">\n              The recipient mailbox was isolated, the sender domain blocked organization-wide at DNS and firewall perimeter, and the suspicious URL submitted to global threat intelligence feeds.\n            </p>\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-4 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={() => window.print()}\n              className=\"px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold cursor-pointer\"\n            >\n              Print Dossier\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => uiStore.addToast(\'success\', \'PDF Report exported to downloads.\')}\n              className=\"px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold cursor-pointer\"\n            >\n              Save as PDF\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
