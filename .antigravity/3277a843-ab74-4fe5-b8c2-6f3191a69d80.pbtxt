      arguments_json: "{\"Instruction\":\"Reorganize middle section into fluid Row 2 (3 columns) and Row 3 (Recent Cases + Geolocation)\",\"ReplacementContent\":\"      {/* 2. ANALYTICS & LIVE ACTIVITY SECTION */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6 [&>*]:min-w-0\\\">\\n        {/* Threat Overview Card */}\\n        <div className=\\\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between pb-3\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-blue-50 text-blue-600\\\">\\n                  <Shield className=\\\"w-4 h-4\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Threat Overview</h3>\\n              </div>\\n\\n              {/* Minimal Dynamic Timeframe Switcher: 24h, 7d, 14d, 30d */}\\n              <div className=\\\"flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600\\\">\\n                {([\'24h\', \'7d\', \'14d\', \'30d\'] as const).map((r) => (\\n                  <button\\n                    key={r}\\n                    type=\\\"button\\\"\\n                    onClick={() => setThreatPeriod(r)}\\n                    className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${\\n                      threatPeriod === r\\n                        ? \'bg-white text-blue-600 shadow-2xs font-bold\'\\n                        : \'hover:text-slate-900 text-slate-500\'\\n                    }`}\\n                  >\\n                    {r.toUpperCase()}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Bars */}\\n            <div className=\\\"space-y-3.5 mt-3\\\">\\n              {/* Malicious */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                  <span className=\\\"font-medium text-slate-700\\\">Malicious</span>\\n                  <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                    {activeThreats.malicious.count}\\n                  </span>\\n                </div>\\n                <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                  <div\\n                    className=\\\"bg-rose-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                    style={{ width: `${activeThreats.malicious.pct}%` }}\\n                  >\\n                    {activeThreats.malicious.pct}%\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Suspicious */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                  <span className=\\\"font-medium text-slate-700\\\">Suspicious</span>\\n                  <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                    {activeThreats.suspicious.count}\\n                  </span>\\n                </div>\\n                <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                  <div\\n                    className=\\\"bg-amber-400 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-slate-900 font-bold transition-all duration-300 ease-out\\\"\\n                    style={{ width: `${activeThreats.suspicious.pct}%` }}\\n                  >\\n                    {activeThreats.suspicious.pct}%\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Benign */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                  <span className=\\\"font-medium text-slate-700\\\">Benign</span>\\n                  <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                    {activeThreats.benign.count}\\n                  </span>\\n                </div>\\n                <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                  <div\\n                    className=\\\"bg-emerald-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                    style={{ width: `${activeThreats.benign.pct}%` }}\\n                  >\\n                    {activeThreats.benign.pct}%\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Inconclusive */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                  <span className=\\\"font-medium text-slate-700\\\">Inconclusive</span>\\n                  <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                    {activeThreats.inconclusive.count}\\n                  </span>\\n                </div>\\n                <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                  <div\\n                    className=\\\"bg-slate-400 h-full rounded-full flex items-center justify-end pr-1 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                    style={{ width: `${Math.max(4, activeThreats.inconclusive.pct)}%` }}\\n                  >\\n                    {activeThreats.inconclusive.pct}%\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Dynamic Risk Posture Banner */}\\n          <div\\n            className={`mt-5 p-3.5 rounded-xl border flex items-start gap-3 transition-colors duration-200 ${activeThreats.postureBg} ${activeThreats.postureBorder}`}\\n          >\\n            <AlertTriangle className={`w-5 h-5 shrink-0 mt-0.5 ${activeThreats.postureColor}`} />\\n            <div>\\n              <div className=\\\"text-xs font-bold text-slate-900\\\">\\n                Risk posture:{\' \'}\\n                <span className={activeThreats.postureColor}>{activeThreats.posture}</span>\\n              </div>\\n              <p className=\\\"text-[11px] text-slate-700 mt-0.5 leading-snug\\\">\\n                {activeThreats.note}\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Dynamic Email Volume Trend Card */}\\n        <DynamicEmailVolumeGraph />\\n\\n        {/* Live Investigation Activity Card */}\\n        <div className=\\\"md:col-span-2 xl:col-span-1 bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-100\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n                  <Radio className=\\\"w-4 h-4 text-blue-600\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Live Investigation Activity</h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => uiStore.navigate(\'/inbox\')}\\n                className=\\\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\\\"\\n              >\\n                <span>See all</span>\\n                <ArrowRight className=\\\"w-3 h-3\\\" />\\n              </button>\\n            </div>\\n\\n            {/* Timeline */}\\n            <div className=\\\"relative mt-4 pl-4 space-y-4 before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-200\\\">\\n              {/* 10:42 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:42</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">New case ingested</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">Invoice Payment Update.eml</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:37 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:37</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">URL analysis completed</p>\\n                  <p className=\\\"text-[11px] text-rose-600 font-medium truncate\\\">1 malicious URL detected</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:28 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:28</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">SPF check passed</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">paypal1-secure.com</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:16 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:16</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">Attachment scanned</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">No malware detected</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:03 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:03</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">Case #A2287 closed</p>\\n                  <p className=\\\"text-[11px] text-emerald-600 font-medium truncate\\\">Marked as Benign</p>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* 3. RECENT CASES & THREAT GEOLOCATION SECTION */}\\n      <div className=\\\"grid grid-cols-1 xl:grid-cols-12 gap-5 lg:gap-6 [&>*]:min-w-0\\\">\\n        {/* Left: Recent Cases Table Card */}\\n        <div className=\\\"xl:col-span-8 min-w-0 bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden flex flex-col justify-between\\\">\\n          <div>\\n            <div className=\\\"p-5 flex items-center justify-between border-b border-slate-100\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n                  <FileText className=\\\"w-4 h-4\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Recent Cases</h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => uiStore.navigate(\'/inbox\')}\\n                className=\\\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\\\"\\n              >\\n                <span>View all</span>\\n                <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n              </button>\\n            </div>\\n\\n            {/* Table */}\\n            <div className=\\\"overflow-x-auto min-w-0\\\">\\n              <table className=\\\"w-full text-left text-xs\\\">\\n                <thead className=\\\"bg-slate-50/70 text-slate-500 font-semibold border-b border-slate-100 uppercase tracking-wider text-[11px]\\\">\\n                  <tr>\\n                    <th className=\\\"py-3 px-4\\\">#</th>\\n                    <th className=\\\"py-3 px-4\\\">Subject</th>\\n                    <th className=\\\"py-3 px-4\\\">Sender</th>\\n                    <th className=\\\"py-3 px-4\\\">Risk</th>\\n                    <th className=\\\"py-3 px-4\\\">Status</th>\\n                    <th className=\\\"py-3 px-4\\\">Received</th>\\n                    <th className=\\\"py-3 px-4 text-right\\\"></th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-100\\\">\\n                  {/* Row 1: A2291 */}\\n                  <tr\\n                    onClick={() => handleCaseClick(\'A2291\')}\\n                    className=\\\"hover:bg-blue-50/40 cursor-pointer transition-colors group\\\"\\n                  >\\n                    <td className=\\\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\\\">A2291</td>\\n                    <td className=\\\"py-3.5 px-4 font-medium text-slate-800 max-w-xs sm:max-w-sm xl:max-w-md 2xl:max-w-lg truncate min-w-[150px]\\\">\\n                      Invoice Payment Update - Action Required\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 max-w-[150px] xl:max-w-[200px] truncate\\\">support@paypal1-secure.com</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"flex items-center gap-1.5 text-rose-600 font-semibold\\\">\\n                        <span className=\\\"w-2 h-2 rounded-full bg-rose-500\\\" />\\n                        <span>Malicious</span>\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <span className=\\\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-[11px]\\\">\\n                        Open\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 whitespace-nowrap\\\">12 Aug 2025, 10:24</td>\\n                    <td className=\\\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\\\">\\n                      <MoreHorizontal className=\\\"w-4 h-4 ml-auto\\\" />\\n                    </td>\\n                  </tr>\\n\\n                  {/* Row 2: A2290 */}\\n                  <tr\\n                    onClick={() => handleCaseClick(\'A2290\')}\\n                    className=\\\"hover:bg-blue-50/40 cursor-pointer transition-colors group\\\"\\n                  >\\n                    <td className=\\\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\\\">A2290</td>\\n                    <td className=\\\"py-3.5 px-4 font-medium text-slate-800 max-w-xs sm:max-w-sm xl:max-w-md 2xl:max-w-lg truncate min-w-[150px]\\\">\\n                      Your Account Has Been Limited\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 max-w-[150px] xl:max-w-[200px] truncate\\\">service@account-security.com</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"flex items-center gap-1.5 text-amber-500 font-semibold\\\">\\n                        <span className=\\\"w-2 h-2 rounded-full bg-amber-400\\\" />\\n                        <span>Suspicious</span>\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <span className=\\\"px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-600 font-semibold text-[11px]\\\">\\n                        Investigating\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 whitespace-nowrap\\\">12 Aug 2025, 09:18</td>\\n                    <td className=\\\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\\\">\\n                      <MoreHorizontal className=\\\"w-4 h-4 ml-auto\\\" />\\n                    </td>\\n                  </tr>\\n\\n                  {/* Row 3: A2289 */}\\n                  <tr\\n                    onClick={() => handleCaseClick(\'A2289\')}\\n                    className=\\\"hover:bg-blue-50/40 cursor-pointer transition-colors group\\\"\\n                  >\\n                    <td className=\\\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\\\">A2289</td>\\n                    <td className=\\\"py-3.5 px-4 font-medium text-slate-800 max-w-xs sm:max-w-sm xl:max-w-md 2xl:max-w-lg truncate min-w-[150px]\\\">\\n                      Meeting Schedule for Next Week\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 max-w-[150px] xl:max-w-[200px] truncate\\\">hr@company.com</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"flex items-center gap-1.5 text-emerald-600 font-semibold\\\">\\n                        <span className=\\\"w-2 h-2 rounded-full bg-emerald-500\\\" />\\n                        <span>Benign</span>\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <span className=\\\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[11px]\\\">\\n                        Closed\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 whitespace-nowrap\\\">12 Aug 2025, 08:41</td>\\n                    <td className=\\\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\\\">\\n                      <MoreHorizontal className=\\\"w-4 h-4 ml-auto\\\" />\\n                    </td>\\n                  </tr>\\n\\n                  {/* Row 4: A2288 */}\\n                  <tr\\n                    onClick={() => handleCaseClick(\'A2288\')}\\n                    className=\\\"hover:bg-blue-50/40 cursor-pointer transition-colors group\\\"\\n                  >\\n                    <td className=\\\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\\\">A2288</td>\\n                    <td className=\\\"py-3.5 px-4 font-medium text-slate-800 max-w-xs sm:max-w-sm xl:max-w-md 2xl:max-w-lg truncate min-w-[150px]\\\">\\n                      Re: Project Documents\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 max-w-[150px] xl:max-w-[200px] truncate\\\">tarun.dange@cdgi.edu.in</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"flex items-center gap-1.5 text-slate-500 font-semibold\\\">\\n                        <span className=\\\"w-2 h-2 rounded-full bg-slate-400\\\" />\\n                        <span>Inconclusive</span>\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <span className=\\\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-[11px]\\\">\\n                        Open\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 whitespace-nowrap\\\">11 Aug 2025, 17:15</td>\\n                    <td className=\\\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\\\">\\n                      <MoreHorizontal className=\\\"w-4 h-4 ml-auto\\\" />\\n                    </td>\\n                  </tr>\\n\\n                  {/* Row 5: A2287 */}\\n                  <tr\\n                    onClick={() => handleCaseClick(\'A2287\')}\\n                    className=\\\"hover:bg-blue-50/40 cursor-pointer transition-colors group\\\"\\n                  >\\n                    <td className=\\\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\\\">A2287</td>\\n                    <td className=\\\"py-3.5 px-4 font-medium text-slate-800 max-w-xs sm:max-w-sm xl:max-w-md 2xl:max-w-lg truncate min-w-[150px]\\\">\\n                      Urgent: Wire Transfer Request\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 max-w-[150px] xl:max-w-[200px] truncate\\\">cfo-office@secure-corp.org</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"flex items-center gap-1.5 text-rose-600 font-semibold\\\">\\n                        <span className=\\\"w-2 h-2 rounded-full bg-rose-500\\\" />\\n                        <span>Malicious</span>\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <span className=\\\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[11px]\\\">\\n                        Closed\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-500 whitespace-nowrap\\\">11 Aug 2025, 14:03</td>\\n                    <td className=\\\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\\\">\\n                      <MoreHorizontal className=\\\"w-4 h-4 ml-auto\\\" />\\n                    </td>\\n                  </tr>\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Right: Geolocation of Malicious Senders Card */}\\n        <div className=\\\"xl:col-span-4 min-w-0 bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-100\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n                  <Globe className=\\\"w-4 h-4 text-slate-700\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Geolocation of Malicious Senders</h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                className=\\\"flex items-center gap-1 text-xs text-slate-500 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition-colors\\\"\\n              >\\n                <span>{selectedGeoPeriod}</span>\\n                <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n              </button>\\n            </div>\\n\\n            {/* Interactive World Map with Real Geographic Contours and Attack Hotspots */}\\n            <div className=\\\"my-3\\\">\\n              <ThreatWorldMap />\\n            </div>\\n\\n            {/* Country Statistics */}\\n            <div className=\\\"space-y-2.5 text-xs\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">United States</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 sm:w-28 xl:w-36 max-w-[140px] flex-1 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-500 h-full rounded-full\\\" style={{ width: \'80%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right font-mono\\\">12</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Russia</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 sm:w-28 xl:w-36 max-w-[140px] flex-1 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-400 h-full rounded-full\\\" style={{ width: \'55%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right font-mono\\\">7</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">India</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 sm:w-28 xl:w-36 max-w-[140px] flex-1 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-300 h-full rounded-full\\\" style={{ width: \'40%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right font-mono\\\">5</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Germany</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 sm:w-28 xl:w-36 max-w-[140px] flex-1 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-300 h-full rounded-full\\\" style={{ width: \'32%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right font-mono\\\">4</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Others</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 sm:w-28 xl:w-36 max-w-[140px] flex-1 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-slate-400 h-full rounded-full\\\" style={{ width: \'60%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right font-mono\\\">11</span>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* 4. BOTTOM 3 COLUMNS: TOP THREAT TYPES, TOP TARGETED BRANDS, AI ASSISTANT */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6 [&>*]:min-w-0\\\">\",\"TargetContent\":\"      {/* 2. MIDDLE SECTION: THREAT OVERVIEW, EMAIL VOLUME TREND, LIVE ACTIVITY & GEOLOCATION */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        {/* Left 8 Cols: Threat Overview & Volume Trend */}\\n        <div className=\\\"lg:col-span-8 space-y-6\\\">\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n            {/* Threat Overview Card */}\\n            <div className=\\\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\\\">\\n              <div>\\n                <div className=\\\"flex items-center justify-between pb-3\\\">\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <span className=\\\"p-1 rounded bg-blue-50 text-blue-600\\\">\\n                      <Shield className=\\\"w-4 h-4\\\" />\\n                    </span>\\n                    <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Threat Overview</h3>\\n                  </div>\\n\\n                  {/* Minimal Dynamic Timeframe Switcher: 24h, 7d, 14d, 30d */}\\n                  <div className=\\\"flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600\\\">\\n                    {([\'24h\', \'7d\', \'14d\', \'30d\'] as const).map((r) => (\\n                      <button\\n                        key={r}\\n                        type=\\\"button\\\"\\n                        onClick={() => setThreatPeriod(r)}\\n                        className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${\\n                          threatPeriod === r\\n                            ? \'bg-white text-blue-600 shadow-2xs font-bold\'\\n                            : \'hover:text-slate-900 text-slate-500\'\\n                        }`}\\n                      >\\n                        {r.toUpperCase()}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n\\n                {/* Bars */}\\n                <div className=\\\"space-y-3.5 mt-3\\\">\\n                  {/* Malicious */}\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                      <span className=\\\"font-medium text-slate-700\\\">Malicious</span>\\n                      <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                        {activeThreats.malicious.count}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                      <div\\n                        className=\\\"bg-rose-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                        style={{ width: `${activeThreats.malicious.pct}%` }}\\n                      >\\n                        {activeThreats.malicious.pct}%\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  {/* Suspicious */}\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                      <span className=\\\"font-medium text-slate-700\\\">Suspicious</span>\\n                      <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                        {activeThreats.suspicious.count}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                      <div\\n                        className=\\\"bg-amber-400 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-slate-900 font-bold transition-all duration-300 ease-out\\\"\\n                        style={{ width: `${activeThreats.suspicious.pct}%` }}\\n                      >\\n                        {activeThreats.suspicious.pct}%\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  {/* Benign */}\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                      <span className=\\\"font-medium text-slate-700\\\">Benign</span>\\n                      <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                        {activeThreats.benign.count}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                      <div\\n                        className=\\\"bg-emerald-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                        style={{ width: `${activeThreats.benign.pct}%` }}\\n                      >\\n                        {activeThreats.benign.pct}%\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  {/* Inconclusive */}\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between text-xs mb-1\\\">\\n                      <span className=\\\"font-medium text-slate-700\\\">Inconclusive</span>\\n                      <span className=\\\"font-bold text-slate-900 font-mono\\\">\\n                        {activeThreats.inconclusive.count}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\\\">\\n                      <div\\n                        className=\\\"bg-slate-400 h-full rounded-full flex items-center justify-end pr-1 text-[9px] text-white font-bold transition-all duration-300 ease-out\\\"\\n                        style={{ width: `${Math.max(4, activeThreats.inconclusive.pct)}%` }}\\n                      >\\n                        {activeThreats.inconclusive.pct}%\\n                      </div>\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Dynamic Risk Posture Banner */}\\n              <div\\n                className={`mt-5 p-3.5 rounded-xl border flex items-start gap-3 transition-colors duration-200 ${activeThreats.postureBg} ${activeThreats.postureBorder}`}\\n              >\\n                <AlertTriangle className={`w-5 h-5 shrink-0 mt-0.5 ${activeThreats.postureColor}`} />\\n                <div>\\n                  <div className=\\\"text-xs font-bold text-slate-900\\\">\\n                    Risk posture:{\' \'}\\n                    <span className={activeThreats.postureColor}>{activeThreats.posture}</span>\\n                  </div>\\n                  <p className=\\\"text-[11px] text-slate-700 mt-0.5 leading-snug\\\">\\n                    {activeThreats.note}\\n                  </p>\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Dynamic Email Volume Trend Card */}\\n            <DynamicEmailVolumeGraph />\\n          </div>\\n        </div>\\n\\n        {/* Right 4 Cols: Live Activity & Geolocation */}\\n        <div className=\\\"lg:col-span-4 space-y-6\\\">\\n          {/* Live Investigation Activity Card */}\\n          <div className=\\\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\\\">\\n            <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-100\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n                  <Radio className=\\\"w-4 h-4 text-blue-600\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Live Investigation Activity</h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => uiStore.navigate(\'/inbox\')}\\n                className=\\\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\\\"\\n              >\\n                <span>See all</span>\\n                <ArrowRight className=\\\"w-3 h-3\\\" />\\n              </button>\\n            </div>\\n\\n            {/* Timeline */}\\n            <div className=\\\"relative mt-4 pl-4 space-y-4 before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-200\\\">\\n              {/* 10:42 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:42</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">New case ingested</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">Invoice Payment Update.eml</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:37 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:37</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">URL analysis completed</p>\\n                  <p className=\\\"text-[11px] text-rose-600 font-medium truncate\\\">1 malicious URL detected</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:28 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:28</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">SPF check passed</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">paypal1-secure.com</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:16 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:16</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">Attachment scanned</p>\\n                  <p className=\\\"text-[11px] text-slate-500 truncate\\\">No malware detected</p>\\n                </div>\\n              </div>\\n\\n              {/* 10:03 */}\\n              <div className=\\\"relative flex items-start gap-3\\\">\\n                <span className=\\\"text-[11px] font-mono text-slate-400 w-10 shrink-0\\\">10:03</span>\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\\\" />\\n                <div className=\\\"min-w-0\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-800\\\">Case #A2287 closed</p>\\n                  <p className=\\\"text-[11px] text-emerald-600 font-medium truncate\\\">Marked as Benign</p>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Geolocation of Malicious Senders Card */}\\n          <div className=\\\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\\\">\\n            <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-100\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n                  <Globe className=\\\"w-4 h-4 text-slate-700\\\" />\\n                </span>\\n                <h3 className=\\\"font-bold text-slate-900 text-sm\\\">Geolocation of Malicious Senders</h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                className=\\\"flex items-center gap-1 text-xs text-slate-500 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition-colors\\\"\\n              >\\n                <span>{selectedGeoPeriod}</span>\\n                <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n              </button>\\n            </div>\\n\\n            {/* Interactive World Map with Real Geographic Contours and Attack Hotspots */}\\n            <div className=\\\"my-3\\\">\\n              <ThreatWorldMap />\\n            </div>\\n\\n            {/* Country Statistics */}\\n            <div className=\\\"space-y-2.5 text-xs\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">United States</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-500 h-full rounded-full\\\" style={{ width: \'80%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right\\\">12</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Russia</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-400 h-full rounded-full\\\" style={{ width: \'55%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right\\\">7</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">India</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-300 h-full rounded-full\\\" style={{ width: \'40%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right\\\">5</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Germany</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-rose-300 h-full rounded-full\\\" style={{ width: \'32%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right\\\">4</span>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-600 font-medium\\\">Others</span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <div className=\\\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\\\">\\n                    <div className=\\\"bg-slate-400 h-full rounded-full\\\" style={{ width: \'60%\' }} />\\n                  </div>\\n                  <span className=\\\"font-bold text-slate-800 w-5 text-right\\\">11</span>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* 3. RECENT CASES TABLE CARD */}\\n      <div className=\\\"bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden\\\">\\n        <div className=\\\"p-5 flex items-center justify-between border-b border-slate-100\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"p-1 rounded bg-slate-100 text-slate-700\\\">\\n              <FileText className=\\\"w-4 h-4\\\" />\\n            </span>\\n            <h3 className=\\\"font-bold text-slate-900 