        lines {
          text: "  let path = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
