    replacement_chunks {
      target_content: "  // Workstation controls\n  piiMaskingEnabled: boolean;\n  toasts: ToastItem[];\n}\n\nconst initialUIState: UIState = {\n  currentPath: \'/overview\',\n  activeCaseId: \'A2291\',\n  activeCaseVerdict: null,\n  activeCaseRisk: null,\n  activeCaseConfidence: null,\n  activeCaseSubject: null,\n  activeTab: \'summary\',\n  isCopilotOpen: false,\n  isEvidenceInspectorOpen: false,\n  selectedEvidenceId: null,\n  isQuickPeekOpen: false,\n  quickPeekCaseId: null,\n  isMobileSidebarOpen: false,\n  isSearchOpen: false,\n  searchQuery: \'\',\n  piiMaskingEnabled: true,\n  toasts: [],\n};"
      replacement_content: "  // Workstation controls\n  piiMaskingEnabled: boolean;\n  theme: \'light\' | \'dark\';\n  toasts: ToastItem[];\n}\n\nfunction getInitialTheme(): \'light\' | \'dark\' {\n  if (typeof window === \'undefined\') return \'dark\';\n  try {\n    const saved = localStorage.getItem(\'ashielder_theme\');\n    if (saved === \'dark\' || saved === \'light\') return saved;\n  } catch {\n    // ignore\n  }\n  return \'dark\';\n}\n\nfunction applyTheme(theme: \'light\' | \'dark\') {\n  if (typeof document !== \'undefined\') {\n    if (theme === \'dark\') {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }\n  try {\n    localStorage.setItem(\'ashielder_theme\', theme);\n  } catch {\n    // ignore\n  }\n}\n\nconst initialTheme = getInitialTheme();\napplyTheme(initialTheme);\n\nconst initialUIState: UIState = {\n  currentPath: \'/overview\',\n  activeCaseId: \'A2291\',\n  activeCaseVerdict: null,\n  activeCaseRisk: null,\n  activeCaseConfidence: null,\n  activeCaseSubject: null,\n  activeTab: \'summary\',\n  isCopilotOpen: false,\n  isEvidenceInspectorOpen: false,\n  selectedEvidenceId: null,\n  isQuickPeekOpen: false,\n  quickPeekCaseId: null,\n  isMobileSidebarOpen: false,\n  isSearchOpen: false,\n  searchQuery: \'\',\n  piiMaskingEnabled: true,\n  theme: initialTheme,\n  toasts: [],\n};"
