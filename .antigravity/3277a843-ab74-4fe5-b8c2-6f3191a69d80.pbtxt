      target_content: "    const getVerdictPill = (verdict: Verdict) => {\n      switch (verdict) {\n        case Verdict.MALICIOUS:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-rose-600 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n              <span>Malicious</span>\n            </span>\n          );\n        case Verdict.SUSPICIOUS:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-amber-500 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-amber-400\" />\n              <span>Suspicious</span>\n            </span>\n          );\n        case Verdict.BENIGN:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-emerald-600 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n              <span>Benign</span>\n            </span>\n          );\n        case Verdict.INCONCLUSIVE:\n        default:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-slate-500 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-slate-400\" />\n              <span>Inconclusive</span>\n            </span>\n          );\n      }\n    };\n\n    const getStatusPill = (caseItem: CaseViewModel) => {\n      if (caseItem.verdict === Verdict.BENIGN) {\n        return (\n          <span className=\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[11px]\">\n            Closed\n          </span>\n        );\n      }\n      if (caseItem.verdict === Verdict.SUSPICIOUS) {\n        return (\n          <span className=\"px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-600 font-semibold text-[11px]\">\n            Investigating\n          </span>\n        );\n      }\n      return (\n        <span className=\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-[11px]\">\n          Open\n        </span>\n      );\n    };\n\n    const baseRowClass = `group border-b border-slate-100 transition-colors cursor-pointer select-none bg-white ${\n      isFocused\n        ? \'bg-blue-50/50\'\n        : isSelected\n        ? \'bg-blue-50/70\'\n        : \'hover:bg-blue-50/30\'\n    }`;\n\n    // ==========================================\n    // 1. COMPACT DENSITY (38px single-line)\n    // ==========================================\n    if (density === \'compact\') {\n      return (\n        <tr\n          id={`case-row-${caseItem.id}`}\n          className={`${baseRowClass} h-10 text-xs`}\n          onClick={(e) => onOpenWorkspace(caseItem, e)}\n        >\n          {/* Checkbox */}\n          <td\n            className=\"w-8 px-3 text-center\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onToggleSelect(caseItem.id, e);\n            }}\n          >\n            <input\n              type=\"checkbox\"\n              checked={isSelected}\n              onChange={() => {}}\n              aria-label={`Select case ${caseItem.id}`}\n              className=\"w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-0 cursor-pointer\"\n            />\n          </td>\n\n          {/* Case Identifier */}\n          <td className=\"w-28 px-3 font-bold text-slate-900 group-hover:text-blue-600\">\n            #{caseItem.id}\n          </td>\n\n          {/* Subject Line */}\n          <td className=\"px-3 font-medium text-slate-800 max-w-sm truncate\" title={caseItem.subject}>\n            {caseItem.subject}\n          </td>\n\n          {/* Sender */}\n          <td className=\"w-56 px-3 truncate text-slate-500\" title={caseItem.sender}>\n            {defangEmail(caseItem.sender)}\n          </td>\n\n          {/* Verdict */}\n          <td className=\"w-32 px-3\">\n            {getVerdictPill(caseItem.verdict)}\n          </td>\n\n          {/* Status */}\n          <td className=\"w-28 px-3\">\n            {getStatusPill(caseItem)}\n          </td>\n\n          {/* Received Time */}\n          <td className=\"w-36 px-3 text-slate-500 text-[11px]\">\n            {getShortTime(caseItem.timestamp)}\n          </td>\n\n          {/* Actions */}\n          <td className=\"w-16 px-3 text-right\">\n            <button\n              type=\"button\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onQuickPeek(caseItem.id, e);\n              }}\n              title=\"Quick Peek (Space)\"\n              className=\"p-1 rounded text-slate-400 hover:text-blue-600 hover:bg-slate-100 cursor-pointer\"\n            >\n              <Eye className=\"w-4 h-4\" />\n            </button>\n          </td>\n        </tr>\n      );\n    }\n\n    // ==========================================\n    // 2. STANDARD DENSITY (56px two-line)\n    // ==========================================\n    if (density === \'standard\') {\n      return (\n        <tr\n          id={`case-row-${caseItem.id}`}\n          className={`${baseRowClass} h-14 text-xs`}\n          onClick={(e) => onOpenWorkspace(caseItem, e)}\n        >\n          {/* Checkbox */}\n          <td\n            className=\"w-8 px-3 text-center align-middle\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onToggleSelect(caseItem.id, e);\n            }}\n          >\n            <input\n              type=\"checkbox\"\n              checked={isSelected}\n              onChange={() => {}}\n              aria-label={`Select case ${caseItem.id}`}\n              className=\"w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-0 cursor-pointer\"\n            />\n          </td>\n\n          {/* Case ID */}\n          <td className=\"w-28 px-3 align-middle font-bold text-slate-900 group-hover:text-blue-600\">\n            #{caseItem.id}\n          </td>\n\n          {/* Subject & Sender */}\n          <td className=\"px-3 align-middle\">\n            <div className=\"font-semibold text-slate-900 truncate max-w-md\" title={caseItem.subject}>\n              {caseItem.subject}\n            </div>\n            <div className=\"text-[11px] text-slate-500 truncate\" title={caseItem.sender}>\n              {defangEmail(caseItem.sender)}\n            </div>\n          </td>\n\n          {/* Verdict */}\n          <td className=\"w-32 px-3 align-middle\">\n            {getVerdictPill(caseItem.verdict)}\n          </td>\n\n          {/* Status */}\n          <td className=\"w-28 px-3 align-middle\">\n            {getStatusPill(caseItem)}\n          </td>\n\n          {/* Received Time */}\n          <td className=\"w-40 px-3 align-middle text-slate-500 text-[11px]\">\n            {getShortTime(caseItem.timestamp)}\n          </td>\n\n          {/* Actions */}\n          <td className=\"w-20 px-3 align-middle text-right\">\n            <div className=\"flex items-center justify-end gap-1\">\n              <button\n                type=\"button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onQuickPeek(caseItem.id, e);\n                }}\n                title=\"Quick Peek (Space)\"\n                className=\"p-1 rounded text-slate-400 hover:text-blue-600 hover:bg-slate-100 cursor-pointer\"\n              >\n                <Eye className=\"w-4 h-4\" />\n              </button>\n              <button\n                type=\"button\"\n                className=\"p-1 rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 cursor-pointer\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </td>\n        </tr>\n      );\n    }\n\n    // ==========================================\n    // 3. PREVIEW DENSITY (Detailed Forensic Row)\n    // ==========================================\n    return (\n      <tr\n        id={`case-row-${caseItem.id}`}\n        className={`${baseRowClass} h-20 text-xs`}\n        onClick={(e) => onOpenWorkspace(caseItem, e)}\n      >\n        {/* Checkbox */}\n        <td\n          className=\"w-8 px-3 text-center align-top pt-4\"\n          onClick={(e) => {\n            e.stopPropagation();\n            onToggleSelect(caseItem.id, e);\n          }}\n        >\n          <input\n            type=\"checkbox\"\n            checked={isSelected}\n            onChange={() => {}}\n            aria-label={`Select case ${caseItem.id}`}\n            className=\"w-3.5 h-3.5 rounded border-slate-300 text-blue-600 focus:ring-0 cursor-pointer\"\n          />\n        </td>\n\n        {/* Case ID */}\n        <td className=\"w-28 px-3 align-top pt-3.5 font-bold text-slate-900 group-hover:text-blue-600\">\n          #{caseItem.id}\n        </td>\n\n        {/* Subject, Sender & IoC */}\n        <td className=\"px-3 align-top pt-3 space-y-1\">\n          <div className=\"font-semibold text-slate-900 truncate max-w-lg\" title={caseItem.subject}>\n            {caseItem.subject}\n          </div>\n          <div className=\"flex items-center gap-3 text-[11px] text-slate-500\">\n            <span>From: {defangEmail(caseItem.sender)}</span>\n            {caseItem.originIp && (\n              <span className=\"text-slate-400\">IP: {caseItem.originIp}</span>\n            )}\n          </div>\n          {caseItem.primaryIoc && (\n            <div className=\"text-[10px] font-mono text-rose-600 bg-rose-50/80 px-2 py-0.5 rounded inline-block max-w-sm truncate\">\n              IoC: {caseItem.primaryIoc}\n            </div>\n          )}\n        </td>\n\n        {/* Verdict */}\n        <td className=\"w-32 px-3 align-top pt-3.5\">\n          {getVerdictPill(caseItem.verdict)}\n        </td>\n\n        {/* Status */}\n        <td className=\"w-28 px-3 align-top pt-3.5\">\n          {getStatusPill(caseItem)}\n        </td>\n\n        {/* Received Time */}\n        <td className=\"w-40 px-3 align-top pt-3.5 text-slate-500 text-[11px]\">\n          {getShortTime(caseItem.timestamp)}\n        </td>\n\n        {/* Actions */}\n        <td className=\"w-20 px-3 align-top pt-3.5 text-right\">\n          <div className=\"flex items-center justify-end gap-1\">\n            <button\n              type=\"button\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onQuickPeek(caseItem.id, e);\n              }}\n              title=\"Quick Peek (Space)\"\n              className=\"p-1 rounded text-slate-400 hover:text-blue-600 hover:bg-slate-100 cursor-pointer\"\n            >\n              <Eye className=\"w-4 h-4\" />\n            </button>\n            <ChevronRight className=\"w-4 h-4 text-slate-300 group-hover:text-slate-600\" />\n          </div>\n        </td>\n      </tr>\n    );"
      replacement_content: "    const getVerdictPill = (verdict: Verdict) => {\n      switch (verdict) {\n        case Verdict.MALICIOUS:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-rose-600 dark:text-rose-400 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n              <span>Malicious</span>\n            </span>\n          );\n        case Verdict.SUSPICIOUS:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-amber-500 dark:text-amber-400 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-amber-400\" />\n              <span>Suspicious</span>\n            </span>\n          );\n        case Verdict.BENIGN:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n              <span>Benign</span>\n            </span>\n          );\n        case Verdict.INCONCLUSIVE:\n        default:\n          return (\n            <span className=\"inline-flex items-center gap-1.5 text-slate-500 dark:text-slate-400 font-semibold\">\n              <span className=\"w-2 h-2 rounded-full bg-slate-400 dark:bg-slate-500\" />\n              <span>Inconclusive</span>\n            </span>\n          );\n      }\n    };\n\n    const getStatusPill = (caseItem: CaseViewModel) => {\n      if (caseItem.verdict === Verdict.BENIGN) {\n        return (\n          <span className=\"px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-semibold text-[11px]\">\n            Closed\n          </span>\n        );\n      }\n      if (caseItem.verdict === Verdict.SUSPICIOUS) {\n        return (\n          <span className=\"px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 font-semibold text-[11px]\">\n            Investigating\n          </span>\n        );\n      }\n      return (\n        <span className=\"px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-sky-400 font-semibold text-[11px]\">\n          Open\n        </span>\n      );\n    };\n\n    const baseRowClass = `group border-b border-slate-100 dark:border-slate-800 transition-colors cursor-pointer select-none bg-white dark:bg-[#0c1322] ${\n      isFocused\n        ? \'bg-blue-50/50 dark:bg-blue-950/40\'\n        : isSelected\n        ? \'bg-blue-50/70 dark:bg-blue-950/60\'\n        : \'hover:bg-blue-50/30 dark:hover:bg-slate-800/50\'\n    }`;\n\n    // ==========================================\n    // 1. COMPACT DENSITY (38px single-line)\n    // ==========================================\n    if (density === \'compact\') {\n      return (\n        <tr\n          id={`case-row-${caseItem.id}`}\n          className={`${baseRowClass} h-10 text-xs`}\n          onClick={(e) => onOpenWorkspace(caseItem, e)}\n        >\n          {/* Checkbox */}\n          <td\n            className=\"w-8 px-3 text-center\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onToggleSelect(caseItem.id, e);\n            }}\n          >\n            <input\n              type=\"checkbox\"\n              checked={isSelected}\n              onChange={() => {}}\n              aria-label={`Select case ${caseItem.id}`}\n              className=\"w-3.5 h-3.5 rounded border-slate-300 dark:border-slate-700 dark:bg-slate-900 text-blue-600 focus:ring-0 cursor-pointer\"\n            />\n          </td>\n\n          {/* Case Identifier */}\n          <td className=\"w-28 px-3 font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-sky-400\">\n            #{caseItem.id}\n          </td>\n\n          {/* Subject Line */}\n          <td className=\"px-3 font-medium text-slate-800 dark:text-slate-200 max-w-sm truncate\" title={caseItem.subject}>\n            {caseItem.subject}\n          </td>\n\n          {/* Sender */}\n          <td className=\"w-56 px-3 truncate text-slate-500 dark:text-slate-400\" title={caseItem.sender}>\n            {defangEmail(caseItem.sender)}\n          </td>\n\n          {/* Verdict */}\n          <td className=\"w-32 px-3\">\n            {getVerdictPill(caseItem.verdict)}\n          </td>\n\n          {/* Status */}\n          <td className=\"w-28 px-3\">\n            {getStatusPill(caseItem)}\n          </td>\n\n          {/* Received Time */}\n          <td className=\"w-36 px-3 text-slate-500 dark:text-slate-400 text-[11px]\">\n            {getShortTime(caseItem.timestamp)}\n          </td>\n\n          {/* Actions */}\n          <td className=\"w-16 px-3 text-right\">\n            <button\n              type=\"button\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onQuickPeek(caseItem.id, e);\n              }}\n              title=\"Quick Peek (Space)\"\n              className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n            >\n              <Eye className=\"w-4 h-4\" />\n            </button>\n          </td>\n        </tr>\n      );\n    }\n\n    // ==========================================\n    // 2. STANDARD DENSITY (56px two-line)\n    // ==========================================\n    if (density === \'standard\') {\n      return (\n        <tr\n          id={`case-row-${caseItem.id}`}\n          className={`${baseRowClass} h-14 text-xs`}\n          onClick={(e) => onOpenWorkspace(caseItem, e)}\n        >\n          {/* Checkbox */}\n          <td\n            className=\"w-8 px-3 text-center align-middle\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onToggleSelect(caseItem.id, e);\n            }}\n          >\n            <input\n              type=\"checkbox\"\n              checked={isSelected}\n              onChange={() => {}}\n              aria-label={`Select case ${caseItem.id}`}\n              className=\"w-3.5 h-3.5 rounded border-slate-300 dark:border-slate-700 dark:bg-slate-900 text-blue-600 focus:ring-0 cursor-pointer\"\n            />\n          </td>\n\n          {/* Case ID */}\n          <td className=\"w-28 px-3 align-middle font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-sky-400\">\n            #{caseItem.id}\n          </td>\n\n          {/* Subject & Sender */}\n          <td className=\"px-3 align-middle\">\n            <div className=\"font-semibold text-slate-900 dark:text-white truncate max-w-md\" title={caseItem.subject}>\n              {caseItem.subject}\n            </div>\n            <div className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate\" title={caseItem.sender}>\n              {defangEmail(caseItem.sender)}\n            </div>\n          </td>\n\n          {/* Verdict */}\n          <td className=\"w-32 px-3 align-middle\">\n            {getVerdictPill(caseItem.verdict)}\n          </td>\n\n          {/* Status */}\n          <td className=\"w-28 px-3 align-middle\">\n            {getStatusPill(caseItem)}\n          </td>\n\n          {/* Received Time */}\n          <td className=\"w-40 px-3 align-middle text-slate-500 dark:text-slate-400 text-[11px]\">\n            {getShortTime(caseItem.timestamp)}\n          </td>\n\n          {/* Actions */}\n          <td className=\"w-20 px-3 align-middle text-right\">\n            <div className=\"flex items-center justify-end gap-1\">\n              <button\n                type=\"button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onQuickPeek(caseItem.id, e);\n                }}\n                title=\"Quick Peek (Space)\"\n                className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <Eye className=\"w-4 h-4\" />\n              </button>\n              <button\n                type=\"button\"\n                className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </td>\n        </tr>\n      );\n    }\n\n    // ==========================================\n    // 3. PREVIEW DENSITY (Detailed Forensic Row)\n    // ==========================================\n    return (\n      <tr\n        id={`case-row-${caseItem.id}`}\n        className={`${baseRowClass} h-20 text-xs`}\n        onClick={(e) => onOpenWorkspace(caseItem, e)}\n      >\n        {/* Checkbox */}\n        <td\n          className=\"w-8 px-3 text-center align-top pt-4\"\n          onClick={(e) => {\n            e.stopPropagation();\n            onToggleSelect(caseItem.id, e);\n          }}\n        >\n          <input\n            type=\"checkbox\"\n            checked={isSelected}\n            onChange={() => {}}\n            aria-label={`Select case ${caseItem.id}`}\n            className=\"w-3.5 h-3.5 rounded border-slate-300 dark:border-slate-700 dark:bg-slate-900 text-blue-600 focus:ring-0 cursor-pointer\"\n          />\n        </td>\n\n        {/* Case ID */}\n        <td className=\"w-28 px-3 align-top pt-3.5 font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-sky-400\">\n          #{caseItem.id}\n        </td>\n\n        {/* Subject, Sender & IoC */}\n        <td className=\"px-3 align-top pt-3 space-y-1\">\n          <div className=\"font-semibold text-slate-900 dark:text-white truncate max-w-lg\" title={caseItem.subject}>\n            {caseItem.subject}\n          </div>\n          <div className=\"flex items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400\">\n            <span>From: {defangEmail(caseItem.sender)}</span>\n            {caseItem.originIp && (\n              <span className=\"text-slate-400 dark:text-slate-500\">IP: {caseItem.originIp}</span>\n            )}\n          </div>\n          {caseItem.primaryIoc && (\n            <div className=\"text-[10px] font-mono text-rose-600 dark:text-rose-400 bg-rose-50/80 dark:bg-rose-950/40 border border-rose-200/60 dark:border-rose-900/40 px-2 py-0.5 rounded inline-block max-w-sm truncate\">\n              IoC: {caseItem.primaryIoc}\n            </div>\n          )}\n        </td>\n\n        {/* Verdict */}\n        <td className=\"w-32 px-3 align-top pt-3.5\">\n          {getVerdictPill(caseItem.verdict)}\n        </td>\n\n        {/* Status */}\n        <td className=\"w-28 px-3 align-top pt-3.5\">\n          {getStatusPill(caseItem)}\n        </td>\n\n        {/* Received Time */}\n        <td className=\"w-40 px-3 align-top pt-3.5 text-slate-500 dark:text-slate-400 text-[11px]\">\n          {getShortTime(caseItem.timestamp)}\n        </td>\n\n        {/* Actions */}\n        <td className=\"w-20 px-3 align-top pt-3.5 text-right\">\n          <div className=\"flex items-center justify-end gap-1\">\n            <button\n              type=\"button\"\n              onClick={(e) => {\n                e.stopPropagation();\n                onQuickPeek(caseItem.id, e);\n              }}\n              title=\"Quick Peek (Space)\"\n              className=\"p-1 rounded text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n            >\n              <Eye className=\"w-4 h-4\" />\n            </button>\n            <ChevronRight className=\"w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-slate-600 dark:group-hover:text-slate-300\" />\n          </div>\n        </td>\n      </tr>\n    );"
    }
