    replacement_chunks {
      target_content: "  return (\n    <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n      <div>\n        {/* Header with Title & Minimal Period Controls (24h / 7d / 14d / 30d) */}\n        <div className=\"flex items-center justify-between pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n              <Mail className=\"w-4 h-4 text-slate-700\" />\n            </span>\n            <div className=\"flex items-center gap-1.5\">\n              <h3 className=\"font-bold text-slate-900 text-sm\">Email Volume Trend</h3>\n            </div>\n          </div>\n\n          {/* Period selector: 24h / 7d / 14d / 30d */}\n          <div className=\"flex items-center bg-slate-100 p-0.5 rounded-md border border-slate-200 text-[10px] font-semibold text-slate-600\">\n            {([\'24h\', \'7d\', \'14d\', \'30d\'] as TimeRange[]).map((r) => (\n              <button\n                key={r}\n                type=\"button\"\n                onClick={() => {\n                  setTimeRange(r);\n                  setHoveredIndex(null);\n                }}\n                className={`px-1.5 py-0.5 rounded transition-colors cursor-pointer ${\n                  timeRange === r\n                    ? \'bg-white text-blue-700 shadow-2xs font-bold\'\n                    : \'hover:text-slate-900 text-slate-500\'\n                }`}\n              >\n                {r.toUpperCase()}\n              </button>\n            ))}\n          </div>\n        </div>"
      replacement_content: "  return (\n    <div className=\"bg-white dark:bg-[#0c1322] rounded-xl p-5 border border-slate-200/80 dark:border-slate-800/80 shadow-xs flex flex-col justify-between select-none transition-colors\">\n      <div>\n        {/* Header with Title & Minimal Period Controls (24h / 7d / 14d / 30d) */}\n        <div className=\"flex items-center justify-between pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300\">\n              <Mail className=\"w-4 h-4 text-slate-700 dark:text-slate-300\" />\n            </span>\n            <div className=\"flex items-center gap-1.5\">\n              <h3 className=\"font-bold text-slate-900 dark:text-white text-sm\">Email Volume Trend</h3>\n            </div>\n          </div>\n\n          {/* Period selector: 24h / 7d / 14d / 30d */}\n          <div className=\"flex items-center bg-slate-100 dark:bg-[#090e1a] p-0.5 rounded-md border border-slate-200 dark:border-slate-800 text-[10px] font-semibold text-slate-600 dark:text-slate-300\">\n            {([\'24h\', \'7d\', \'14d\', \'30d\'] as TimeRange[]).map((r) => (\n              <button\n                key={r}\n                type=\"button\"\n                onClick={() => {\n                  setTimeRange(r);\n                  setHoveredIndex(null);\n                }}\n                className={`px-1.5 py-0.5 rounded transition-colors cursor-pointer ${\n                  timeRange === r\n                    ? \'bg-white dark:bg-slate-800 text-blue-700 dark:text-sky-400 shadow-2xs font-bold\'\n                    : \'hover:text-slate-900 dark:hover:text-white text-slate-500 dark:text-slate-400\'\n                }`}\n              >\n                {r.toUpperCase()}\n              </button>\n            ))}\n          </div>\n        </div>"
