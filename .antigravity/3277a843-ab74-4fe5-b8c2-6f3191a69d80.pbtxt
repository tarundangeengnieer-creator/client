    replacement_chunks {
      target_content: "      {/* 1. CASE HEADER CARD */}\n      <div className=\"bg-white rounded-xl p-6 border border-slate-200/80 shadow-xs\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-6\">\n          {/* Left: Case Title & Metadata */}\n          <div className=\"flex items-start gap-4\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0\">\n              <Mail className=\"w-6 h-6\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <div className=\"flex flex-wrap items-center gap-2.5\">\n                <h1 className=\"text-2xl font-black text-slate-900 tracking-tight\">Case #{caseData.id}</h1>\n                <span className=\"flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200 text-xs font-bold\">\n                  <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n                  <span>Malicious</span>\n                </span>\n              </div>\n\n              <h2 className=\"text-base font-semibold text-slate-800\">\n                {caseData.subject}\n              </h2>\n\n              <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 pt-0.5\">\n                <div>\n                  <span className=\"text-slate-400\">From: </span>\n                  <span className=\"font-mono text-slate-700\">{caseData.sender}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">To: </span>\n                  <span className=\"font-mono text-slate-700\">{caseData.recipient}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400\">Received: </span>\n                  <span className=\"text-slate-700\">12 Aug 2025, 10:24 AM</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Circular Gauges & Action Buttons */}\n          <div className=\"flex flex-wrap items-center gap-5 shrink-0 self-start lg:self-center\">\n            {/* Confidence Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-2\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-blue-600\"\n                    strokeDasharray=\"87, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-xs font-bold text-slate-800\">87%</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-slate-800\">87%</div>\n                <div className=\"text-[11px] text-slate-500 font-medium\">Confidence</div>\n              </div>\n            </div>\n\n            {/* Risk Level Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-3 border-r border-slate-200\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-rose-500\"\n                    strokeDasharray=\"90, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-[11px] font-bold text-rose-600\">High</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-rose-600\">High</div>\n                <div className=\"text-[11px] text-slate-500 font-medium\">Risk Level</div>\n              </div>\n            </div>\n\n            {/* Actions: Download Report & Re-investigate */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={handleDownloadReport}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#0b1329] hover:bg-slate-900 text-white text-xs font-semibold transition-colors shadow-xs cursor-pointer\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>Download Report</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleReinvestigate}\n                disabled={isReinvestigating}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold transition-colors shadow-2xs cursor-pointer\"\n              >\n                <RotateCw className={`w-3.5 h-3.5 ${isReinvestigating ? \'animate-spin text-blue-600\' : \'\'}`} />\n                <span>Re-investigate</span>\n              </button>\n\n              <button\n                type=\"button\"\n                className=\"p-2 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-500 transition-colors shadow-2xs cursor-pointer\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. TAB NAVIGATION BAR */}\n      <div className=\"border-b border-slate-200 flex items-center gap-8 text-sm select-none\">\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'summary\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'summary\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Summary\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'findings\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'findings\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Findings\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'journey\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'journey\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Investigation Journey\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'evidence\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'evidence\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Evidence (6)\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'history\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'history\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Historical Context (3)\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'report\')}\n          className={`pb-3 font-semibold transition-colors relative cursor-pointer ${\n            activeTab === \'report\'\n              ? \'text-blue-600 border-b-2 border-blue-600\'\n              : \'text-slate-500 hover:text-slate-800\'\n          }`}\n        >\n          Report\n        </button>\n      </div>"
      replacement_content: "      {/* 1. CASE HEADER CARD */}\n      <div className=\"bg-white dark:bg-[#0c1322] rounded-xl p-6 border border-slate-200/80 dark:border-slate-800/80 shadow-xs transition-colors\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-6\">\n          {/* Left: Case Title & Metadata */}\n          <div className=\"flex items-start gap-4\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/50 border border-blue-100 dark:border-blue-900/50 flex items-center justify-center text-blue-600 dark:text-sky-400 shrink-0 shadow-xs\">\n              <Mail className=\"w-6 h-6\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <div className=\"flex flex-wrap items-center gap-2.5\">\n                <h1 className=\"text-2xl font-black text-slate-900 dark:text-white tracking-tight\">Case #{caseData.id}</h1>\n                <span className=\"flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 text-xs font-bold\">\n                  <span className=\"w-2 h-2 rounded-full bg-rose-500 animate-pulse\" />\n                  <span>High Risk</span>\n                </span>\n                <span className=\"px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-300 text-[11px] font-semibold\">\n                  Malicious\n                </span>\n              </div>\n\n              <h2 className=\"text-base font-semibold text-slate-800 dark:text-slate-200\">\n                {caseData.subject}\n              </h2>\n\n              <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 dark:text-slate-400 pt-0.5\">\n                <div>\n                  <span className=\"text-slate-400 dark:text-slate-500\">From: </span>\n                  <span className=\"font-mono text-slate-700 dark:text-slate-300 font-medium\">{caseData.sender}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 dark:text-slate-500\">To: </span>\n                  <span className=\"font-mono text-slate-700 dark:text-slate-300 font-medium\">{caseData.recipient}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 dark:text-slate-500\">Received: </span>\n                  <span className=\"text-slate-700 dark:text-slate-300\">12 Aug 2025, 10:24 AM</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 dark:text-slate-500\">Source: </span>\n                  <span className=\"text-slate-700 dark:text-slate-300\">Uploaded (.eml)</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 dark:text-slate-500\">Investigation ID: </span>\n                  <span className=\"font-mono text-slate-700 dark:text-slate-300 font-medium\">INV-7823</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Circular Gauges & Action Buttons */}\n          <div className=\"flex flex-wrap items-center gap-5 shrink-0 self-start lg:self-center\">\n            {/* Confidence Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-2\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100 dark:text-slate-800\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-blue-600 dark:text-sky-400\"\n                    strokeDasharray=\"87, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-xs font-bold text-slate-800 dark:text-slate-200\">87%</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-slate-800 dark:text-slate-200\">87%</div>\n                <div className=\"text-[11px] text-slate-500 dark:text-slate-400 font-medium\">Confidence</div>\n              </div>\n            </div>\n\n            {/* Risk Level Circular Gauge */}\n            <div className=\"flex items-center gap-3 pr-3 border-r border-slate-200 dark:border-slate-800\">\n              <div className=\"relative w-14 h-14 flex items-center justify-center\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-slate-100 dark:text-slate-800\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-rose-500\"\n                    strokeDasharray=\"90, 100\"\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute text-[11px] font-bold text-rose-600 dark:text-rose-400\">High</span>\n              </div>\n              <div className=\"text-left leading-tight\">\n                <div className=\"text-xs font-bold text-rose-600 dark:text-rose-400\">High</div>\n                <div className=\"text-[11px] text-slate-500 dark:text-slate-400 font-medium\">Risk Level</div>\n              </div>\n            </div>\n\n            {/* Actions: Download Report & Re-investigate */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={handleDownloadReport}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#0b1329] dark:bg-blue-600 hover:bg-slate-900 dark:hover:bg-blue-500 text-white text-xs font-semibold transition-colors shadow-xs cursor-pointer\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>Actions</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleReinvestigate}\n                disabled={isReinvestigating}\n                className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white dark:bg-[#0e1627] hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold transition-colors shadow-2xs cursor-pointer\"\n              >\n                <RotateCw className={`w-3.5 h-3.5 ${isReinvestigating ? \'animate-spin text-blue-600\' : \'\'}`} />\n                <span>Re-investigate</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => uiStore.addToast(\'info\', \'Additional options: Export STIX 2.1, Copy JSON payload, Send to SIEM.\')}\n                className=\"p-2 rounded-lg bg-white dark:bg-[#0e1627] hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 transition-colors shadow-2xs cursor-pointer\"\n                title=\"More Actions\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. TAB NAVIGATION BAR matching screenshot */}\n      <div className=\"border-b border-slate-200 dark:border-slate-800 flex items-center gap-6 sm:gap-7 text-xs font-medium select-none overflow-x-auto no-scrollbar pt-1\">\n        {[\n          { id: \'summary\', label: \'Summary\' },\n          { id: \'findings\', label: \'Findings\' },\n          { id: \'journey\', label: \'Investigation Journey\' },\n          { id: \'evidence\', label: \'Evidence (6)\' },\n          { id: \'headers\', label: \'Headers\' },\n          { id: \'body\', label: \'Body & Content\' },\n          { id: \'urls\', label: \'URLs (3)\' },\n          { id: \'attachments\', label: \'Attachments (1)\' },\n          { id: \'geolocation\', label: \'Geolocation\' },\n          { id: \'history\', label: \'Historical Context (3)\' },\n          { id: \'report\', label: \'Report\' },\n        ].map((tab) => (\n          <button\n            key={tab.id}\n            type=\"button\"\n            onClick={() => setActiveTab(tab.id as DetailTab)}\n            className={`pb-3 whitespace-nowrap transition-colors relative cursor-pointer font-semibold ${\n              activeTab === tab.id\n                ? \'text-blue-600 dark:text-sky-400 border-b-2 border-blue-600 dark:border-sky-400\'\n                : \'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200\'\n            }`}\n          >\n            {tab.label}\n          </button>\n        ))}\n      </div>"
    }
