          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function createSmoothPath(points: { x: number; y: number }[]): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (points.length < 2) return \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
