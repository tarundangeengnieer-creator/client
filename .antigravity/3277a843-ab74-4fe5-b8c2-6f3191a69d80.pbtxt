    content: "    );\n  }, [currentData]);\n\n  // Mouse tracking on forensic chart\n  const handleMouseMove = (e: React.MouseEvent<SVGSVGElement>) => {\n    if (!svgRef.current || dataPoints.length === 0) return;\n    const rect = svgRef.current.getBoundingClientRect();\n    const clientX = e.clientX - rect.left;\n    const svgX = (clientX / rect.width) * VIEW_WIDTH;\n\n    let closestIdx = 0;\n    let minDiff = Infinity;\n    dataPoints.forEach((p, idx) => {\n      const diff = Math.abs(p.x - svgX);\n      if (diff < minDiff) {\n        minDiff = diff;\n        closestIdx = idx;\n      }\n    });\n    setHoveredIndex(closestIdx);\n  };\n\n  const handleMouseLeave = () => {\n    setHoveredIndex(null);\n  };\n\n  return (\n    <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n      <div>\n        {/* Header with Title & Minimal Period Controls (24h / 7d / 14d / 30d) */}\n        <div className=\"flex items-center justify-between pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n              <Mail className=\"w-4 h-4 text-slate-700\" />\n            </span>\n            <div className=\"flex items-center gap-1.5\">\n              <h3 className=\"font-bold text-slate-900 text-sm\">Email Volume Trend</h3>\n            </div>\n          </div>\n\n          {/* Period selector: 24h / 7d / 14d / 30d */}"
    raw_content: "import React, { useState, useMemo, useRef, useEffect } from \'react\';\nimport { Mail, AlertCircle } from \'lucide-react\';\n\nexport type TimeRange = \'24h\' | \'7d\' | \'14d\' | \'30d\';\n\nexport interface VolumeDataPoint {\n  label: string;\n  fullDate: string;\n  totalEmails: number;\n  threats: number;\n  casesCreated: number;\n  autoClosed: number;\n  escalated: number;\n  threatLevel: \'Low\' | \'Moderate\' | \'High\' | \'Critical\';\n  anomaly?: boolean;\n}\n\nconst DATA_24H: VolumeDataPoint[] = [\n  { label: \'00:00\', fullDate: \'Today 00:00\', totalEmails: 4, threats: 0, casesCreated: 1, autoClosed: 3, escalated: 0, threatLevel: \'Low\' },\n  { label: \'02:00\', fullDate: \'Today 02:00\', totalEmails: 2, threats: 0, casesCreated: 0, autoClosed: 2, escalated: 0, threatLevel: \'Low\' },\n  { label: \'04:00\', fullDate: \'Today 04:00\', totalEmails: 3, threats: 0, casesCreated: 1, autoClosed: 2, escalated: 0, threatLevel: \'Low\' },\n  { label: \'06:00\', fullDate: \'Today 06:00\', totalEmails: 7, threats: 1, casesCreated: 2, autoClosed: 5, escalated: 0, threatLevel: \'Low\' },\n  { label: \'08:00\', fullDate: \'Today 08:00\', totalEmails: 18, threats: 2, casesCreated: 4, autoClosed: 14, escalated: 0, threatLevel: \'Moderate\' },\n  { label: \'10:00\', fullDate: \'Today 10:00\', totalEmails: 29, threats: 5, casesCreated: 6, autoClosed: 22, escalated: 1, threatLevel: \'Moderate\' },\n  { label: \'12:00\', fullDate: \'Today 12:00\', totalEmails: 35, threats: 8, casesCreated: 7, autoClosed: 26, escalated: 2, threatLevel: \'Critical\', anomaly: true },\n  { label: \'14:00\', fullDate: \'Today 14:00\', totalEmails: 31, threats: 4, casesCreated: 5, autoClosed: 25, escalated: 1, threatLevel: \'Moderate\' },\n  { label: \'16:00\', fullDate: \'Today 16:00\', totalEmails: 24, threats: 3, casesCreated: 4, autoClosed: 20, escalated: 0, threatLevel: \'Low\' },\n  { label: \'18:00\', fullDate: \'Today 18:00\', totalEmails: 15, threats: 1, casesCreated: 2, autoClosed: 13, escalated: 0, threatLevel: \'Low\' },\n  { label: \'20:00\', fullDate: \'Today 20:00\', totalEmails: 11, threats: 1, casesCreated: 2, autoClosed: 9, escalated: 0, threatLevel: \'Low\' },\n  { label: \'22:00\', fullDate: \'Today 22:00\', totalEmails: 6, threats: 0, casesCreated: 1, autoClosed: 5, escalated: 0, threatLevel: \'Low\' },\n];\n\nconst DATA_7D: VolumeDataPoint[] = [\n  { label: \'Mon\', fullDate: \'Aug 10\', totalEmails: 22, threats: 3, casesCreated: 4, autoClosed: 18, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Tue\', fullDate: \'Aug 11\', totalEmails: 26, threats: 4, casesCreated: 5, autoClosed: 21, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Wed\', fullDate: \'Aug 12\', totalEmails: 24, threats: 3, casesCreated: 4, autoClosed: 20, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Thu\', fullDate: \'Aug 13\', totalEmails: 28, threats: 5, casesCreated: 6, autoClosed: 21, escalated: 1, threatLevel: \'Moderate\' },\n  { label: \'Fri\', fullDate: \'Aug 14\', totalEmails: 36, threats: 9, casesCreated: 8, autoClosed: 25, escalated: 3, threatLevel: \'Critical\', anomaly: true },\n  { label: \'Sat\', fullDate: \'Aug 15\', totalEmails: 14, threats: 1, casesCreated: 2, autoClosed: 12, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Sun\', fullDate: \'Aug 16\', totalEmails: 12, threats: 1, casesCreated: 2, autoClosed: 10, escalated: 0, threatLevel: \'Low\' },\n];\n\nconst DATA_14D: VolumeDataPoint[] = [\n  { label: \'Aug 01\', fullDate: \'Aug 01\', totalEmails: 8, threats: 1, casesCreated: 2, autoClosed: 6, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 03\', fullDate: \'Aug 03\', totalEmails: 12, threats: 1, casesCreated: 3, autoClosed: 9, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 05\', fullDate: \'Aug 05\', totalEmails: 15, threats: 2, casesCreated: 3, autoClosed: 12, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 07\', fullDate: \'Aug 07\', totalEmails: 19, threats: 2, casesCreated: 4, autoClosed: 15, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 09\', fullDate: \'Aug 09\', totalEmails: 16, threats: 1, casesCreated: 3, autoClosed: 13, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 11\', fullDate: \'Aug 11\', totalEmails: 22, threats: 3, casesCreated: 5, autoClosed: 17, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 13\', fullDate: \'Aug 13\', totalEmails: 25, threats: 4, casesCreated: 5, autoClosed: 20, escalated: 0, threatLevel: \'Moderate\' },\n  { label: \'Aug 14\', fullDate: \'Aug 14\', totalEmails: 32, threats: 8, casesCreated: 7, autoClosed: 22, escalated: 3, threatLevel: \'Critical\', anomaly: true },\n  { label: \'Aug 15\', fullDate: \'Aug 15\', totalEmails: 28, threats: 4, casesCreated: 5, autoClosed: 23, escalated: 0, threatLevel: \'Moderate\' },\n  { label: \'Aug 16\', fullDate: \'Aug 16\', totalEmails: 26, threats: 3, casesCreated: 4, autoClosed: 22, escalated: 0, threatLevel: \'Low\' },\n];\n\nconst DATA_30D: VolumeDataPoint[] = [\n  { label: \'Jul 18\', fullDate: \'Jul 18\', totalEmails: 10, threats: 1, casesCreated: 2, autoClosed: 8, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Jul 22\', fullDate: \'Jul 22\', totalEmails: 14, threats: 1, casesCreated: 3, autoClosed: 11, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Jul 26\', fullDate: \'Jul 26\', totalEmails: 18, threats: 2, casesCreated: 4, autoClosed: 14, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Jul 30\', fullDate: \'Jul 30\', totalEmails: 21, threats: 3, casesCreated: 4, autoClosed: 17, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 03\', fullDate: \'Aug 03\', totalEmails: 16, threats: 2, casesCreated: 3, autoClosed: 13, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 07\', fullDate: \'Aug 07\', totalEmails: 24, threats: 4, casesCreated: 5, autoClosed: 19, escalated: 0, threatLevel: \'Low\' },\n  { label: \'Aug 10\', fullDate: \'Aug 10\', totalEmails: 27, threats: 5, casesCreated: 6, autoClosed: 21, escalated: 0, threatLevel: \'Moderate\' },\n  { label: \'Aug 14\', fullDate: \'Aug 14\', totalEmails: 38, threats: 9, casesCreated: 8, autoClosed: 26, escalated: 4, threatLevel: \'Critical\', anomaly: true },\n  { label: \'Aug 16\', fullDate: \'Aug 16\', totalEmails: 26, threats: 3, casesCreated: 4, autoClosed: 22, escalated: 0, threatLevel: \'Low\' },\n];\n\n/**\n * Calculates cubic Bezier path coordinates for a forensic baseline curve\n */\nfunction createSmoothPath(points: { x: number; y: number }[]): string {\n  if (points.length < 2) return \'\';\n  let path = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;\n\n  for (let i = 0; i < points.length - 1; i++) {\n    const p0 = points[i === 0 ? i : i - 1];\n    const p1 = points[i];\n    const p2 = points[i + 1];\n    const p3 = points[i + 2 < points.length ? i + 2 : i + 1];\n\n    const cp1x = p1.x + (p2.x - p0.x) / 6;\n    const cp1y = p1.y + (p2.y - p0.y) / 6;\n    const cp2x = p2.x - (p3.x - p1.x) / 6;\n    const cp2y = p2.y - (p3.y - p1.y) / 6;\n\n    path += ` C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;\n  }\n\n  return path;\n}\n\nexport const DynamicEmailVolumeGraph: React.FC = () => {\n  const [timeRange, setTimeRange] = useState<TimeRange>(\'14d\');\n  const [hoveredIndex, setHoveredIndex] = useState<number | null>(null);\n\n  const svgRef = useRef<SVGSVGElement | null>(null);\n\n  // Active dataset\n  const currentData = useMemo(() => {\n    switch (timeRange) {\n      case \'24h\':\n        return DATA_24H;\n      case \'7d\':\n        return DATA_7D;\n      case \'30d\':\n        return DATA_30D;\n      case \'14d\':\n      default:\n        return DATA_14D;\n    }\n  }, [timeRange]);\n\n  // Default active point is the anomaly or the latest point\n  const defaultAnomalyIndex = useMemo(() => {\n    const idx = currentData.findIndex((p) => p.anomaly);\n    return idx >= 0 ? idx : currentData.length - 1;\n  }, [currentData]);\n\n  const activeIndex = hoveredIndex !== null ? hoveredIndex : defaultAnomalyIndex;\n\n  // SVG Geometry - Engineered for compact 110px chart footprint\n  const VIEW_WIDTH = 340;\n  const VIEW_HEIGHT = 80;\n  const PADDING_LEFT = 24;\n  const PADDING_RIGHT = 10;\n  const PADDING_TOP = 8;\n  const PADDING_BOTTOM = 14;\n\n  const chartWidth = VIEW_WIDTH - PADDING_LEFT - PADDING_RIGHT;\n  const chartHeight = VIEW_HEIGHT - PADDING_TOP - PADDING_BOTTOM;\n\n  // Y-axis bounds\n  const maxValue = useMemo(() => {\n    const max = Math.max(...currentData.map((d) => d.totalEmails), 10);\n    return Math.ceil(max / 10) * 10;\n  }, [currentData]);\n\n  // Map coordinates\n  const dataPoints = useMemo(() => {\n    const count = currentData.length;\n    return currentData.map((point, index) => {\n      const x = PADDING_LEFT + (index / (count - 1)) * chartWidth;\n      const y = PADDING_TOP + chartHeight - (point.totalEmails / maxValue) * chartHeight;\n      return {\n        ...point,\n        x,\n        y,\n        index,\n      };\n    });\n  }, [currentData, maxValue, chartWidth, chartHeight]);\n\n  // Path calculations\n  const baselineLinePath = useMemo(() => {\n    if (dataPoints.length === 0) return \'\';\n    return createSmoothPath(dataPoints.map((p) => ({ x: p.x, y: p.y })));\n  }, [dataPoints]);\n\n  const baselineAreaPath = useMemo(() => {\n    if (dataPoints.length === 0) return \'\';\n    const spline = createSmoothPath(dataPoints.map((p) => ({ x: p.x, y: p.y })));\n    const baselineY = PADDING_TOP + chartHeight;\n    const firstX = dataPoints[0].x;\n    const lastX = dataPoints[dataPoints.length - 1].x;\n    return `${spline} L ${lastX.toFixed(1)} ${baselineY} L ${firstX.toFixed(1)} ${baselineY} Z`;\n  }, [dataPoints, chartHeight]);\n\n  const activePoint = dataPoints[activeIndex] || null;\n\n  // Aggregate Metrics: Auto-cleared & Pending Review\n  const totals = useMemo(() => {\n    return currentData.reduce(\n      (acc, d) => ({\n        totalEmails: acc.totalEmails + d.totalEmails,\n        autoCleared: acc.autoCleared + d.autoClosed,\n        pendingReview: acc.pendingReview + d.casesCreated,\n        escalated: acc.escalated + d.escalated,\n      }),\n      { totalEmails: 0, autoCleared: 0, pendingReview: 0, escalated: 0 }\n    );\n  }, [currentData]);\n\n  // Mouse tracking on forensic chart\n  const handleMouseMove = (e: React.MouseEvent<SVGSVGElement>) => {\n    if (!svgRef.current || dataPoints.length === 0) return;\n    const rect = svgRef.current.getBoundingClientRect();\n    const clientX = e.clientX - rect.left;\n    const svgX = (clientX / rect.width) * VIEW_WIDTH;\n\n    let closestIdx = 0;\n    let minDiff = Infinity;\n    dataPoints.forEach((p, idx) => {\n      const diff = Math.abs(p.x - svgX);\n      if (diff < minDiff) {\n        minDiff = diff;\n        closestIdx = idx;\n      }\n    });\n    setHoveredIndex(closestIdx);\n  };\n\n  const handleMouseLeave = () => {\n    setHoveredIndex(null);\n  };\n\n  return (\n    <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n      <div>\n        {/* Header with Title & Minimal Period Controls (24h / 7d / 14d / 30d) */}\n        <div className=\"flex items-center justify-between pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n              <Mail className=\"w-4 h-4 text-slate-700\" />\n            </span>\n            <div className=\"flex items-center gap-1.5\">\n              <h3 className=\"font-bold text-slate-900 text-sm\">Email Volume Trend</h3>\n            </div>\n          </div>\n\n          {/* Period selector: 24h / 7d / 14d / 30d */}\n          <div className=\"flex items-center bg-slate-100 p-0.5 rounded-md border border-slate-200 text-[10px] font-semibold text-slate-600\">\n            {([\'24h\', \'7d\', \'14d\', \'30d\'] as TimeRange[]).map((r) => (\n              <button\n                key={r}\n                type=\"button\"\n                onClick={() => {\n                  setTimeRange(r);\n                  setHoveredIndex(null);\n                }}\n                className={`px-1.5 py-0.5 rounded transition-colors cursor-pointer ${\n                  timeRange === r\n                    ? \'bg-white text-blue-700 shadow-2xs font-bold\'\n                    : \'hover:text-slate-900 text-slate-500\'\n                }`}\n              >\n                {r.toUpperCase()}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Forensic Chart Area - exactly 110px height */}\n        <div className=\"relative mt-1 h-[110px] w-full\">\n          <svg\n            ref={svgRef}\n            viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}\n            className=\"w-full h-full overflow-visible\"\n            preserveAspectRatio=\"none\"\n            onMouseMove={handleMouseMove}\n            onMouseLeave={handleMouseLeave}\n          >\n            {/* Gridlines: Top, Mid, Bottom */}\n            <line\n              x1={PADDING_LEFT}\n              y1={PADDING_TOP}\n              x2={VIEW_WIDTH - PADDING_RIGHT}\n              y2={PADDING_TOP}\n              stroke=\"#f1f5f9\"\n              strokeDasharray=\"2 2\"\n              strokeWidth=\"0.8\"\n            />\n            <line\n              x1={PADDING_LEFT}\n              y1={PADDING_TOP + chartHeight / 2}\n              x2={VIEW_WIDTH - PADDING_RIGHT}\n              y2={PADDING_TOP + chartHeight / 2}\n              stroke=\"#f1f5f9\"\n              strokeDasharray=\"2 2\"\n              strokeWidth=\"0.8\"\n            />\n            <line\n              x1={PADDING_LEFT}\n              y1={PADDING_TOP + chartHeight}\n              x2={VIEW_WIDTH - PADDING_RIGHT}\n              y2={PADDING_TOP + chartHeight}\n              stroke=\"#e2e8f0\"\n              strokeWidth=\"1\"\n            />\n\n            {/* Y-axis Labels */}\n            <text\n              x={PADDING_LEFT - 4}\n              y={PADDING_TOP + 3}\n              textAnchor=\"end\"\n              fontSize=\"7.5\"\n              fill=\"#94a3b8\"\n              fontFamily=\"ui-monospace, monospace\"\n            >\n              {maxValue}\n            </text>\n            <text\n              x={PADDING_LEFT - 4}\n              y={PADDING_TOP + chartHeight / 2 + 2.5}\n              textAnchor=\"end\"\n              fontSize=\"7.5\"\n              fill=\"#94a3b8\"\n              fontFamily=\"ui-monospace, monospace\"\n            >\n              {Math.round(maxValue / 2)}\n            </text>\n            <text\n              x={PADDING_LEFT - 4}\n              y={PADDING_TOP + chartHeight}\n              textAnchor=\"end\"\n              fontSize=\"7.5\"\n              fill=\"#94a3b8\"\n              fontFamily=\"ui-monospace, monospace\"\n            >\n              0\n            </text>\n\n            {/* Subdued Baseline Area Fill (no heavy gradients) */}\n            {baselineAreaPath && (\n              <path\n                d={baselineAreaPath}\n                fill=\"#2563eb\"\n                fillOpacity=\"0.06\"\n              />\n            )}\n\n            {/* Thin Blue Baseline Line */}\n            {baselineLinePath && (\n              <path\n                d={baselineLinePath}\n                fill=\"none\"\n                stroke=\"#2563eb\"\n                strokeWidth=\"1.5\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              />\n            )}\n\n            {/* Small Data Points: 3-4px */}\n            {dataPoints.map((p) => {\n              const isActive = activePoint?.index === p.index;\n              const isAnomaly = p.anomaly;\n\n              return (\n                <g key={p.index}>\n                  {/* Subtle Red Ring + Gentle Pulse ONLY on actual high-risk anomalies */}\n                  {isAnomaly && (\n                    <circle\n                      cx={p.x}\n                      cy={p.y}\n                      r=\"6.5\"\n                      fill=\"none\"\n                      stroke=\"#ef4444\"\n                      strokeWidth=\"1.2\"\n                      strokeOpacity=\"0.75\"\n                      className=\"animate-pulse\"\n                    />\n                  )}\n\n                  {/* Data Point Dot */}\n                  <circle\n                    cx={p.x}\n                    cy={p.y}\n                    r={isActive ? 3.8 : 2.6}\n                    fill={isAnomaly ? \'#ef4444\' : isActive ? \'#1d4ed8\' : \'#3b82f6\'}\n                    stroke=\"#ffffff\"\n                    strokeWidth={isActive ? 1.4 : 1}\n                  />\n                </g>\n              );\n            })}\n\n            {/* Thin Vertical Guideline on Active Point */}\n            {activePoint && (\n              <line\n                x1={activePoint.x}\n                y1={PADDING_TOP}\n                x2={activePoint.x}\n                y2={PADDING_TOP + chartHeight}\n                stroke=\"#64748b\"\n                strokeWidth=\"0.8\"\n                strokeDasharray=\"2 2\"\n                opacity=\"0.6\"\n              />\n            )}\n          </svg>\n\n          {/* Compact Forensic Tooltip (Threat Level, Count, Date) */}\n          {activePoint && (\n            <div\n              className=\"absolute z-20 pointer-events-none transition-all duration-75 ease-out\"\n              style={{\n                left: `${(activePoint.x / VIEW_WIDTH) * 100}%`,\n                top: `${Math.max(2, Math.min(50, (activePoint.y / VIEW_HEIGHT) * 100 - 36))}%`,\n                transform: `translateX(${activePoint.x > VIEW_WIDTH * 0.7 ? \'-92%\' : activePoint.x < VIEW_WIDTH * 0.3 ? \'-8%\' : \'-50%\'})`,\n              }}\n            >\n              <div className=\"bg-slate-900 text-slate-100 text-[10px] font-sans px-2 py-1.5 rounded-md border border-slate-700 shadow-md flex flex-col gap-0.5 min-w-[105px]\">\n                <div className=\"flex items-center justify-between gap-1.5 border-b border-slate-800 pb-0.5\">\n                  <span className=\"text-[9.5px] font-mono text-slate-400\">{activePoint.fullDate}</span>\n                  <span\n                    className={`text-[8.5px] font-bold px-1 rounded uppercase tracking-wider ${\n                      activePoint.anomaly || activePoint.threatLevel === \'Critical\'\n                        ? \'bg-rose-950 text-rose-300 border border-rose-800/80\'\n                        : activePoint.threatLevel === \'Moderate\'\n                        ? \'bg-amber-950 text-amber-300 border border-amber-800/80\'\n                        : \'bg-slate-800 text-slate-300\'\n                    }`}\n                  >\n                    {activePoint.threatLevel}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-0.5\">\n                  <span className=\"text-slate-400 text-[9.5px]\">Emails:</span>\n                  <span className=\"font-bold font-mono text-white\">{activePoint.totalEmails}</span>\n                </div>\n\n                {activePoint.threats > 0 && (\n                  <div className=\"flex items-center justify-between text-[9px] text-rose-300\">\n                    <span className=\"flex items-center gap-0.5\">\n                      <AlertCircle className=\"w-2.5 h-2.5 text-rose-400\" />\n                      Threats:\n                    </span>\n                    <span className=\"font-mono font-semibold\">{activePoint.threats}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* X-Axis Tick Labels */}\n          <div className=\"flex justify-between pl-6 pr-2 text-[9px] text-slate-400 -mt-1 font-mono\">\n            {dataPoints\n              .filter((_, i, arr) => {\n                if (arr.length <= 6) return true;\n                return i % 2 === 0 || i === arr.length - 1;\n              })\n              .map((p) => (\n                <span\n                  key={p.index}\n                  className={activePoint?.index === p.index ? \'text-blue-600 font-bold\' : \'\'}\n                >\n                  {p.label}\n                </span>\n              ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Forensic Bottom Metrics: Auto-cleared & Pending Review (plus Total & Escalated) */}\n      <div className=\"grid grid-cols-4 gap-1.5 pt-3 mt-1 border-t border-slate-100 text-center\">\n        <div>\n          <div className=\"text-base font-bold text-slate-900 font-mono leading-tight\">\n            {totals.totalEmails}\n          </div>\n          <div className=\"text-[10px] text-slate-500 font-medium tracking-tight\">Total Volume</div>\n        </div>\n\n        <div>\n          <div className=\"text-base font-bold text-emerald-700 font-mono leading-tight\">\n            {totals.autoCleared}\n          </div>\n          <div className=\"text-[10px] text-emerald-800 font-medium tracking-tight\">Auto-cleared</div>\n        </div>\n\n        <div>\n          <div className=\"text-base font-bold text-amber-700 font-mono leading-tight\">\n            {totals.pendingReview}\n          </div>\n          <div className=\"text-[10px] text-amber-800 font-medium tracking-tight\">Pending Review</div>\n        </div>\n\n        <div>\n          <div className=\"text-base font-bold text-rose-600 font-mono leading-tight\">\n            {totals.escalated}\n          </div>\n          <div className=\"text-[10px] text-slate-500 font-medium tracking-tight\">Escalated</div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 478
    num_bytes: 20775
  }
}
