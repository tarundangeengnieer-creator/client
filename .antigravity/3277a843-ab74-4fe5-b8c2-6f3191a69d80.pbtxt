    content: "                </div>\n              </div>\n            </div>\n\n            {/* Dynamic Email Volume Trend Card */}\n            <DynamicEmailVolumeGraph />\n          </div>\n        </div>\n\n        {/* Right 4 Cols: Live Activity & Geolocation */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Live Investigation Activity Card */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                  <Radio className=\"w-4 h-4 text-blue-600\" />\n                </span>\n                <h3 className=\"font-bold text-slate-900 text-sm\">Live Investigation Activity</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => uiStore.navigate(\'/inbox\')}\n                className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\"\n              >\n                <span>See all</span>"
    raw_content: "import React, { useState } from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { casesStore } from \'../../stores/cases-store.ts\';\nimport { DynamicEmailVolumeGraph } from \'./DynamicEmailVolumeGraph.tsx\';\nimport { ThreatWorldMap } from \'./ThreatWorldMap.tsx\';\nimport {\n  Mail,\n  ShieldAlert,\n  AlertTriangle,\n  Clock,\n  ArrowUpRight,\n  TrendingUp,\n  ChevronDown,\n  ArrowRight,\n  Sparkles,\n  ExternalLink,\n  Shield,\n  FileText,\n  CheckCircle2,\n  XCircle,\n  HelpCircle,\n  Search,\n  MoreHorizontal,\n  Send,\n  Globe,\n  Radio,\n} from \'lucide-react\';\n\nexport const SecurityOverviewPage: React.FC = () => {\n  const [threatPeriod, setThreatPeriod] = useState<\'24h\' | \'7d\' | \'14d\' | \'30d\'>(\'30d\');\n  const [selectedGeoPeriod, setSelectedGeoPeriod] = useState(\'Last 30 days\');\n  const [selectedBrandPeriod, setSelectedBrandPeriod] = useState(\'Last 30 days\');\n  const [selectedTypePeriod, setSelectedTypePeriod] = useState(\'Last 30 days\');\n\n  const threatTimeframeData: Record<\n    \'24h\' | \'7d\' | \'14d\' | \'30d\',\n    {\n      malicious: { count: number; pct: number };\n      suspicious: { count: number; pct: number };\n      benign: { count: number; pct: number };\n      inconclusive: { count: number; pct: number };\n      posture: string;\n      postureColor: string;\n      postureBg: string;\n      postureBorder: string;\n      note: string;\n    }\n  > = {\n    \'24h\': {\n      malicious: { count: 8, pct: 31 },\n      suspicious: { count: 12, pct: 46 },\n      benign: { count: 5, pct: 19 },\n      inconclusive: { count: 1, pct: 4 },\n      posture: \'Elevated\',\n      postureColor: \'text-rose-600\',\n      postureBg: \'bg-rose-50/80\',\n      postureBorder: \'border-rose-100\',\n      note: \'Active credential-phishing lures detected during business hours today.\',\n    },\n    \'7d\': {\n      malicious: { count: 24, pct: 32 },\n      suspicious: { count: 34, pct: 45 },\n      benign: { count: 14, pct: 19 },\n      inconclusive: { count: 3, pct: 4 },\n      posture: \'Guarded\',\n      postureColor: \'text-amber-600\',\n      postureBg: \'bg-amber-50/80\',\n      postureBorder: \'border-amber-100\',\n      note: \'Mid-week surge in deceptive banking notification emails contained.\',\n    },\n    \'14d\': {\n      malicious: { count: 35, pct: 33 },\n      suspicious: { count: 48, pct: 45 },\n      benign: { count: 18, pct: 17 },\n      inconclusive: { count: 5, pct: 5 },\n      posture: \'Elevated\',\n      postureColor: \'text-rose-600\',\n      postureBg: \'bg-rose-50/80\',\n      postureBorder: \'border-rose-100\',\n      note: \'Most recent increase is associated with credential-phishing and malicious URL activity.\',\n    },\n    \'30d\': {\n      malicious: { count: 48, pct: 33 },\n      suspicious: { count: 67, pct: 46 },\n      benign: { count: 25, pct: 17 },\n      inconclusive: { count: 6, pct: 4 },\n      posture: \'Elevated\',\n      postureColor: \'text-rose-600\',\n      postureBg: \'bg-rose-50/80\',\n      postureBorder: \'border-rose-100\',\n      note: \'30-day baseline shows steady threat containment with 78% automated triage rate.\',\n    },\n  };\n\n  const activeThreats = threatTimeframeData[threatPeriod];\n\n  // AI Assistant state\n  const [aiPrompt, setAiPrompt] = useState(\'\');\n  const [aiResponse, setAiResponse] = useState<string | null>(null);\n  const [isAiLoading, setIsAiLoading] = useState(false);\n\n  // Active chart hover index\n  const [hoveredDataPoint, setHoveredDataPoint] = useState<number | null>(4); // default Aug 14\n\n  const trendData = [\n    { label: \'Aug 01\', value: 8, cases: 2 },\n    { label: \'Aug 04\', value: 14, cases: 4 },\n    { label: \'Aug 07\', value: 19, cases: 3 },\n    { label: \'Aug 10\', value: 22, cases: 5 },\n    { label: \'Aug 13\', value: 25, cases: 4 },\n    { label: \'Aug 14\', value: 32, cases: 7 },\n    { label: \'Aug 16\', value: 26, cases: 3 },\n  ];\n\n  const handleAiQuery = (queryText: string) => {\n    if (!queryText.trim()) return;\n    setIsAiLoading(true);\n    setAiResponse(null);\n\n    setTimeout(() => {\n      setIsAiLoading(false);\n      const lower = queryText.toLowerCase();\n      if (lower.includes(\'summarize\') || lower.includes(\'recent\')) {\n        setAiResponse(\n          \'**Executive Threat Summary:** Over the past 48 hours, 5 high-priority cases were ingested. **Case #A2291** (PayPal lookalike with Tor relay) represents an active credential phishing attack targeting accounts. 2 cases were automatically isolated and 18 cases safely closed.\'\n        );\n      } else if (lower.includes(\'domain\') || lower.includes(\'block\')) {\n        setAiResponse(\n          \'**Active Blocked Domains & IoCs:**\\n\342\200\242 `paypal1-secure.com` (Phishing Lookalike / IP 185.220.101.5)\\n\342\200\242 `secure-login.net` (Credential Harvest)\\n\342\200\242 `account-security.com` (Urgency Alert Lure)\'\n        );\n      } else if (lower.includes(\'threat\') || lower.includes(\'top\')) {\n        setAiResponse(\n          \'**Top Attack Vectors:**\\n1. **Credential Phishing** (38 incidents / 40.4%)\\n2. **Malicious URLs** (27 incidents / 28.7%)\\n3. **Brand Impersonation** (19 incidents / 20.2%)\\nPrimary target: Financial workflows & executive impersonation.\'\n        );\n      } else {\n        setAiResponse(\n          `**Analysis for \"${queryText}\":** Found 3 correlated cases matching this signature in the CDGI SOC repository. Threat posture is Elevated. Origin IPs trace to Tor relay infrastructure in Germany and Russia.`\n        );\n      }\n    }, 450);\n  };\n\n  const handleCaseClick = (caseId: string) => {\n    uiStore.setActiveCase(caseId);\n    uiStore.navigate(`/case/${caseId}`);\n  };\n\n  return (\n    <div className=\"w-full min-w-0 p-4 sm:p-5 lg:p-6 xl:p-8 space-y-5 lg:space-y-6\">\n      {/* 1. TOP 4 METRIC CARDS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 [&>*]:min-w-0\">\n        {/* Card 1: OPEN CASES */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-black\">\n              <Mail className=\"w-5 h-5 text-black stroke-black\" />\n            </div>\n            <span className=\"flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-xs font-semibold\">\n              <ArrowUpRight className=\"w-3.5 h-3.5\" />\n              +4 today\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">\n              OPEN CASES\n            </span>\n            <div className=\"text-3xl font-extrabold text-slate-900 mt-1\">24</div>\n            <p className=\"text-xs text-slate-500 mt-1\">Active investigations</p>\n          </div>\n        </div>\n\n        {/* Card 2: MALICIOUS */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"mt-4\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">\n              MALICIOUS\n            </span>\n            <div className=\"text-3xl font-extrabold text-rose-600 mt-1\">08</div>\n            <p className=\"text-xs text-slate-500 mt-1\">High-confidence threats</p>\n          </div>\n        </div>\n\n        {/* Card 3: SUSPICIOUS */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500\">\n              <AlertTriangle className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"mt-4\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">\n              SUSPICIOUS\n            </span>\n            <div className=\"text-3xl font-extrabold text-amber-500 mt-1\">11</div>\n            <p className=\"text-xs text-slate-500 mt-1\">Requires analyst review</p>\n          </div>\n        </div>\n\n        {/* Card 4: INVESTIGATING */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600\">\n              <Clock className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"mt-4\">\n            <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">\n              INVESTIGATING\n            </span>\n            <div className=\"text-3xl font-extrabold text-blue-600 mt-1\">05</div>\n            <p className=\"text-xs text-slate-500 mt-1\">Adaptive analysis running</p>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. MIDDLE SECTION: THREAT OVERVIEW, EMAIL VOLUME TREND, LIVE ACTIVITY & GEOLOCATION */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left 8 Cols: Threat Overview & Volume Trend */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {/* Threat Overview Card */}\n            <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n              <div>\n                <div className=\"flex items-center justify-between pb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"p-1 rounded bg-blue-50 text-blue-600\">\n                      <Shield className=\"w-4 h-4\" />\n                    </span>\n                    <h3 className=\"font-bold text-slate-900 text-sm\">Threat Overview</h3>\n                  </div>\n\n                  {/* Minimal Dynamic Timeframe Switcher: 24h, 7d, 14d, 30d */}\n                  <div className=\"flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600\">\n                    {([\'24h\', \'7d\', \'14d\', \'30d\'] as const).map((r) => (\n                      <button\n                        key={r}\n                        type=\"button\"\n                        onClick={() => setThreatPeriod(r)}\n                        className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${\n                          threatPeriod === r\n                            ? \'bg-white text-blue-600 shadow-2xs font-bold\'\n                            : \'hover:text-slate-900 text-slate-500\'\n                        }`}\n                      >\n                        {r.toUpperCase()}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Bars */}\n                <div className=\"space-y-3.5 mt-3\">\n                  {/* Malicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Malicious</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.malicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-rose-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.malicious.pct}%` }}\n                      >\n                        {activeThreats.malicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Suspicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Suspicious</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.suspicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-amber-400 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-slate-900 font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.suspicious.pct}%` }}\n                      >\n                        {activeThreats.suspicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Benign */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Benign</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.benign.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-emerald-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.benign.pct}%` }}\n                      >\n                        {activeThreats.benign.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Inconclusive */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Inconclusive</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.inconclusive.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-slate-400 h-full rounded-full flex items-center justify-end pr-1 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${Math.max(4, activeThreats.inconclusive.pct)}%` }}\n                      >\n                        {activeThreats.inconclusive.pct}%\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Dynamic Risk Posture Banner */}\n              <div\n                className={`mt-5 p-3.5 rounded-xl border flex items-start gap-3 transition-colors duration-200 ${activeThreats.postureBg} ${activeThreats.postureBorder}`}\n              >\n                <AlertTriangle className={`w-5 h-5 shrink-0 mt-0.5 ${activeThreats.postureColor}`} />\n                <div>\n                  <div className=\"text-xs font-bold text-slate-900\">\n                    Risk posture:{\' \'}\n                    <span className={activeThreats.postureColor}>{activeThreats.posture}</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-700 mt-0.5 leading-snug\">\n                    {activeThreats.note}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Dynamic Email Volume Trend Card */}\n            <DynamicEmailVolumeGraph />\n          </div>\n        </div>\n\n        {/* Right 4 Cols: Live Activity & Geolocation */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Live Investigation Activity Card */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                  <Radio className=\"w-4 h-4 text-blue-600\" />\n                </span>\n                <h3 className=\"font-bold text-slate-900 text-sm\">Live Investigation Activity</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => uiStore.navigate(\'/inbox\')}\n                className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\"\n              >\n                <span>See all</span>\n                <ArrowRight className=\"w-3 h-3\" />\n              </button>\n            </div>\n\n            {/* Timeline */}\n            <div className=\"relative mt-4 pl-4 space-y-4 before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-200\">\n              {/* 10:42 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:42</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">New case ingested</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">Invoice Payment Update.eml</p>\n                </div>\n              </div>\n\n              {/* 10:37 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:37</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">URL analysis completed</p>\n                  <p className=\"text-[11px] text-rose-600 font-medium truncate\">1 malicious URL detected</p>\n                </div>\n              </div>\n\n              {/* 10:28 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:28</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">SPF check passed</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">paypal1-secure.com</p>\n                </div>\n              </div>\n\n              {/* 10:16 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:16</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">Attachment scanned</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">No malware detected</p>\n                </div>\n              </div>\n\n              {/* 10:03 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:03</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">Case #A2287 closed</p>\n                  <p className=\"text-[11px] text-emerald-600 font-medium truncate\">Marked as Benign</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Geolocation of Malicious Senders Card */}\n          <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                  <Globe className=\"w-4 h-4 text-slate-700\" />\n                </span>\n                <h3 className=\"font-bold text-slate-900 text-sm\">Geolocation of Malicious Senders</h3>\n              </div>\n              <button\n                type=\"button\"\n                className=\"flex items-center gap-1 text-xs text-slate-500 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition-colors\"\n              >\n                <span>{selectedGeoPeriod}</span>\n                <ChevronDown className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n            {/* Interactive World Map with Real Geographic Contours and Attack Hotspots */}\n            <div className=\"my-3\">\n              <ThreatWorldMap />\n            </div>\n\n            {/* Country Statistics */}\n            <div className=\"space-y-2.5 text-xs\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-600 font-medium\">United States</span>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"bg-rose-500 h-full rounded-full\" style={{ width: \'80%\' }} />\n                  </div>\n                  <span className=\"font-bold text-slate-800 w-5 text-right\">12</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-600 font-medium\">Russia</span>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"bg-rose-400 h-full rounded-full\" style={{ width: \'55%\' }} />\n                  </div>\n                  <span className=\"font-bold text-slate-800 w-5 text-right\">7</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-600 font-medium\">India</span>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"bg-rose-300 h-full rounded-full\" style={{ width: \'40%\' }} />\n                  </div>\n                  <span className=\"font-bold text-slate-800 w-5 text-right\">5</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-600 font-medium\">Germany</span>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"bg-rose-300 h-full rounded-full\" style={{ width: \'32%\' }} />\n                  </div>\n                  <span className=\"font-bold text-slate-800 w-5 text-right\">4</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-600 font-medium\">Others</span>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-24 h-2 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"bg-slate-400 h-full rounded-full\" style={{ width: \'60%\' }} />\n                  </div>\n                  <span className=\"font-bold text-slate-800 w-5 text-right\">11</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. RECENT CASES TABLE CARD */}\n      <div className=\"bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden\">\n        <div className=\"p-5 flex items-center justify-between border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n              <FileText className=\"w-4 h-4\" />\n            </span>\n            <h3 className=\"font-bold text-slate-900 text-sm\">Recent Cases</h3>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => uiStore.navigate(\'/inbox\')}\n            className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\"\n          >\n            <span>View all</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Table */}\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50/70 text-slate-500 font-semibold border-b border-slate-100 uppercase tracking-wider text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">#</th>\n                <th className=\"py-3 px-4\">Subject</th>\n                <th className=\"py-3 px-4\">Sender</th>\n                <th className=\"py-3 px-4\">Risk</th>\n                <th className=\"py-3 px-4\">Status</th>\n                <th className=\"py-3 px-4\">Received</th>\n                <th className=\"py-3 px-4 text-right\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {/* Row 1: A2291 */}\n              <tr\n                onClick={() => handleCaseClick(\'A2291\')}\n                className=\"hover:bg-blue-50/40 cursor-pointer transition-colors group\"\n              >\n                <td className=\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\">A2291</td>\n                <td className=\"py-3.5 px-4 font-medium text-slate-800 max-w-xs truncate\">\n                  Invoice Payment Update - Action Required\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">support@paypal1-secure.com</td>\n                <td className=\"py-3.5 px-4\">\n                  <div className=\"flex items-center gap-1.5 text-rose-600 font-semibold\">\n                    <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n                    <span>Malicious</span>\n                  </div>\n                </td>\n                <td className=\"py-3.5 px-4\">\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-[11px]\">\n                    Open\n                  </span>\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">12 Aug 2025, 10:24</td>\n                <td className=\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\">\n                  <MoreHorizontal className=\"w-4 h-4 ml-auto\" />\n                </td>\n              </tr>\n\n              {/* Row 2: A2290 */}\n              <tr\n                onClick={() => handleCaseClick(\'A2290\')}\n                className=\"hover:bg-blue-50/40 cursor-pointer transition-colors group\"\n              >\n                <td className=\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\">A2290</td>\n                <td className=\"py-3.5 px-4 font-medium text-slate-800 max-w-xs truncate\">\n                  Your Account Has Been Limited\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">service@account-security.com</td>\n                <td className=\"py-3.5 px-4\">\n                  <div className=\"flex items-center gap-1.5 text-amber-500 font-semibold\">\n                    <span className=\"w-2 h-2 rounded-full bg-amber-400\" />\n                    <span>Suspicious</span>\n                  </div>\n                </td>\n                <td className=\"py-3.5 px-4\">\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-600 font-semibold text-[11px]\">\n                    Investigating\n                  </span>\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">12 Aug 2025, 09:18</td>\n                <td className=\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\">\n                  <MoreHorizontal className=\"w-4 h-4 ml-auto\" />\n                </td>\n              </tr>\n\n              {/* Row 3: A2289 */}\n              <tr\n                onClick={() => handleCaseClick(\'A2289\')}\n                className=\"hover:bg-blue-50/40 cursor-pointer transition-colors group\"\n              >\n                <td className=\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\">A2289</td>\n                <td className=\"py-3.5 px-4 font-medium text-slate-800 max-w-xs truncate\">\n                  Meeting Schedule for Next Week\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">hr@company.com</td>\n                <td className=\"py-3.5 px-4\">\n                  <div className=\"flex items-center gap-1.5 text-emerald-600 font-semibold\">\n                    <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                    <span>Benign</span>\n                  </div>\n                </td>\n                <td className=\"py-3.5 px-4\">\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[11px]\">\n                    Closed\n                  </span>\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">12 Aug 2025, 08:41</td>\n                <td className=\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\">\n                  <MoreHorizontal className=\"w-4 h-4 ml-auto\" />\n                </td>\n              </tr>\n\n              {/* Row 4: A2288 */}\n              <tr\n                onClick={() => handleCaseClick(\'A2288\')}\n                className=\"hover:bg-blue-50/40 cursor-pointer transition-colors group\"\n              >\n                <td className=\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\">A2288</td>\n                <td className=\"py-3.5 px-4 font-medium text-slate-800 max-w-xs truncate\">\n                  Re: Project Documents\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">tarun.dange@cdgi.edu.in</td>\n                <td className=\"py-3.5 px-4\">\n                  <div className=\"flex items-center gap-1.5 text-slate-500 font-semibold\">\n                    <span className=\"w-2 h-2 rounded-full bg-slate-400\" />\n                    <span>Inconclusive</span>\n                  </div>\n                </td>\n                <td className=\"py-3.5 px-4\">\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-600 font-semibold text-[11px]\">\n                    Open\n                  </span>\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">11 Aug 2025, 16:20</td>\n                <td className=\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\">\n                  <MoreHorizontal className=\"w-4 h-4 ml-auto\" />\n                </td>\n              </tr>\n\n              {/* Row 5: A2287 */}\n              <tr\n                onClick={() => handleCaseClick(\'A2287\')}\n                className=\"hover:bg-blue-50/40 cursor-pointer transition-colors group\"\n              >\n                <td className=\"py-3.5 px-4 font-bold text-slate-900 group-hover:text-blue-600\">A2287</td>\n                <td className=\"py-3.5 px-4 font-medium text-slate-800 max-w-xs truncate\">\n                  Password Reset Request\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">no-reply@secure-login.net</td>\n                <td className=\"py-3.5 px-4\">\n                  <div className=\"flex items-center gap-1.5 text-rose-600 font-semibold\">\n                    <span className=\"w-2 h-2 rounded-full bg-rose-500\" />\n                    <span>Malicious</span>\n                  </div>\n                </td>\n                <td className=\"py-3.5 px-4\">\n                  <span className=\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold text-[11px]\">\n                    Closed\n                  </span>\n                </td>\n                <td className=\"py-3.5 px-4 text-slate-500\">11 Aug 2025, 14:03</td>\n                <td className=\"py-3.5 px-4 text-right text-slate-400 group-hover:text-slate-600\">\n                  <MoreHorizontal className=\"w-4 h-4 ml-auto\" />\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* 4. BOTTOM 3 COLUMNS: TOP THREAT TYPES, TOP TARGETED BRANDS, AI ASSISTANT */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {/* Card 1: Top Threat Types */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                <ShieldAlert className=\"w-4 h-4\" />\n              </span>\n              <h3 className=\"font-bold text-slate-900 text-sm\">Top Threat Types</h3>\n            </div>\n            <button\n              type=\"button\"\n              className=\"flex items-center gap-1 text-xs text-slate-500 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition-colors\"\n            >\n              <span>{selectedTypePeriod}</span>\n              <ChevronDown className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3.5 mt-4 text-xs\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"w-6 h-6 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center\">\n                  <ShieldAlert className=\"w-3.5 h-3.5\" />\n                </span>\n                <span className=\"font-medium text-slate-800\">Credential Phishing</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">38</span>\n            </div>\n\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"w-6 h-6 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center\">\n                  <AlertTriangle className=\"w-3.5 h-3.5\" />\n                </span>\n                <span className=\"font-medium text-slate-800\">Malicious URLs</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">27</span>\n            </div>\n\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"w-6 h-6 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center\">\n                  <AlertTriangle className=\"w-3.5 h-3.5\" />\n                </span>\n                <span className=\"font-medium text-slate-800\">Impersonation</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">19</span>\n            </div>\n\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center\">\n                  <FileText className=\"w-3.5 h-3.5\" />\n                </span>\n                <span className=\"font-medium text-slate-800\">Malware Attachments</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">11</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 2: Top Targeted Brands */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                <Shield className=\"w-4 h-4\" />\n              </span>\n              <h3 className=\"font-bold text-slate-900 text-sm\">Top Targeted Brands</h3>\n            </div>\n            <button\n              type=\"button\"\n              className=\"flex items-center gap-1 text-xs text-slate-500 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition-colors\"\n            >\n              <span>{selectedBrandPeriod}</span>\n              <ChevronDown className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3.5 mt-4 text-xs\">\n            {/* PayPal */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-6 h-6 rounded bg-blue-600 text-white font-black text-xs italic flex items-center justify-center\">\n                  P\n                </div>\n                <span className=\"font-medium text-slate-800\">PayPal</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">28</span>\n            </div>\n\n            {/* Microsoft */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-6 h-6 grid grid-cols-2 gap-0.5 p-1 rounded bg-slate-50 border border-slate-200\">\n                  <div className=\"bg-rose-500 rounded-xs\" />\n                  <div className=\"bg-emerald-500 rounded-xs\" />\n                  <div className=\"bg-blue-500 rounded-xs\" />\n                  <div className=\"bg-amber-400 rounded-xs\" />\n                </div>\n                <span className=\"font-medium text-slate-800\">Microsoft</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">17</span>\n            </div>\n\n            {/* Google */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-6 h-6 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-blue-600 text-xs\">\n                  G\n                </div>\n                <span className=\"font-medium text-slate-800\">Google</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">13</span>\n            </div>\n\n            {/* DHL */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-6 h-6 rounded bg-amber-400 text-rose-700 font-extrabold text-[9px] flex items-center justify-center\">\n                  DHL\n                </div>\n                <span className=\"font-medium text-slate-800\">DHL</span>\n              </div>\n              <span className=\"font-bold text-slate-900\">8</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 3: AI Assistant */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2 pb-1\">\n              <Sparkles className=\"w-4 h-4 text-blue-600\" />\n              <h3 className=\"font-bold text-slate-900 text-sm\">AI Assistant</h3>\n            </div>\n            <p className=\"text-xs text-slate-500 leading-snug\">\n              Ask questions about this data, search cases, or get insights.\n            </p>\n\n            {/* Interactive Query Input */}\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                handleAiQuery(aiPrompt);\n              }}\n              className=\"mt-3 relative\"\n            >\n              <input\n                id=\"ai-assistant-input\"\n                type=\"text\"\n                value={aiPrompt}\n                onChange={(e) => setAiPrompt(e.target.value)}\n                placeholder=\"e.g. Show all malicious emails from last week...\"\n                className=\"w-full text-xs bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-9 py-2 outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 text-slate-800 placeholder:text-slate-400 transition-all\"\n              />\n              <button\n                type=\"submit\"\n                disabled={!aiPrompt.trim()}\n                className=\"absolute right-1.5 top-1/2 -translate-y-1/2 w-6 h-6 rounded-md bg-blue-600 disabled:bg-slate-300 text-white flex items-center justify-center transition-colors cursor-pointer disabled:cursor-not-allowed\"\n              >\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </form>\n\n            {/* AI Response Output if active */}\n            {isAiLoading && (\n              <div className=\"mt-3 p-2.5 rounded-lg bg-blue-50/70 border border-blue-100 text-xs text-blue-800 flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full border-2 border-blue-600 border-t-transparent animate-spin\" />\n                <span>Analyzing telemetry and generating threat brief...</span>\n              </div>\n            )}\n\n            {aiResponse && !isAiLoading && (\n              <div className=\"mt-3 p-3 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-800 space-y-1.5 animate-fadeIn\">\n                <div className=\"whitespace-pre-line leading-relaxed font-sans\">{aiResponse}</div>\n              </div>\n            )}\n          </div>\n\n          {/* Clickable Suggestion Chips */}\n          <div className=\"flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                setAiPrompt(\'Summarize recent cases\');\n                handleAiQuery(\'Summarize recent cases\');\n              }}\n              className=\"text-[11px] font-medium bg-slate-50 hover:bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80 transition-colors cursor-pointer\"\n            >\n              Summarize recent cases\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => {\n                setAiPrompt(\'Show blocked domains\');\n                handleAiQuery(\'Show blocked domains\');\n              }}\n              className=\"text-[11px] font-medium bg-slate-50 hover:bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80 transition-colors cursor-pointer\"\n            >\n              Show blocked domains\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => {\n                setAiPrompt(\'What are top threats?\');\n                handleAiQuery(\'What are top threats?\');\n              }}\n              className=\"text-[11px] font-medium bg-slate-50 hover:bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200/80 transition-colors cursor-pointer\"\n            >\n              What are top threats?\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 901
    num_bytes: 43261
  }
}
