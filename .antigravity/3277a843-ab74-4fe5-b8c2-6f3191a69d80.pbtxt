    end_line: 33
    content: "import React from \'react\';\nimport { Card, CardHeader, CardTitle, CardContent } from \'../../components/ui/Card.tsx\';\nimport { Crosshair, Search } from \'lucide-react\';\n\nexport const HuntingPlaceholder: React.FC = () => {\n  return (\n    <div className=\"p-6 max-w-7xl mx-auto w-full space-y-6\">\n      <div className=\"pb-4 border-b border-slate-800\">\n        <h1 className=\"text-xl font-bold font-mono text-slate-100 flex items-center gap-2.5\">\n          <Crosshair className=\"w-5 h-5 text-sky-400\" />\n          <span>THREAT HUNTING & INDICATOR CORRELATION</span>\n        </h1>\n        <p className=\"text-xs text-slate-400 font-mono mt-1\">\n          Cross-campaign indicator pivot, CIDR lookup, and campaign attribution matrix\n        </p>\n      </div>\n\n      <Card className=\"border-slate-800 bg-slate-900/60 p-6\">\n        <div className=\"flex items-center gap-3 p-2 rounded bg-slate-950 border border-slate-800\">\n          <Search className=\"w-4 h-4 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search indicator: e.g. 185.220.101.5 or domain or SHA-256...\"\n            className=\"w-full bg-transparent text-xs font-mono text-slate-100 placeholder-slate-400 focus:outline-none\"\n          />\n        </div>\n        <p className=\"text-xs text-slate-400 font-mono mt-3\">\n          Phase 7 Threat Hunting Module will mount here with full CIDR filtering and IOC relationship graphs.\n        </p>\n      </Card>\n    </div>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { Card, CardHeader, CardTitle, CardContent } from \'../../components/ui/Card.tsx\';\nimport { Crosshair, Search } from \'lucide-react\';\n\nexport const HuntingPlaceholder: React.FC = () => {\n  return (\n    <div className=\"p-6 max-w-7xl mx-auto w-full space-y-6\">\n      <div className=\"pb-4 border-b border-slate-800\">\n        <h1 className=\"text-xl font-bold font-mono text-slate-100 flex items-center gap-2.5\">\n          <Crosshair className=\"w-5 h-5 text-sky-400\" />\n          <span>THREAT HUNTING & INDICATOR CORRELATION</span>\n        </h1>\n        <p className=\"text-xs text-slate-400 font-mono mt-1\">\n          Cross-campaign indicator pivot, CIDR lookup, and campaign attribution matrix\n        </p>\n      </div>\n\n      <Card className=\"border-slate-800 bg-slate-900/60 p-6\">\n        <div className=\"flex items-center gap-3 p-2 rounded bg-slate-950 border border-slate-800\">\n          <Search className=\"w-4 h-4 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search indicator: e.g. 185.220.101.5 or domain or SHA-256...\"\n            className=\"w-full bg-transparent text-xs font-mono text-slate-100 placeholder-slate-400 focus:outline-none\"\n          />\n        </div>\n        <p className=\"text-xs text-slate-400 font-mono mt-3\">\n          Phase 7 Threat Hunting Module will mount here with full CIDR filtering and IOC relationship graphs.\n        </p>\n      </Card>\n    </div>\n  );\n};\n"
    num_lines: 34
    num_bytes: 1460
  }
