    replacement_chunks {
      target_content: "    <aside\n      id=\"app-sidebar\"\n      className={`fixed lg:static top-0 bottom-0 left-0 z-40 w-64 bg-[#0a101d] border-r border-slate-800/80 flex flex-col justify-between shrink-0 select-none transition-transform duration-300 ease-in-out ${\n        ui.isMobileSidebarOpen ? \'translate-x-0 shadow-2xl\' : \'-translate-x-full lg:translate-x-0\'\n      }`}\n    >\n      {/* Top Brand Logo matching Image 1 */}\n      <div>\n        <div className=\"p-4 border-b border-slate-800/80 flex items-center justify-between\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"flex items-center gap-3 cursor-pointer group\"\n          >\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center p-1.5 shadow-xs group-hover:scale-105 transition-transform\">\n              <AshielderLogo className=\"w-full h-full text-[#38bdf8]\" />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"flex items-center leading-none\">\n                <span className=\"font-black text-[#0284c7] text-lg tracking-tight\">A</span>\n                <span className=\"font-black text-white text-lg tracking-tight\">SHIELDER</span>\n              </div>\n              {/* Official Saffron-White-Green Tricolor Bar */}\n              <div className=\"flex items-center h-[2.5px] w-14 rounded-full overflow-hidden my-1 shadow-xs\">\n                <span className=\"h-full w-1/3 bg-[#f97316]\" />\n                <span className=\"h-full w-1/3 bg-slate-200\" />\n                <span className=\"h-full w-1/3 bg-[#16a34a]\" />\n              </div>\n              <p className=\"text-[9px] font-semibold text-slate-400 tracking-tight leading-tight truncate\">\n                Smarter Threat Detection.\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => uiStore.setMobileSidebarOpen(false)}\n            className=\"lg:hidden p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/60 transition-colors ml-2 shrink-0 cursor-pointer\"\n            aria-label=\"Close navigation\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Main Navigation Items */}\n        <nav className=\"p-3 space-y-1\">\n          {navItems.map((item) => {\n            const active = isCurrentActive(item.path);\n            return (\n              <button\n                key={item.id}\n                id={`sidebar-nav-${item.id}`}\n                type=\"button\"\n                onClick={() => uiStore.navigate(item.path)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-left ${\n                  active\n                    ? \'bg-blue-600 text-white shadow-sm\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-slate-900/60\'\n                }`}\n              >\n                <span className={active ? \'text-white\' : \'text-slate-400\'}>{item.icon}</span>\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Bottom Auxiliary Links & User Profile */}\n      <div className=\"p-3 border-t border-slate-800/70 space-y-2\">\n        {/* Ingest raw .eml button shortcut */}\n        <button\n          id=\"sidebar-quick-ingest\"\n          type=\"button\"\n          onClick={() => uiStore.navigate(\'/ingest\')}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-sky-300 hover:bg-slate-900/60 transition-colors text-left\"\n        >\n          <UploadCloud className=\"w-4 h-4 text-sky-400\" />\n          <span>Ingest RFC 822 .eml</span>\n        </button>\n\n        {/* Help */}\n        <button\n          id=\"sidebar-help\"\n          type=\"button\"\n          onClick={() => {\n            uiStore.addToast(\'info\', \'Keyboard shortcuts: Press ? to view all operational keys.\');\n          }}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900/60 transition-colors text-left\"\n        >\n          <HelpCircle className=\"w-4 h-4\" />\n          <span>Help</span>\n        </button>\n\n        {/* System Status with green pulse */}\n        <div className=\"flex items-center justify-between px-3.5 py-2 text-xs text-slate-400\">\n          <div className=\"flex items-center gap-2.5\">\n            <Activity className=\"w-4 h-4 text-slate-400\" />\n            <span>System Status</span>\n          </div>\n          <span className=\"flex items-center gap-1.5 text-[11px] text-emerald-400\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n          </span>\n        </div>\n\n        {/* Tarun Dange SOC Analyst Profile Card */}\n        <div className=\"pt-2 border-t border-slate-800/60 relative\">\n          <button\n            id=\"sidebar-user-profile-btn\"\n            type=\"button\"\n            onClick={() => setShowProfileMenu((prev) => !prev)}\n            className=\"w-full flex items-center justify-between p-2 rounded-xl bg-slate-900/50 hover:bg-slate-900 border border-slate-800/60 transition-colors text-left\"\n          >\n            <div className=\"flex items-center gap-2.5 min-w-0\">\n              <div className=\"w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs\">\n                TD\n              </div>\n              <div className=\"min-w-0 leading-tight\">\n                <p className=\"text-xs font-semibold text-white truncate\">Tarun Dange</p>\n                <p className=\"text-[11px] text-slate-400\">SOC Analyst</p>\n                <div className=\"flex items-center gap-1 text-[10px] text-emerald-400 mt-0.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" />\n                  <span>Online</span>\n                </div>\n              </div>\n            </div>\n            <ChevronDown className=\"w-4 h-4 text-slate-400 shrink-0 ml-1\" />\n          </button>\n\n          {/* Profile Dropdown */}\n          {showProfileMenu && (\n            <div className=\"absolute bottom-full left-2 right-2 mb-2 bg-[#0d1733] border border-slate-700/80 rounded-xl shadow-xl p-1.5 z-30 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.navigate(\'/settings\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <User className=\"w-3.5 h-3.5\" />\n                <span>Analyst Profile</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Active Tenant: CDGI SOC Operations Center\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>CDGI SOC Verified</span>\n              </button>\n              <div className=\"my-1 border-t border-slate-800\" />\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Workstation session active. Offline-first local store.\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-rose-400 hover:bg-rose-950/40 rounded-lg text-left\"\n              >\n                <LogOut className=\"w-3.5 h-3.5\" />\n                <span>Sign Out</span>\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n    </aside>"
      replacement_content: "    <aside\n      id=\"app-sidebar\"\n      className={`fixed lg:static top-0 bottom-0 left-0 z-40 w-64 bg-[#0a101d] dark:bg-[#060a14] border-r border-slate-800/80 flex flex-col justify-between shrink-0 select-none transition-transform duration-300 ease-in-out ${\n        ui.isMobileSidebarOpen ? \'translate-x-0 shadow-2xl\' : \'-translate-x-full lg:translate-x-0\'\n      }`}\n    >\n      {/* Top Brand Logo matching Image 1 */}\n      <div>\n        <div className=\"p-4 border-b border-slate-800/80 flex items-center justify-between\">\n          <div\n            onClick={() => uiStore.navigate(\'/overview\')}\n            className=\"flex items-center gap-3 cursor-pointer group\"\n          >\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center p-1.5 shadow-xs group-hover:scale-105 transition-transform\">\n              <AshielderLogo className=\"w-full h-full text-[#38bdf8]\" />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"flex items-center leading-none\">\n                <span className=\"font-black text-[#0284c7] text-lg tracking-tight\">A</span>\n                <span className=\"font-black text-white text-lg tracking-tight\">SHIELDER</span>\n              </div>\n              {/* Official Saffron-White-Green Tricolor Bar */}\n              <div className=\"flex items-center h-[2.5px] w-14 rounded-full overflow-hidden my-1 shadow-xs\">\n                <span className=\"h-full w-1/3 bg-[#f97316]\" />\n                <span className=\"h-full w-1/3 bg-slate-200\" />\n                <span className=\"h-full w-1/3 bg-[#16a34a]\" />\n              </div>\n              <p className=\"text-[9px] font-semibold text-slate-400 tracking-tight leading-tight truncate\">\n                Smarter Threat Detection.\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => uiStore.setMobileSidebarOpen(false)}\n            className=\"lg:hidden p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/60 transition-colors ml-2 shrink-0 cursor-pointer\"\n            aria-label=\"Close navigation\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Main Navigation Items */}\n        <nav className=\"p-3 space-y-1\">\n          {navItems.map((item) => {\n            const active = isCurrentActive(item.path);\n            return (\n              <button\n                key={item.id}\n                id={`sidebar-nav-${item.id}`}\n                type=\"button\"\n                onClick={() => uiStore.navigate(item.path)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-left ${\n                  active\n                    ? \'bg-blue-600/20 text-sky-400 border border-blue-500/40 font-semibold shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-slate-900/60\'\n                }`}\n              >\n                <span className={active ? \'text-sky-400\' : \'text-slate-400\'}>{item.icon}</span>\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Bottom Auxiliary Links & User Profile */}\n      <div className=\"p-3 border-t border-slate-800/70 space-y-1.5\">\n        {/* Ingest raw .eml button shortcut */}\n        <button\n          id=\"sidebar-quick-ingest\"\n          type=\"button\"\n          onClick={() => uiStore.navigate(\'/ingest\')}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-sky-300 hover:bg-slate-900/60 transition-colors text-left cursor-pointer\"\n        >\n          <UploadCloud className=\"w-4 h-4 text-sky-400\" />\n          <span>Ingest RFC 822 .eml</span>\n        </button>\n\n        {/* Theme Mode Toggle in Sidebar */}\n        <button\n          id=\"sidebar-theme-toggle\"\n          type=\"button\"\n          onClick={() => uiStore.toggleTheme()}\n          className=\"w-full flex items-center justify-between px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900/60 transition-colors text-left cursor-pointer\"\n          title=\"Toggle Light / Dark Mode\"\n        >\n          <div className=\"flex items-center gap-3\">\n            {ui.theme === \'dark\' ? (\n              <Sun className=\"w-4 h-4 text-amber-400\" />\n            ) : (\n              <Moon className=\"w-4 h-4 text-sky-400\" />\n            )}\n            <span>{ui.theme === \'dark\' ? \'Light Theme\' : \'Dark Theme\'}</span>\n          </div>\n          <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-slate-800/90 text-slate-300 font-mono capitalize\">\n            {ui.theme}\n          </span>\n        </button>\n\n        {/* Help */}\n        <button\n          id=\"sidebar-help\"\n          type=\"button\"\n          onClick={() => {\n            uiStore.addToast(\'info\', \'Keyboard shortcuts: Press ? to view all operational keys.\');\n          }}\n          className=\"w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900/60 transition-colors text-left cursor-pointer\"\n        >\n          <HelpCircle className=\"w-4 h-4\" />\n          <span>Help</span>\n        </button>\n\n        {/* System Status with green pulse */}\n        <div className=\"flex items-center justify-between px-3.5 py-2 text-xs text-slate-400\">\n          <div className=\"flex items-center gap-2.5\">\n            <Activity className=\"w-4 h-4 text-slate-400\" />\n            <span>System Status</span>\n          </div>\n          <span className=\"flex items-center gap-1.5 text-[11px] text-emerald-400\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span className=\"text-[10px] text-emerald-400/90 font-mono\">100%</span>\n          </span>\n        </div>\n\n        {/* Tarun Dange SOC Analyst Profile Card */}\n        <div className=\"pt-2 border-t border-slate-800/60 relative\">\n          <button\n            id=\"sidebar-user-profile-btn\"\n            type=\"button\"\n            onClick={() => setShowProfileMenu((prev) => !prev)}\n            className=\"w-full flex items-center justify-between p-2 rounded-xl bg-slate-900/50 hover:bg-slate-900 border border-slate-800/60 transition-colors text-left cursor-pointer\"\n          >\n            <div className=\"flex items-center gap-2.5 min-w-0\">\n              <div className=\"w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-xs\">\n                TD\n              </div>\n              <div className=\"min-w-0 leading-tight\">\n                <p className=\"text-xs font-semibold text-white truncate\">Tarun Dange</p>\n                <p className=\"text-[11px] text-slate-400\">SOC Analyst</p>\n                <div className=\"flex items-center gap-1 text-[10px] text-emerald-400 mt-0.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" />\n                  <span>Online</span>\n                </div>\n              </div>\n            </div>\n            <ChevronDown className=\"w-4 h-4 text-slate-400 shrink-0 ml-1\" />\n          </button>\n\n          {/* Profile Dropdown */}\n          {showProfileMenu && (\n            <div className=\"absolute bottom-full left-2 right-2 mb-2 bg-[#0d1733] border border-slate-700/80 rounded-xl shadow-xl p-1.5 z-30 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.navigate(\'/settings\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <User className=\"w-3.5 h-3.5\" />\n                <span>Analyst Profile</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  uiStore.toggleTheme();\n                }}\n                className=\"w-full flex items-center justify-between px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  {ui.theme === \'dark\' ? <Sun className=\"w-3.5 h-3.5 text-amber-400\" /> : <Moon className=\"w-3.5 h-3.5 text-sky-400\" />}\n                  <span>Switch to {ui.theme === \'dark\' ? \'Light\' : \'Dark\'}</span>\n                </div>\n                <span className=\"text-[10px] text-slate-400 font-mono capitalize\">{ui.theme}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Active Tenant: CDGI SOC Operations Center\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-lg text-left\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>CDGI SOC Verified</span>\n              </button>\n              <div className=\"my-1 border-t border-slate-800\" />\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowProfileMenu(false);\n                  uiStore.addToast(\'info\', \'Workstation session active. Offline-first local store.\');\n                }}\n                className=\"w-full flex items-center gap-2 px-3 py-2 text-rose-400 hover:bg-rose-950/40 rounded-lg text-left\"\n              >\n                <LogOut className=\"w-3.5 h-3.5\" />\n                <span>Sign Out</span>\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n    </aside>"
    }
    instruction: "Add theme toggle and refine dark theme styling in Sidebar"
  }
}
