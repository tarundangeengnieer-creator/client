    raw_content: "import React, { useState } from \'react\';\nimport worldPaths from \'./worldMapData.json\';\n\ninterface Hotspot {\n  id: string;\n  country: string;\n  city: string;\n  ip: string;\n  x: number;\n  y: number;\n  threats: number;\n  risk: \'CRITICAL\' | \'HIGH\' | \'MEDIUM\';\n}\n\nconst ATTACK_HOTSPOTS: Hotspot[] = [\n  { id: \'us-east\', country: \'United States\', city: \'Ashburn, VA\', ip: \'198.51.100.24\', x: 215, y: 140, threats: 12, risk: \'CRITICAL\' },\n  { id: \'us-west\', country: \'United States\', city: \'San Jose, CA\', ip: \'192.0.2.78\', x: 170, y: 148, threats: 4, risk: \'HIGH\' },\n  { id: \'de-fra\', country: \'Germany\', city: \'Frankfurt\', ip: \'185.220.101.5\', x: 426, y: 114, threats: 4, risk: \'HIGH\' },\n  { id: \'ru-mow\', country: \'Russia\', city: \'Moscow\', ip: \'194.26.29.112\', x: 480, y: 104, threats: 7, risk: \'CRITICAL\' },\n  { id: \'in-mum\', country: \'India\', city: \'Mumbai\', ip: \'103.14.26.89\', x: 556, y: 178, threats: 5, risk: \'HIGH\' },\n  { id: \'cn-sha\', country: \'China\', city: \'Shanghai\', ip: \'222.186.42.15\', x: 672, y: 154, threats: 6, risk: \'CRITICAL\' },\n  { id: \'br-sao\', country: \'Brazil\', city: \'S\303\243o Paulo\', ip: \'177.54.144.2\', x: 300, y: 275, threats: 3, risk: \'MEDIUM\' },\n  { id: \'nl-ams\', country: \'Netherlands\', city: \'Amsterdam\', ip: \'45.154.255.8\', x: 418, y: 110, threats: 5, risk: \'HIGH\' },\n];\n\nexport const ThreatWorldMap: React.FC = () => {\n  const [hoveredHotspot, setHoveredHotspot] = useState<Hotspot | null>(null);\n\n  return (\n    <div className=\"relative w-full rounded-xl overflow-hidden bg-[#fafbfc] border border-slate-200/80 shadow-inner\">\n      {/* Subtle Coordinate Grid Lines */}\n      <div className=\"absolute inset-0 pointer-events-none opacity-30\">\n        <div className=\"w-full h-full\" style={{\n          backgroundImage: \'linear-gradient(to right, #e2e8f0 1px, transparent 1px), linear-gradient(to bottom, #e2e8f0 1px, transparent 1px)\',\n          backgroundSize: \'40px 30px\'\n        }} />\n      </div>\n\n      {/* Vector World Map Render */}\n      <svg\n        viewBox=\"0 0 800 400\"\n        className=\"w-full h-44 sm:h-48 select-none transition-all\"\n        style={{ filter: \'drop-shadow(0 1px 1px rgba(0,0,0,0.02))\' }}\n      >\n        <g id=\"world-countries\">\n          {worldPaths.map((c) => (\n            <path\n              key={c.id}\n              d={c.d}\n              fill=\"#eef2f6\"\n              stroke=\"#cbd5e1\"\n              strokeWidth=\"0.75\"\n              strokeLinejoin=\"round\"\n              className=\"hover:fill-slate-200/70 transition-colors duration-150\"\n            />\n          ))}\n        </g>\n\n        {/* Hotspot Attack Pins & Radiating Radar Rings */}\n        <g id=\"attack-hotspots\">\n          {ATTACK_HOTSPOTS.map((spot) => {\n            const isCritical = spot.risk === \'CRITICAL\';\n            const isHovered = hoveredHotspot?.id === spot.id;\n\n            return (\n              <g\n                key={spot.id}\n                className=\"cursor-pointer\"\n                onMouseEnter={() => setHoveredHotspot(spot)}\n                onMouseLeave={() => setHoveredHotspot(null)}\n              >\n                {/* Outer animated radar pulse ring */}\n                <circle\n                  cx={spot.x}\n                  cy={spot.y}\n                  r={isCritical ? 14 : 10}\n                  fill={isCritical ? \'#f43f5e\' : \'#f97316\'}\n                  opacity={isHovered ? 0.45 : 0.22}\n                  className=\"animate-ping\"\n                  style={{ transformOrigin: `${spot.x}px ${spot.y}px`, animationDuration: isCritical ? \'2s\' : \'3s\' }}\n                />\n\n                {/* Soft ambient halo */}\n                <circle\n                  cx={spot.x}\n                  cy={spot.y}\n                  r={isHovered ? 12 : 8}\n                  fill={isCritical ? \'#ef4444\' : \'#f97316\'}\n                  opacity={isHovered ? 0.35 : 0.2}\n                />\n\n                {/* Solid core pin */}\n                <circle\n                  cx={spot.x}\n                  cy={spot.y}\n                  r={isHovered ? 4.5 : 3.2}\n                  fill={isCritical ? \'#dc2626\' : \'#ea580c\'}\n                  stroke=\"#ffffff\"\n                  strokeWidth=\"1.5\"\n                />\n              </g>\n            );\n          })}\n        </g>\n      </svg>\n\n      {/* Floating Tactical Geolocation Popover Tooltip */}\n      {hoveredHotspot && (\n        <div\n          className=\"absolute z-20 pointer-events-none px-2.5 py-2 rounded-lg bg-slate-950/95 text-white border border-slate-800 shadow-xl backdrop-blur-sm text-[11px] font-sans flex flex-col gap-1 transition-all duration-150\"\n          style={{\n            left: `${Math.min(78, Math.max(22, (hoveredHotspot.x / 800) * 100))}%`,\n            top: `${Math.min(65, Math.max(12, (hoveredHotspot.y / 400) * 100 - 15))}%`,\n            transform: \'translate(-50%, -100%)\',\n          }}\n        >\n          <div className=\"flex items-center justify-between gap-3\">\n            <span className=\"font-bold text-slate-100\">{hoveredHotspot.city}</span>\n            <span\n              className={`px-1.5 py-0.2 rounded text-[9px] font-mono font-bold ${\n                hoveredHotspot.risk === \'CRITICAL\'\n                  ? \'bg-rose-500/20 text-rose-400 border border-rose-500/40\'\n                  : \'bg-amber-500/20 text-amber-400 border border-amber-500/40\'\n              }`}\n            >\n              {hoveredHotspot.risk}\n            </span>\n          </div>\n          <div className=\"flex items-center justify-between gap-3 font-mono text-[10px] text-slate-400 border-t border-slate-800/80 pt-1\">\n            <span>IP: {hoveredHotspot.ip}</span>\n            <span className=\"text-rose-400 font-bold\">{hoveredHotspot.threats} attacks</span>\n          </div>\n        </div>\n      )}\n\n      {/* Bottom Map Status Bar */}\n      <div className=\"px-3 py-1.5 bg-slate-100/70 border-t border-slate-200/70 flex items-center justify-between text-[10px] text-slate-500 font-mono\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse\" />\n          <span>8 LIVE ORIGIN NODES LOCATED</span>\n        </div>\n        <span className=\"text-slate-400\">EQUIDISTANT PROJECTION</span>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 147
    num_bytes: 6188
  }
}
