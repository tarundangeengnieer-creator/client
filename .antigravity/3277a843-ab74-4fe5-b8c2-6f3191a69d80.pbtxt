        lines {
          text: "  for (let i = 0; i < points.length - 1; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const p0 = points[i === 0 ? i : i - 1];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const p1 = points[i];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const p2 = points[i + 1];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const p3 = points[i + 2 < points.length ? i + 2 : i + 1];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cp1x = p1.x + (p2.x - p0.x) / 6;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cp1y = p1.y + (p2.y - p0.y) / 6;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
