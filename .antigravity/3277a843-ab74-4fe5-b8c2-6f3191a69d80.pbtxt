  view_file {
    absolute_path_uri: "file:///src/components/layout/AppShell.tsx"
    end_line: 84
    content: "import React, { useState, useEffect } from \'react\';\nimport { Sidebar } from \'./Sidebar.tsx\';\nimport { AppTopBar } from \'./AppTopBar.tsx\';\nimport { GlobalSearchModal } from \'./GlobalSearchModal.tsx\';\nimport { ToastContainer } from \'./ToastContainer.tsx\';\nimport { Modal } from \'../ui/Modal.tsx\';\n\ninterface AppShellProps {\n  children: React.ReactNode;\n}\n\nexport const AppShell: React.FC<AppShellProps> = ({ children }) => {\n  const [showShortcuts, setShowShortcuts] = useState(false);\n\n  // Global listener for \'?\' key to open keyboard shortcuts help\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'?\' && ![\'INPUT\', \'TEXTAREA\'].includes((e.target as HTMLElement)?.tagName)) {\n        e.preventDefault();\n        setShowShortcuts((prev) => !prev);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, []);\n\n  return (\n    <div className=\"h-screen w-screen flex bg-[#0b1329] overflow-hidden font-sans select-none antialiased\">\n      {/* Left Full-Height Dark Sidebar matching Image 1 */}\n      <Sidebar />\n\n      {/* Right Main Content Column */}\n      <div className=\"flex-1 flex flex-col min-w-0 h-full overflow-hidden bg-[#f4f7fb]\">\n        {/* Top Header Bar matching Image 1 and Image 2 */}\n        <AppTopBar />\n\n        {/* Scrollable View Area */}\n        <main className=\"flex-1 overflow-y-auto min-w-0 bg-[#f4f7fb] relative\">\n          {children}\n        </main>\n      </div>\n\n      {/* Modals and Floating Feedback Overlays */}\n      <GlobalSearchModal />\n      <ToastContainer />\n\n      {/* Keyboard Shortcuts Help Modal */}\n      <Modal\n        isOpen={showShortcuts}\n        onClose={() => setShowShortcuts(false)}\n        title=\"FORENSIC WORKSTATION KEYBOARD SHORTCUTS\"\n        description=\"High-velocity analyst navigation shortcuts\"\n        maxWidth=\"md\"\n      >\n        <div className=\"space-y-3 font-mono text-xs\">\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Global Search / Jump</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              Ctrl + K / \342\214\230K\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Toggle Shortcuts Guide</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              ?\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Navigate to Security Overview</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              G then O\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Navigate to Case Inboxes</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              G then I\n            </kbd>\n          </div>\n        </div>\n      </Modal>\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState, useEffect } from \'react\';\nimport { Sidebar } from \'./Sidebar.tsx\';\nimport { AppTopBar } from \'./AppTopBar.tsx\';\nimport { GlobalSearchModal } from \'./GlobalSearchModal.tsx\';\nimport { ToastContainer } from \'./ToastContainer.tsx\';\nimport { Modal } from \'../ui/Modal.tsx\';\n\ninterface AppShellProps {\n  children: React.ReactNode;\n}\n\nexport const AppShell: React.FC<AppShellProps> = ({ children }) => {\n  const [showShortcuts, setShowShortcuts] = useState(false);\n\n  // Global listener for \'?\' key to open keyboard shortcuts help\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'?\' && ![\'INPUT\', \'TEXTAREA\'].includes((e.target as HTMLElement)?.tagName)) {\n        e.preventDefault();\n        setShowShortcuts((prev) => !prev);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, []);\n\n  return (\n    <div className=\"h-screen w-screen flex bg-[#0b1329] overflow-hidden font-sans select-none antialiased\">\n      {/* Left Full-Height Dark Sidebar matching Image 1 */}\n      <Sidebar />\n\n      {/* Right Main Content Column */}\n      <div className=\"flex-1 flex flex-col min-w-0 h-full overflow-hidden bg-[#f4f7fb]\">\n        {/* Top Header Bar matching Image 1 and Image 2 */}\n        <AppTopBar />\n\n        {/* Scrollable View Area */}\n        <main className=\"flex-1 overflow-y-auto min-w-0 bg-[#f4f7fb] relative\">\n          {children}\n        </main>\n      </div>\n\n      {/* Modals and Floating Feedback Overlays */}\n      <GlobalSearchModal />\n      <ToastContainer />\n\n      {/* Keyboard Shortcuts Help Modal */}\n      <Modal\n        isOpen={showShortcuts}\n        onClose={() => setShowShortcuts(false)}\n        title=\"FORENSIC WORKSTATION KEYBOARD SHORTCUTS\"\n        description=\"High-velocity analyst navigation shortcuts\"\n        maxWidth=\"md\"\n      >\n        <div className=\"space-y-3 font-mono text-xs\">\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Global Search / Jump</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              Ctrl + K / \342\214\230K\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Toggle Shortcuts Guide</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              ?\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Navigate to Security Overview</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              G then O\n            </kbd>\n          </div>\n          <div className=\"flex items-center justify-between py-1.5 border-b border-slate-200\">\n            <span className=\"text-slate-700\">Navigate to Case Inboxes</span>\n            <kbd className=\"px-2 py-0.5 rounded bg-slate-100 border border-slate-300 text-blue-600\">\n              G then I\n            </kbd>\n          </div>\n        </div>\n      </Modal>\n    </div>\n  );\n};\n"
    num_lines: 85
    num_bytes: 3343
  }
}
