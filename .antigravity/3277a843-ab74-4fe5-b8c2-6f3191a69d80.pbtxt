    end_line: 139
    content: "import React, { useState } from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { casesStore } from \'../../stores/cases-store.ts\';\nimport {\n  Search,\n  Bell,\n  Building2,\n  ChevronDown,\n  CheckCircle2,\n  ChevronRight,\n  Shield,\n  Layers,\n  Menu,\n  Sun,\n  Moon,\n} from \'lucide-react\';\n\nexport const AppTopBar: React.FC = () => {\n  const ui = useUI();\n  const [showTenantMenu, setShowTenantMenu] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n\n  const isCaseDetail = ui.currentPath.startsWith(\'/case\');\n  const isInbox = ui.currentPath === \'/inbox\' || ui.currentPath === \'/cases\';\n  const isOverview = ui.currentPath === \'/\' || ui.currentPath === \'/overview\';\n\n  const activeCaseId = ui.activeCaseId || \'A2291\';\n\n  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = e.target.value;\n    casesStore.setSearchQuery(val);\n  };\n\n  return (\n    <header\n      id=\"app-topbar\"\n      className=\"bg-white dark:bg-[#0a0f1d] border-b border-slate-200/80 dark:border-slate-800/80 px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between select-none z-10 shrink-0 shadow-xs min-w-0 theme-transition\"\n    >\n      {/* Left: Dynamic Page Title / Breadcrumbs */}\n      <div className=\"flex items-center gap-2.5 sm:gap-3 min-w-0 mr-3\">\n        {/* Mobile menu toggle */}\n        <button\n          type=\"button\"\n          onClick={() => uiStore.toggleMobileSidebar()}\n          className=\"lg:hidden p-1.5 -ml-1 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors shrink-0 cursor-pointer\"\n          aria-label=\"Toggle navigation menu\"\n        >\n          <Menu className=\"w-5 h-5\" />\n        </button>\n\n        {isCaseDetail ? (\n          <div className=\"flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 min-w-0 truncate\">\n            <button\n              type=\"button\"\n              onClick={() => uiStore.navigate(\'/inbox\')}\n              className=\"hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer shrink-0\"\n            >\n              Inbox / Cases\n            </button>\n            <ChevronRight className=\"w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0\" />\n            <span className=\"font-semibold text-slate-900 dark:text-slate-100 truncate\">Case #{activeCaseId}</span>\n          </div>\n        ) : isInbox ? (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate\">Case Inbox</h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Real-time threat evaluation & operational triage queue</p>\n          </div>\n        ) : isOverview ? (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl lg:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate\">Security Overview</h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Email threat detection & forensic intelligence</p>\n          </div>\n        ) : (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight capitalize truncate\">\n              {ui.currentPath.replace(\'/\', \'\')}\n            </h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Forensic Workstation Module</p>\n          </div>\n        )}\n      </div>\n\n      {/* Right: Search, Theme Toggle, Notifications, Tenant, User, Operational Status */}\n      <div className=\"flex items-center gap-2 sm:gap-2.5 shrink-0\">\n        {/* Search Bar: Fluid and expands on large monitors while staying compact */}\n        <div className=\"relative hidden md:block\">\n          <Search className=\"w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"global-header-search\"\n            type=\"text\"\n            placeholder=\"Search cases, sender, domain, IP, URL or hash...\"\n            onChange={handleSearchChange}\n            onKeyDown={(e) => {\n              if (e.key === \'Enter\' && !isInbox) {\n                uiStore.navigate(\'/inbox\');\n              }\n            }}\n            className=\"w-48 lg:w-64 xl:w-80 2xl:w-96 pl-9 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-[#0e1627] hover:bg-slate-100/70 dark:hover:bg-[#131d33] focus:bg-white dark:focus:bg-[#0e1627] border border-slate-200 dark:border-slate-800 rounded-lg outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500\"\n          />\n        </div>\n\n        {/* Theme Toggle Button (Light / Dark) */}\n        <button\n          id=\"header-theme-toggle-btn\"\n          type=\"button\"\n          onClick={() => uiStore.toggleTheme()}\n          className=\"relative p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-all cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-800\"\n          title={ui.theme === \'dark\' ? \'Switch to Light Mode\' : \'Switch to Dark Mode\'}\n          aria-label=\"Toggle theme mode\"\n        >\n          {ui.theme === \'dark\' ? (\n            <Sun className=\"w-4 h-4 text-amber-400 hover:text-amber-300 transition-transform duration-200 hover:rotate-45\" />\n          ) : (\n            <Moon className=\"w-4 h-4 text-slate-600 hover:text-blue-600 transition-transform duration-200 hover:-rotate-12\" />\n          )}\n        </button>\n\n        {/* Notifications Bell */}\n        <div className=\"relative\">\n          <button\n            id=\"header-notifications-btn\"\n            type=\"button\"\n            onClick={() => setShowNotifications((prev) => !prev)}\n            className=\"relative p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors cursor-pointer\"\n            title=\"Notifications\"\n          >\n            <Bell className=\"w-4 h-4\" />\n            <span className=\"absolute top-1 right-1 w-4 h-4 bg-rose-500 text-white rounded-full text-[10px] font-bold flex items-center justify-center\">\n              1\n            </span>\n          </button>\n\n          {showNotifications && (\n            <div className=\"absolute right-0 top-full mt-1.5 w-80 bg-white dark:bg-[#0d1527] border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg p-3 z-30 text-xs\">\n              <div className=\"flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 font-semibold text-slate-800 dark:text-slate-200\">\n                <span>Recent Notifications</span>\n                <span className=\"text-[10px] text-blue-600 dark:text-blue-400 font-normal\">Mark all read</span>\n              </div>\n              <div className=\"py-2.5 space-y-2\">\n                <div className=\"p-2 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-100 dark:border-rose-900/40 text-slate-700 dark:text-slate-300\">"
    raw_content: "import React, { useState } from \'react\';\nimport { useUI, uiStore } from \'../../stores/ui-store.ts\';\nimport { casesStore } from \'../../stores/cases-store.ts\';\nimport {\n  Search,\n  Bell,\n  Building2,\n  ChevronDown,\n  CheckCircle2,\n  ChevronRight,\n  Shield,\n  Layers,\n  Menu,\n  Sun,\n  Moon,\n} from \'lucide-react\';\n\nexport const AppTopBar: React.FC = () => {\n  const ui = useUI();\n  const [showTenantMenu, setShowTenantMenu] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n\n  const isCaseDetail = ui.currentPath.startsWith(\'/case\');\n  const isInbox = ui.currentPath === \'/inbox\' || ui.currentPath === \'/cases\';\n  const isOverview = ui.currentPath === \'/\' || ui.currentPath === \'/overview\';\n\n  const activeCaseId = ui.activeCaseId || \'A2291\';\n\n  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = e.target.value;\n    casesStore.setSearchQuery(val);\n  };\n\n  return (\n    <header\n      id=\"app-topbar\"\n      className=\"bg-white dark:bg-[#0a0f1d] border-b border-slate-200/80 dark:border-slate-800/80 px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between select-none z-10 shrink-0 shadow-xs min-w-0 theme-transition\"\n    >\n      {/* Left: Dynamic Page Title / Breadcrumbs */}\n      <div className=\"flex items-center gap-2.5 sm:gap-3 min-w-0 mr-3\">\n        {/* Mobile menu toggle */}\n        <button\n          type=\"button\"\n          onClick={() => uiStore.toggleMobileSidebar()}\n          className=\"lg:hidden p-1.5 -ml-1 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors shrink-0 cursor-pointer\"\n          aria-label=\"Toggle navigation menu\"\n        >\n          <Menu className=\"w-5 h-5\" />\n        </button>\n\n        {isCaseDetail ? (\n          <div className=\"flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 min-w-0 truncate\">\n            <button\n              type=\"button\"\n              onClick={() => uiStore.navigate(\'/inbox\')}\n              className=\"hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer shrink-0\"\n            >\n              Inbox / Cases\n            </button>\n            <ChevronRight className=\"w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0\" />\n            <span className=\"font-semibold text-slate-900 dark:text-slate-100 truncate\">Case #{activeCaseId}</span>\n          </div>\n        ) : isInbox ? (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate\">Case Inbox</h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Real-time threat evaluation & operational triage queue</p>\n          </div>\n        ) : isOverview ? (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl lg:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate\">Security Overview</h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Email threat detection & forensic intelligence</p>\n          </div>\n        ) : (\n          <div className=\"min-w-0\">\n            <h1 className=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight capitalize truncate\">\n              {ui.currentPath.replace(\'/\', \'\')}\n            </h1>\n            <p className=\"text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate hidden sm:block\">Forensic Workstation Module</p>\n          </div>\n        )}\n      </div>\n\n      {/* Right: Search, Theme Toggle, Notifications, Tenant, User, Operational Status */}\n      <div className=\"flex items-center gap-2 sm:gap-2.5 shrink-0\">\n        {/* Search Bar: Fluid and expands on large monitors while staying compact */}\n        <div className=\"relative hidden md:block\">\n          <Search className=\"w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"global-header-search\"\n            type=\"text\"\n            placeholder=\"Search cases, sender, domain, IP, URL or hash...\"\n            onChange={handleSearchChange}\n            onKeyDown={(e) => {\n              if (e.key === \'Enter\' && !isInbox) {\n                uiStore.navigate(\'/inbox\');\n              }\n            }}\n            className=\"w-48 lg:w-64 xl:w-80 2xl:w-96 pl-9 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-[#0e1627] hover:bg-slate-100/70 dark:hover:bg-[#131d33] focus:bg-white dark:focus:bg-[#0e1627] border border-slate-200 dark:border-slate-800 rounded-lg outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500\"\n          />\n        </div>\n\n        {/* Theme Toggle Button (Light / Dark) */}\n        <button\n          id=\"header-theme-toggle-btn\"\n          type=\"button\"\n          onClick={() => uiStore.toggleTheme()}\n          className=\"relative p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-all cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-800\"\n          title={ui.theme === \'dark\' ? \'Switch to Light Mode\' : \'Switch to Dark Mode\'}\n          aria-label=\"Toggle theme mode\"\n        >\n          {ui.theme === \'dark\' ? (\n            <Sun className=\"w-4 h-4 text-amber-400 hover:text-amber-300 transition-transform duration-200 hover:rotate-45\" />\n          ) : (\n            <Moon className=\"w-4 h-4 text-slate-600 hover:text-blue-600 transition-transform duration-200 hover:-rotate-12\" />\n          )}\n        </button>\n\n        {/* Notifications Bell */}\n        <div className=\"relative\">\n          <button\n            id=\"header-notifications-btn\"\n            type=\"button\"\n            onClick={() => setShowNotifications((prev) => !prev)}\n            className=\"relative p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors cursor-pointer\"\n            title=\"Notifications\"\n          >\n            <Bell className=\"w-4 h-4\" />\n            <span className=\"absolute top-1 right-1 w-4 h-4 bg-rose-500 text-white rounded-full text-[10px] font-bold flex items-center justify-center\">\n              1\n            </span>\n          </button>\n\n          {showNotifications && (\n            <div className=\"absolute right-0 top-full mt-1.5 w-80 bg-white dark:bg-[#0d1527] border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg p-3 z-30 text-xs\">\n              <div className=\"flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 font-semibold text-slate-800 dark:text-slate-200\">\n                <span>Recent Notifications</span>\n                <span className=\"text-[10px] text-blue-600 dark:text-blue-400 font-normal\">Mark all read</span>\n              </div>\n              <div className=\"py-2.5 space-y-2\">\n                <div className=\"p-2 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-100 dark:border-rose-900/40 text-slate-700 dark:text-slate-300\">\n                  <div className=\"flex items-center justify-between font-semibold text-rose-700 dark:text-rose-400\">\n                    <span>High-Confidence Threat</span>\n                    <span className=\"text-[10px] text-slate-400 font-normal\">10:42 AM</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 dark:text-slate-300 mt-1\">\n                    Case #A2291 flagged for PayPal brand impersonation and Tor exit origin.\n                  </p>\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* CDGI SOC Switcher */}\n        <div className=\"relative\">\n          <button\n            id=\"header-tenant-switcher-btn\"\n            type=\"button\"\n            onClick={() => setShowTenantMenu((prev) => !prev)}\n            className=\"flex items-center gap-2 px-2.5 sm:px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0e1627] hover:bg-slate-50 dark:hover:bg-[#131e33] text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors shadow-2xs cursor-pointer\"\n          >\n            <Building2 className=\"w-3.5 h-3.5 text-slate-500 dark:text-slate-400\" />\n            <span className=\"hidden sm:inline\">CDGI SOC</span>\n            <ChevronDown className=\"w-3.5 h-3.5 text-slate-400\" />\n          </button>\n\n          {showTenantMenu && (\n            <div className=\"absolute right-0 top-full mt-1.5 w-56 bg-white dark:bg-[#0e1627] border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg p-1.5 z-30 text-xs\">\n              <div className=\"px-2.5 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n                Active Tenant\n              </div>\n              <button\n                type=\"button\"\n                className=\"w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-medium text-left\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <Building2 className=\"w-3.5 h-3.5\" />\n                  <span>CDGI SOC</span>\n                </div>\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowTenantMenu(false);\n                  uiStore.addToast(\'info\', \'Switched to Secondary SOC Partition\');\n                }}\n                className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-left transition-colors\"\n              >\n                <Shield className=\"w-3.5 h-3.5 text-slate-400\" />\n                <span>Enterprise Sandbox</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* User TD Avatar */}\n        <div\n          onClick={() => uiStore.navigate(\'/settings\')}\n          className=\"w-8 h-8 rounded-full bg-[#0b1329] dark:bg-blue-600 text-white flex items-center justify-center font-bold text-xs cursor-pointer shadow-xs hover:ring-2 hover:ring-blue-500/40 transition-all shrink-0\"\n          title=\"Tarun Dange (SOC Analyst)\"\n        >\n          TD\n        </div>\n\n        {/* Operational Status Badge Pill */}\n        <div className=\"hidden xl:flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/50 text-xs font-medium text-emerald-700 dark:text-emerald-400\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n          <span>All systems operational</span>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 215
    num_bytes: 11086
  }
}
