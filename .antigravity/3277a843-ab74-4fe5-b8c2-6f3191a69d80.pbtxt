        lines {
          text: "    const cp2x = p2.x - (p3.x - p1.x) / 6;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cp2y = p2.y - (p3.y - p1.y) / 6;"
