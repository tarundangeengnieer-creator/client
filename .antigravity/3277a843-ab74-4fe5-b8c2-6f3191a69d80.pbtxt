    instruction: "Add dark mode styling to Threat Overview Card and Live Activity Card in SecurityOverviewPage"
    replacement_infos {
      original_chunk {
        target_content: "      <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6 [&>*]:min-w-0\">\n        {/* Threat Overview Card */}\n        <div className=\"bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n              <div>\n                <div className=\"flex items-center justify-between pb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"p-1 rounded bg-blue-50 text-blue-600\">\n                      <Shield className=\"w-4 h-4\" />\n                    </span>\n                    <h3 className=\"font-bold text-slate-900 text-sm\">Threat Overview</h3>\n                  </div>\n\n                  {/* Minimal Dynamic Timeframe Switcher: 24h, 7d, 14d, 30d */}\n                  <div className=\"flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-[11px] font-semibold text-slate-600\">\n                    {([\'24h\', \'7d\', \'14d\', \'30d\'] as const).map((r) => (\n                      <button\n                        key={r}\n                        type=\"button\"\n                        onClick={() => setThreatPeriod(r)}\n                        className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${\n                          threatPeriod === r\n                            ? \'bg-white text-blue-600 shadow-2xs font-bold\'\n                            : \'hover:text-slate-900 text-slate-500\'\n                        }`}\n                      >\n                        {r.toUpperCase()}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Bars */}\n                <div className=\"space-y-3.5 mt-3\">\n                  {/* Malicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Malicious</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.malicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-rose-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.malicious.pct}%` }}\n                      >\n                        {activeThreats.malicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Suspicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Suspicious</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.suspicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-amber-400 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-slate-900 font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.suspicious.pct}%` }}\n                      >\n                        {activeThreats.suspicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Benign */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Benign</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.benign.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-emerald-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.benign.pct}%` }}\n                      >\n                        {activeThreats.benign.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Inconclusive */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700\">Inconclusive</span>\n                      <span className=\"font-bold text-slate-900 font-mono\">\n                        {activeThreats.inconclusive.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-slate-400 h-full rounded-full flex items-center justify-end pr-1 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${Math.max(4, activeThreats.inconclusive.pct)}%` }}\n                      >\n                        {activeThreats.inconclusive.pct}%\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Dynamic Risk Posture Banner */}\n              <div\n                className={`mt-5 p-3.5 rounded-xl border flex items-start gap-3 transition-colors duration-200 ${activeThreats.postureBg} ${activeThreats.postureBorder}`}\n              >\n                <AlertTriangle className={`w-5 h-5 shrink-0 mt-0.5 ${activeThreats.postureColor}`} />\n                <div>\n                  <div className=\"text-xs font-bold text-slate-900\">\n                    Risk posture:{\' \'}\n                    <span className={activeThreats.postureColor}>{activeThreats.posture}</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-700 mt-0.5 leading-snug\">\n                    {activeThreats.note}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n        {/* Dynamic Email Volume Trend Card */}\n        <DynamicEmailVolumeGraph />\n\n        {/* Live Investigation Activity Card */}\n        <div className=\"md:col-span-2 xl:col-span-1 bg-white rounded-xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between select-none\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"p-1 rounded bg-slate-100 text-slate-700\">\n                  <Radio className=\"w-4 h-4 text-blue-600\" />\n                </span>\n                <h3 className=\"font-bold text-slate-900 text-sm\">Live Investigation Activity</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => uiStore.navigate(\'/inbox\')}\n                className=\"text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer\"\n              >\n                <span>See all</span>\n                <ArrowRight className=\"w-3 h-3\" />\n              </button>\n            </div>\n\n            {/* Timeline */}\n            <div className=\"relative mt-4 pl-4 space-y-4 before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-200\">\n              {/* 10:42 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:42</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">New case ingested</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">Invoice Payment Update.eml</p>\n                </div>\n              </div>\n\n              {/* 10:37 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:37</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">URL analysis completed</p>\n                  <p className=\"text-[11px] text-rose-600 font-medium truncate\">1 malicious URL detected</p>\n                </div>\n              </div>\n\n              {/* 10:28 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:28</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">SPF check passed</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">paypal1-secure.com</p>\n                </div>\n              </div>\n\n              {/* 10:16 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:16</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">Attachment scanned</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">No malware detected</p>\n                </div>\n              </div>\n\n              {/* 10:03 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 w-10 shrink-0\">10:03</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 ring-4 ring-white shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800\">Case #A2287 closed</p>\n                  <p className=\"text-[11px] text-emerald-600 font-medium truncate\">Marked as Benign</p>\n                </div>\n              </div>\n            </div>\n          </div>"
        replacement_content: "      <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6 [&>*]:min-w-0\">\n        {/* Threat Overview Card */}\n        <div className=\"bg-white dark:bg-[#0c1322] rounded-xl p-5 border border-slate-200/80 dark:border-slate-800/80 shadow-xs flex flex-col justify-between select-none transition-colors\">\n              <div>\n                <div className=\"flex items-center justify-between pb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"p-1 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-sky-400\">\n                      <Shield className=\"w-4 h-4\" />\n                    </span>\n                    <h3 className=\"font-bold text-slate-900 dark:text-white text-sm\">Threat Overview</h3>\n                  </div>\n\n                  {/* Minimal Dynamic Timeframe Switcher: 24h, 7d, 14d, 30d */}\n                  <div className=\"flex items-center bg-slate-100 dark:bg-[#090e1a] p-0.5 rounded-lg border border-slate-200 dark:border-slate-800 text-[11px] font-semibold text-slate-600 dark:text-slate-300\">\n                    {([\'24h\', \'7d\', \'14d\', \'30d\'] as const).map((r) => (\n                      <button\n                        key={r}\n                        type=\"button\"\n                        onClick={() => setThreatPeriod(r)}\n                        className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${\n                          threatPeriod === r\n                            ? \'bg-white dark:bg-slate-800 text-blue-600 dark:text-sky-400 shadow-2xs font-bold\'\n                            : \'hover:text-slate-900 dark:hover:text-white text-slate-500 dark:text-slate-400\'\n                        }`}\n                      >\n                        {r.toUpperCase()}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Bars */}\n                <div className=\"space-y-3.5 mt-3\">\n                  {/* Malicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700 dark:text-slate-300\">Malicious</span>\n                      <span className=\"font-bold text-slate-900 dark:text-white font-mono\">\n                        {activeThreats.malicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 dark:bg-[#090e1a] rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-rose-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.malicious.pct}%` }}\n                      >\n                        {activeThreats.malicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Suspicious */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700 dark:text-slate-300\">Suspicious</span>\n                      <span className=\"font-bold text-slate-900 dark:text-white font-mono\">\n                        {activeThreats.suspicious.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 dark:bg-[#090e1a] rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-amber-400 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-slate-900 font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.suspicious.pct}%` }}\n                      >\n                        {activeThreats.suspicious.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Benign */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700 dark:text-slate-300\">Benign</span>\n                      <span className=\"font-bold text-slate-900 dark:text-white font-mono\">\n                        {activeThreats.benign.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 dark:bg-[#090e1a] rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-emerald-500 h-full rounded-full flex items-center justify-end pr-1.5 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${activeThreats.benign.pct}%` }}\n                      >\n                        {activeThreats.benign.pct}%\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Inconclusive */}\n                  <div>\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"font-medium text-slate-700 dark:text-slate-300\">Inconclusive</span>\n                      <span className=\"font-bold text-slate-900 dark:text-white font-mono\">\n                        {activeThreats.inconclusive.count}\n                      </span>\n                    </div>\n                    <div className=\"w-full h-3 bg-slate-100 dark:bg-[#090e1a] rounded-full overflow-hidden flex\">\n                      <div\n                        className=\"bg-slate-400 dark:bg-slate-600 h-full rounded-full flex items-center justify-end pr-1 text-[9px] text-white font-bold transition-all duration-300 ease-out\"\n                        style={{ width: `${Math.max(4, activeThreats.inconclusive.pct)}%` }}\n                      >\n                        {activeThreats.inconclusive.pct}%\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Dynamic Risk Posture Banner */}\n              <div\n                className={`mt-5 p-3.5 rounded-xl border flex items-start gap-3 transition-colors duration-200 ${activeThreats.postureBg} ${activeThreats.postureBorder} dark:bg-slate-900/60 dark:border-slate-800`}\n              >\n                <AlertTriangle className={`w-5 h-5 shrink-0 mt-0.5 ${activeThreats.postureColor}`} />\n                <div>\n                  <div className=\"text-xs font-bold text-slate-900 dark:text-white\">\n                    Risk posture:{\' \'}\n                    <span className={activeThreats.postureColor}>{activeThreats.posture}</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-700 dark:text-slate-300 mt-0.5 leading-snug\">\n                    {activeThreats.note}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n        {/* Dynamic Email Volume Trend Card */}\n        <DynamicEmailVolumeGraph />\n\n        {/* Live Investigation Activity Card */}\n        <div className=\"md:col-span-2 xl:col-span-1 bg-white dark:bg-[#0c1322] rounded-xl p-5 border border-slate-200/80 dark:border-slate-800/80 shadow-xs flex flex-col justify-between select-none transition-colors\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"p-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300\">\n                  <Radio className=\"w-4 h-4 text-blue-600 dark:text-sky-400\" />\n                </span>\n                <h3 className=\"font-bold text-slate-900 dark:text-white text-sm\">Live Investigation Activity</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => uiStore.navigate(\'/inbox\')}\n                className=\"text-xs font-semibold text-blue-600 dark:text-sky-400 hover:text-blue-700 dark:hover:text-sky-300 flex items-center gap-1 cursor-pointer\"\n              >\n                <span>See all</span>\n                <ArrowRight className=\"w-3 h-3\" />\n              </button>\n            </div>\n\n            {/* Timeline */}\n            <div className=\"relative mt-4 pl-4 space-y-4 before:absolute before:left-[19px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-200 dark:before:bg-slate-800\">\n              {/* 10:42 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 dark:text-slate-500 w-10 shrink-0\">10:42</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 dark:bg-slate-600 ring-4 ring-white dark:ring-[#0c1322] shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">New case ingested</p>\n                  <p className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate\">Invoice Payment Update.eml</p>\n                </div>\n              </div>\n\n              {/* 10:37 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 dark:text-slate-500 w-10 shrink-0\">10:37</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-4 ring-white dark:ring-[#0c1322] shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">URL analysis completed</p>\n                  <p className=\"text-[11px] text-rose-600 dark:text-rose-400 font-medium truncate\">1 malicious URL detected</p>\n                </div>\n              </div>\n\n              {/* 10:28 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 dark:text-slate-500 w-10 shrink-0\">10:28</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white dark:ring-[#0c1322] shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">SPF check passed</p>\n                  <p className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate\">paypal1-secure.com</p>\n                </div>\n              </div>\n\n              {/* 10:16 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 dark:text-slate-500 w-10 shrink-0\">10:16</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white dark:ring-[#0c1322] shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">Attachment scanned</p>\n                  <p className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate\">No malware detected</p>\n                </div>\n              </div>\n\n              {/* 10:03 */}\n              <div className=\"relative flex items-start gap-3\">\n                <span className=\"text-[11px] font-mono text-slate-400 dark:text-slate-500 w-10 shrink-0\">10:03</span>\n                <div className=\"w-2.5 h-2.5 rounded-full bg-slate-400 dark:bg-slate-600 ring-4 ring-white dark:ring-[#0c1322] shrink-0 mt-0.5\" />\n                <div className=\"min-w-0\">\n                  <p className=\"text-xs font-semibold text-slate-800 dark:text-sla