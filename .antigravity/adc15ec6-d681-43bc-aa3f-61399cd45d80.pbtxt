    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Global Threat Intelligence Map Types\n * Conforms to SOC telemetry data contracts and GeoJSON specifications.\n */\n\nexport type ThreatLevel = \'critical\' | \'high\' | \'medium\' | \'low\';\n\nexport interface ThreatLocationEvent {\n  id: string;\n  caseId: string;\n  ip: string;\n  lat: number;\n  lon: number;\n  country: string;\n  countryCode: string;\n  city: string;\n  region?: string;\n  asn?: string;\n  organization?: string;\n  riskScore: number;\n  threatLevel: ThreatLevel;\n  eventCount: number;\n  source: string;\n  lastSeen: string;\n  subject?: string;\n  attackVector?: string;\n  isTorExit?: boolean;\n  isVpn?: boolean;\n  // Destination coordinates for connection arcs\n  targetLat?: number;\n  targetLon?: number;\n  targetCity?: string;\n  targetCountry?: string;\n  targetRecipient?: string;\n}\n\nexport interface ThreatMapStats {\n  threatLocationsCount: number;\n  countriesAffectedCount: number;\n  maliciousIpsCount: number;\n  criticalEventsCount: number;\n}\n\nexport interface MapFilterState {\n  severity: \'ALL\' | \'CRITICAL\' | \'HIGH\' | \'MEDIUM\' | \'LOW\';\n  searchQuery: string;\n  showArcs: boolean;\n  selectedVector: string;\n}\n\nexport interface GeoJsonPointFeature {\n  type: \'Feature\';\n  geometry: {\n    type: \'Point\';\n    coordinates: [number, number]; // [lon, lat]\n  };\n  properties: {\n    id: string;\n    caseId: string;\n    ip: string;\n    country: string;\n    countryCode: string;\n    city: string;\n    asn: string;\n    organization: string;\n    riskScore: number;\n    threatLevel: ThreatLevel;\n    eventCount: number;\n    source: string;\n    lastSeen: string;\n    subject: string;\n    attackVector: string;\n    isTorExit: boolean;\n    hasTarget: boolean;\n  };\n}\n\nexport interface GeoJsonLineFeature {\n  type: \'Feature\';\n  geometry: {\n    type: \'LineString\';\n    coordinates: [number, number][]; // Array of [lon, lat] points forming the arc\n  };\n  properties: {\n    id: string;\n    caseId: string;\n    sourceIp: string;\n    sourceCity: string;\n    sourceCountry: string;\n    targetCity: string;\n    targetCountry: string;\n    threatLevel: ThreatLevel;\n    riskScore: number;\n    attackVector: string;\n  };\n}\n\nexport interface ThreatGeoJsonData {\n  points: {\n    type: \'FeatureCollection\';\n    features: GeoJsonPointFeature[];\n  };\n  arcs: {\n    type: \'FeatureCollection\';\n    features: GeoJsonLineFeature[];\n  };\n}\n"
    }
