  file_change {
    absolute_path_uri: "file:///src/features/dashboard/threat-map/GlobalThreatMap.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Global Threat Intelligence Interactive Map\n * Native SOC MapLibre GL visualization with cluster analysis, attack vectors, and real-time telemetry.\n */\n\nimport React, { useEffect, useRef, useState, useMemo } from \'react\';\nimport maplibregl from \'maplibre-gl\';\nimport \'maplibre-gl/dist/maplibre-gl.css\';\nimport { useCasesStore } from \'../../../stores/cases-store.ts\';\nimport { ThreatLocationEvent, MapFilterState } from \'./types.ts\';\nimport {\n  adaptCasesToThreatEvents,\n  threatEventsToGeoJson,\n  calculateThreatStats,\n} from \'./mapDataAdapter.ts\';\nimport { getMapStyleUrl, FALLBACK_DARK_STYLE, setupThreatMapLayers } from \'./mapStyles.ts\';\nimport { ThreatPopup } from \'./ThreatPopup.tsx\';\nimport { MapLegend } from \'./MapLegend.tsx\';\nimport { MapControls } from \'./MapControls.tsx\';\nimport { ThreatMapStats } from \'./ThreatMapStats.tsx\';\nimport {\n  Globe,\n  Filter,\n  Search,\n  AlertTriangle,\n  RefreshCw,\n  SlidersHorizontal,\n  Layers,\n  Activity,\n  ShieldCheck,\n} from \'lucide-react\';\n\nexport const GlobalThreatMap: React.FC = () => {\n  const cases = useCasesStore((state) => state.cases);\n  const investigations = useCasesStore((state) => state.investigations);\n\n  // Container & MapLibre instance refs\n  const mapContainerRef = useRef<HTMLDivElement>(null);\n  const mapRef = useRef<maplibregl.Map | null>(null);\n\n  // State\n  const [isMapReady, setIsMapReady] = useState(false);\n  const [mapError, setMapError] = useState<string | null>(null);\n  const [selectedThreat, setSelectedThreat] = useState<ThreatLocationEvent | null>(null);\n  const [isFullscreen, setIsFullscreen] = useState(false);\n\n  // Filter state\n  const [filterState, setFilterState] = useState<MapFilterState>({\n    severity: \'ALL\',\n    searchQuery: \'\',\n    showArcs: true,\n    selectedVector: \'ALL\',\n  });\n\n  // 1. Adapt store cases & investigations into normalized threat events\n  const allEvents = useMemo(() => {\n    return adaptCasesToThreatEvents(cases, investigations);\n  }, [cases, investigations]);\n\n  // 2. Filter events based on analyst selection\n  const filteredEvents = useMemo(() => {\n    return allEvents.filter((evt) => {\n      // Severity filter\n      if (filterState.severity !== \'ALL\') {\n        if (evt.threatLevel.toUpperCase() !== filterState.severity) {\n          return false;\n        }\n      }\n\n      // Vector filter\n      if (filterState.selectedVector !== \'ALL\') {\n        if (filterState.selectedVector === \'TOR\' && !evt.isTorExit) return false;\n        if (filterState.selectedVector === \'MALWARE\' && !evt.attackVector?.toLowerCase().includes(\'malware\')) return false;\n        if (filterState.selectedVector === \'PHISH\' && !evt.attackVector?.toLowerCase().includes(\'phishing\') && !evt.attackVector?.toLowerCase().includes(\'credential\')) return false;\n      }\n\n      // Search query\n      if (filterState.searchQuery.trim()) {\n        const query = filterState.searchQuery.toLowerCase().trim();\n        const matchesIp = evt.ip.toLowerCase().includes(query);\n        const matchesCity = evt.city.toLowerCase().includes(query);\n        const matchesCountry = evt.country.toLowerCase().includes(query);\n        const matchesAsn = (evt.asn || \'\').toLowerCase().includes(query);\n        const matchesCase = evt.caseId.toLowerCase().includes(query);\n        const matchesSubject = (evt.subject || \'\').toLowerCase().includes(query);\n\n        if (!matchesIp && !matchesCity && !matchesCountry && !matchesAsn && !matchesCase && !matchesSubject) {\n          return false;\n        }\n      }\n\n      return true;\n    });\n  }, [allEvents, filterState]);\n\n  // 3. Convert filtered events into GeoJSON\n  const geoJsonData = useMemo(() => {\n    return threatEventsToGeoJson(filteredEvents);\n  }, [filteredEvents]);\n\n  // 4. Calculate live telemetry statistics\n  const summaryStats = useMemo(() => {\n    return calculateThreatStats(filteredEvents);\n  }, [filteredEvents]);\n\n  // Keep a ref to the latest filtered events for map click handlers\n  const filteredEventsRef = useRef(filteredEvents);\n  filteredEventsRef.current = filteredEvents;\n\n  // Initialize MapLibre GL Map\n  useEffect(() => {\n    if (!mapContainerRef.current || mapRef.current) return;\n\n    let mapInstance: maplibregl.Map | null = null;\n\n    try {\n      const styleUrl = getMapStyleUrl();\n\n      mapInstance = new maplibregl.Map({\n        container: mapContainerRef.current,\n        style: styleUrl,\n        center: [15, 25], // Centered globally across Europe/Asia/Africa\n        zoom: 1.6,\n        minZoom: 1,\n        maxZoom: 16,\n        pitch: 0,\n        bearing: 0,\n        attributionControl: false,\n      });\n\n      // Handle map load errors gracefully with fallback style\n      mapInstance.on(\'error\', (e) => {\n        // If external style network fails, try fallback dark style once\n        if (e && e.error && mapInstance && !mapInstance.isStyleLoaded()) {\n          try {\n            mapInstance.setStyle(FALLBACK_DARK_STYLE);\n          } catch (styleErr) {\n            setMapError(\'Failed to load map vector tiles.\');\n          }\n        }\n      });\n\n      mapInstance.on(\'load\', () => {\n        if (!mapInstance) return;\n        try {\n          setupThreatMapLayers(mapInstance, geoJsonData);\n          setIsMapReady(true);\n        } catch (err) {\n          console.error(\'Error adding threat map layers:\', err);\n        }\n      });\n\n      // Cluster click: Zoom in smoothly\n      mapInstance.on(\'click\', \'threat-clusters\', (e) => {\n        if (!mapInstance) return;\n        const features = mapInstance.queryRenderedFeatures(e.point, {\n          layers: [\'threat-clusters\'],\n        });\n        if (!features || !features[0]) return;\n\n        const clusterId = features[0].properties?.cluster_id;\n        const pointSource = mapInstance.getSource(\'threat-points\') as maplibregl.GeoJSONSource;\n\n        if (pointSource && typeof pointSource.getClusterExpansionZoom === \'function\') {\n          pointSource.getClusterExpansionZoom(clusterId, (err, zoom) => {\n            if (err || zoom === null || zoom === undefined || !mapInstance) return;\n            const geom = features[0].geometry;\n            if (geom.type === \'Point\') {\n              mapInstance.easeTo({\n                center: geom.coordinates as [number, number],\n                zoom: Math.min(zoom, 14),\n                duration: 600,\n              });\n            }\n          });\n        }\n      });\n\n      // Marker click: Select threat event and show popup\n      mapInstance.on(\'click\', \'threat-point-core\', (e) => {\n        if (!e.features || !e.features[0]) return;\n        const featureProps = e.features[0].properties;\n        const clickedId = featureProps?.id;\n        const match = filteredEventsRef.current.find((ev) => ev.id === clickedId);\n        if (match) {\n          setSelectedThreat(match);\n        }\n      });\n\n      // Glow layer click: Also trigger selection\n      mapInstance.on(\'click\', \'threat-point-glow\', (e) => {\n        if (!e.features || !e.features[0]) return;\n        const featureProps = e.features[0].properties;\n        const clickedId = featureProps?.id;\n        const match = filteredEventsRef.current.find((ev) => ev.id === clickedId);\n        if (match) {\n          setSelectedThreat(match);\n        }\n      });\n\n      // Hover cursor changes\n      mapInstance.on(\'mouseenter\', \'threat-clusters\', () => {\n        if (mapInstance) mapInstance.getCanvas().style.cursor = \'pointer\';\n      });\n      mapInstance.on(\'mouseleave\', \'threat-clusters\', () => {\n        if (mapInstance) mapInstance.getCanvas().style.cursor = \'\';\n      });\n      mapInstance.on(\'mouseenter\', \'threat-point-core\', () => {\n        if (mapInstance) mapInstance.getCanvas().style.cursor = \'pointer\';\n      });\n      mapInstance.on(\'mouseleave\', \'threat-point-core\', () => {\n        if (mapInstance) mapInstance.getCanvas().style.cursor = \'\';\n      });\n\n      mapRef.current = mapInstance;\n    } catch (err: unknown) {\n      console.error(\'MapLibre GL initialization failure:\', err);\n      setMapError(\'Unable to initialize WebGL map canvas.\');\n    }\n\n    return () => {\n      if (mapRef.current) {\n        mapRef.current.remove();\n        mapRef.current = null;\n      }\n    };\n  }, []);\n\n  // Update GeoJSON source data when filters or cases change\n  useEffect(() => {\n    if (!mapRef.current || !isMapReady) return;\n\n    try {\n      const pointSource = mapRef.current.getSource(\'threat-points\') as maplibregl.GeoJSONSource | undefined;\n      if (pointSource && typeof pointSource.setData === \'function\') {\n        pointSource.setData(geoJsonData.points);\n      }\n\n      const arcSource = mapRef.current.getSource(\'threat-arcs\') as maplibregl.GeoJSONSource | undefined;\n      if (arcSource && typeof arcSource.setData === \'function\') {\n        arcSource.setData(geoJsonData.arcs);\n      }\n\n      // Update arc layer visibility\n      const visibility = filterState.showArcs ? \'visible\' : \'none\';\n      if (mapRef.current.getLayer(\'threat-arcs-line\')) {\n        mapRef.current.setLayoutProperty(\'threat-arcs-line\', \'visibility\', visibility);\n      }\n      if (mapRef.current.getLayer(\'threat-arcs-glow\')) {\n        mapRef.current.setLayoutProperty(\'threat-arcs-glow\', \'visibility\', visibility);\n      }\n    } catch (err) {\n      console.warn(\'Could not update map sources:\', err);\n    }\n  }, [geoJsonData, isMapReady, filterState.showArcs]);\n\n  // Handle ResizeObserver to keep canvas sharp on resize/fullscreen\n  useEffect(() => {\n    if (!mapContainerRef.current) return;\n    const observer = new ResizeObserver(() => {\n      if (mapRef.current) {\n        mapRef.current.resize();\n      }\n    });\n    observer.observe(mapContainerRef.current);\n    return () => observer.disconnect();\n  }, []);\n\n  // Control Actions\n  const handleZoomIn = () => {\n    if (mapRef.current) mapRef.current.zoomIn({ duration: 300 });\n  };\n\n  const handleZoomOut = () => {\n    if (mapRef.current) mapRef.current.zoomOut({ duration: 300 });\n  };\n\n  const handleResetView = () => {\n    if (mapRef.current) {\n      mapRef.current.flyTo({\n        center: [15, 25],\n        zoom: 1.6,\n        pitch: 0,\n        bearing: 0,\n        duration: 800,\n      });\n      setSelectedThreat(null);\n    }\n  };\n\n  const handleToggleFullscreen = () => {\n    setIsFullscreen((prev) => !prev);\n    setTimeout(() => {\n      if (mapRef.current) mapRef.current.resize();\n    }, 150);\n  };\n\n  const handleToggleArcs = () => {\n    setFilterState((prev) => ({ ...prev, showArcs: !prev.showArcs }));\n  };\n\n  return (\n    <div\n      id=\"global-threat-intelligence-section\"\n      className={`relative bg-[#0b1329] rounded-2xl border border-slate-800 shadow-xl overflow-hidden transition-all duration-300 ${\n        isFullscreen ? \'fixed inset-4 z-50 rounded-xl shadow-2xl flex flex-col\' : \'w-full space-y-4 p-5\'\n      }`}\n    >\n      {/* 1. Header & Live Indicator */}\n      <div className={`flex flex-wrap items-center justify-between gap-3 ${isFullscreen ? \'p-4 border-b border-slate-800 bg-[#0b1329]\' : \'\'}`}>\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-blue-600/20 border border-blue-500/30 text-blue-400 flex items-center justify-center\">\n            <Globe className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"text-base font-bold text-white tracking-tight\">\n                Global Threat Intelligence\n              </h2>\n              <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-600/40 text-emerald-400 text-[10px] font-bold\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n                LIVE SOC TELEMETRY\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              Geographic distribution of malicious origin relays, Tor exit nodes, and cross-border attack vectors\n            </p>\n          </div>\n        </div>\n\n        {/* Severity filter chips */}\n        <div className=\"flex flex-wrap items-center gap-1.5 bg-slate-900/80 p-1 rounded-xl border border-slate-800\">\n          {([\'ALL\', \'CRITICAL\', \'HIGH\', \'MEDIUM\', \'LOW\'] as const).map((sev) => {\n            const isActive = filterState.severity === sev;\n            return (\n              <button\n                key={sev}\n                type=\"button\"\n                onClick={() => setFilterState((prev) => ({ ...prev, severity: sev }))}\n                className={`px-2.5 py-1 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                  isActive\n                    ? sev === \'CRITICAL\'\n                      ? \'bg-rose-600 text-white shadow-sm\'\n                      : sev === \'HIGH\'\n                      ? \'bg-orange-600 text-white shadow-sm\'\n                      : sev === \'MEDIUM\'\n                      ? \'bg-amber-600 text-white shadow-sm\'\n                      : sev === \'LOW\'\n                      ? \'bg-sky-600 text-white shadow-sm\'\n                      : \'bg-blue-600 text-white shadow-sm\'\n                    : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                }`}\n              >\n                {sev === \'ALL\' ? \'All Severities\' : sev.charAt(0) + sev.slice(1).toLowerCase()}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. Telemetry Summary Metrics Bar */}\n      {!isFullscreen && <ThreatMapStats stats={summaryStats} />}\n\n      {/* 3. Search & Attack Vector Filter Controls */}\n      <div className={`flex flex-wrap items-center justify-between gap-2.5 ${isFullscreen ? \'px-4 py-2 bg-slate-900/40 border-b border-slate-800/80\' : \'\'}`}>\n        {/* Search Input */}\n        <div className=\"relative flex-1 min-w-[220px] max-w-md\">\n          <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={filterState.searchQuery}\n            onChange={(e) => setFilterState((prev) => ({ ...prev, searchQuery: e.target.value }))}\n            placeholder=\"Search by IP, Country, City, ASN, or Case ID...\"\n            className=\"w-full bg-slate-900/90 text-slate-200 text-xs pl-8 pr-3 py-1.5 rounded-lg border border-slate-800 focus:outline-hidden focus:border-blue-500 placeholder:text-slate-500\"\n          />\n          {filterState.searchQuery && (\n            <button\n              type=\"button\"\n              onClick={() => setFilterState((prev) => ({ ...prev, searchQuery: \'\' }))}\n              className=\"absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 hover:text-white\"\n            >\n              Clear\n            </button>\n          )}\n        </div>\n\n        {/* Vector Chips */}\n        <div className=\"flex items-center gap-1.5 text-xs text-slate-400\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-500 mr-1\">Vector:</span>\n          {[\n            { id: \'ALL\', label: \'All Vectors\' },\n            { id: \'TOR\', label: \'Tor Exit\' },\n            { id: \'PHISH\', label: \'Phishing\' },\n            { id: \'MALWARE\', label: \'Malware\' },\n          ].map((v) => (\n            <button\n              key={v.id}\n              type=\"button\"\n              onClick={() => setFilterState((prev) => ({ ...prev, selectedVector: v.id }))}\n              className={`px-2 py-1 rounded-md text-[11px] font-medium transition-colors cursor-pointer ${\n                filterState.selectedVector === v.id\n                  ? \'bg-slate-800 text-white font-semibold border border-slate-700\'\n                  : \'text-slate-400 hover:text-white hover:bg-slate-900\'\n              }`}\n            >\n              {v.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* 4. Map Canvas Container */}\n      <div\n        className={`relative w-full rounded-xl overflow-hidden border border-slate-800/90 bg-[#080d1a] ${\n          isFullscreen ? \'flex-1 min-h-0\' : \'h-[520px] sm:h-[560px]\'\n        }`}\n      >\n        {/* The MapLibre element */}\n        <div ref={mapContainerRef} className=\"w-full h-full\" />\n\n        {/* Loading overlay */}\n        {!isMapReady && !mapError && (\n          <div className=\"absolute inset-0 bg-[#0b1329]/80 backdrop-blur-xs flex flex-col items-center justify-center gap-3 z-20\">\n            <RefreshCw className=\"w-7 h-7 text-blue-400 animate-spin\" />\n            <div className=\"text-center space-y-1\">\n              <p className=\"text-xs font-semibold text-white\">Rendering Global Threat Intelligence Grid...</p>\n              <p className=\"text-[11px] text-slate-400\">Loading vector topography and RFC 822 ingress telemetry</p>\n            </div>\n          </div>\n        )}\n\n        {/* Error Fallback */}\n        {mapError && (\n          <div className=\"absolute inset-0 bg-[#0b1329]/95 flex flex-col items-center justify-center p-6 text-center z-20\">\n            <AlertTriangle className=\"w-8 h-8 text-amber-400 mb-2\" />\n            <h4 className=\"text-sm font-bold text-white mb-1\">Map Visualization Notice</h4>\n            <p className=\"text-xs text-slate-400 max-w-sm mb-4\">\n              {mapError} ASHielder forensic records remain active and secure.\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => {\n                setMapError(null);\n                setIsMapReady(false);\n                if (mapRef.current) {\n                  mapRef.current.setStyle(FALLBACK_DARK_STYLE);\n                }\n              }}\n              className=\"px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium cursor-pointer\"\n            >\n              Reload High-Contrast Basemap\n            </button>\n          </div>\n        )}\n\n        {/* Empty filter results state */}\n        {isMapReady && filteredEvents.length === 0 && (\n          <div className=\"absolute top-6 left-1/2 -translate-x-1/2 bg-[#0b1329]/90 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-300 shadow-xl flex items-center gap-2.5 z-20 pointer-events-auto\">\n            <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n            <span>No geolocation data available matching current filter.</span>\n            <button\n              type=\"button\"\n              onClick={() =>\n                setFilterState({\n                  severity: \'ALL\',\n                  searchQuery: \'\',\n                  showArcs: true,\n                  selectedVector: \'ALL\',\n                })\n              }\n              className=\"text-blue-400 hover:text-blue-300 font-semibold underline text-xs ml-1 cursor-pointer\"\n            >\n              Reset Filters\n            </button>\n          </div>\n        )}\n\n        {/* Controls Overlay (Top Right) */}\n        <div className=\"absolute top-4 right-4 z-20\">\n          <MapControls\n            onZoomIn={handleZoomIn}\n            onZoomOut={handleZoomOut}\n            onResetView={handleResetView}\n            onToggleFullscreen={handleToggleFullscreen}\n            isFullscreen={isFullscreen}\n            showArcs={filterState.showArcs}\n            onToggleArcs={handleToggleArcs}\n          />\n        </div>\n\n        {/* Legend Overlay (Bottom Left) */}\n        <div className=\"absolute bottom-4 left-4 z-20\">\n          <MapLegend />\n        </div>\n\n        {/* Active Threat Details Card / Popup */}\n        {selectedThreat && (\n          <ThreatPopup threat={selectedThreat} onClose={() => setSelectedThreat(null)} />\n        )}\n      </div>\n    </div>\n  );\n};\n"
