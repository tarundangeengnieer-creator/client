  file_change {
    absolute_path_uri: "file:///src/features/dashboard/threat-map/mapStyles.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Threat Map Styles & Layer Configurations\n * Uses dark cybersecurity SOC aesthetics.\n * Subtly renders geographic boundaries, highlighting threats with high-contrast tokens.\n */\n\nimport type { StyleSpecification } from \'maplibre-gl\';\n\nexport const THREAT_COLORS = {\n  critical: \'#f43f5e\', // Rose-500\n  high: \'#f97316\',     // Orange-500\n  medium: \'#eab308\',   // Amber-500\n  low: \'#38bdf8\',      // Sky-400\n  clusterLow: \'#3b82f6\', // Blue-500\n  clusterMed: \'#f59e0b\', // Amber-500\n  clusterHigh: \'#f43f5e\',// Rose-500\n  arcStroke: \'#38bdf8\',\n  darkOcean: \'#0b1329\',\n  darkLand: \'#131d36\',\n  boundaryStroke: \'#1e293b\',\n} as const;\n\n/**\n * Determines the vector tile style URL based on environment variables or defaults to Carto Dark Matter.\n */\nexport function getMapStyleUrl(): string {\n  // 1. Custom explicit style URL\n  const customUrl = import.meta.env.VITE_MAP_STYLE_URL;\n  if (customUrl && typeof customUrl === \'string\' && customUrl.trim().length > 0) {\n    return customUrl.trim();\n  }\n\n  // 2. MapTiler provider with API key\n  const maptilerKey = import.meta.env.VITE_MAPTILER_API_KEY;\n  if (maptilerKey && typeof maptilerKey === \'string\' && maptilerKey.trim().length > 0) {\n    return `https://api.maptiler.com/maps/dataviz-dark/style.json?key=${maptilerKey.trim()}`;\n  }\n\n  // 3. Default production dark vector style (Carto Dark Matter GL)\n  // Free, high-performance, dark SOC standard with subtle geography and visible borders\n  return \'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json\';\n}\n\n/**\n * Self-contained fallback style specification used if remote style fails to load.\n */\nexport const FALLBACK_DARK_STYLE: StyleSpecification = {\n  version: 8,\n  name: \'ASHielder-Cyber-Dark-Fallback\',\n  sources: {\n    \'carto-dark-raster\': {\n      type: \'raster\',\n      tiles: [\n        \'https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png\',\n        \'https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png\',\n        \'https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png\',\n      ],\n      tileSize: 256,\n      attribution: \'&copy; <a href=\"https://carto.com/\">CARTO</a>\',\n    },\n  },\n  layers: [\n    {\n      id: \'background\',\n      type: \'background\',\n      paint: {\n        \'background-color\': \'#0b1329\',\n      },\n    },\n    {\n      id: \'carto-tiles\',\n      type: \'raster\',\n      source: \'carto-dark-raster\',\n      minzoom: 0,\n      maxzoom: 19,\n      paint: {\n        \'raster-opacity\': 0.88,\n      },\n    },\n  ],\n};\n\n/**\n * Adds GeoJSON source and MapLibre layers for clusters, threat markers, and connection arcs.\n */\nexport function setupThreatMapLayers(\n  map: import(\'maplibre-gl\').Map,\n  threatData: import(\'./types.ts\').ThreatGeoJsonData\n) {\n  // 1. Add/Update Sources\n  if (!map.getSource(\'threat-arcs\')) {\n    map.addSource(\'threat-arcs\', {\n      type: \'geojson\',\n      data: threatData.arcs,\n    });\n  }\n\n  if (!map.getSource(\'threat-points\')) {\n    map.addSource(\'threat-points\', {\n      type: \'geojson\',\n      data: threatData.points,\n      cluster: true,\n      clusterMaxZoom: 12,\n      clusterRadius: 45,\n    });\n  }\n\n  // 2. Attack Connection Arcs Layer\n  if (!map.getLayer(\'threat-arcs-glow\')) {\n    map.addLayer({\n      id: \'threat-arcs-glow\',\n      type: \'line\',\n      source: \'threat-arcs\',\n      layout: {\n        \'line-cap\': \'round\',\n        \'line-join\': \'round\',\n      },\n      paint: {\n        \'line-color\': [\n          \'match\',\n          [\'get\', \'threatLevel\'],\n          \'critical\',\n          \'#f43f5e\',\n          \'high\',\n          \'#f97316\',\n          \'medium\',\n          \'#eab308\',\n          \'low\',\n          \'#38bdf8\',\n          \'#38bdf8\',\n        ],\n        \'line-width\': 3.5,\n        \'line-opacity\': 0.2,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'threat-arcs-line\')) {\n    map.addLayer({\n      id: \'threat-arcs-line\',\n      type: \'line\',\n      source: \'threat-arcs\',\n      layout: {\n        \'line-cap\': \'round\',\n        \'line-join\': \'round\',\n      },\n      paint: {\n        \'line-color\': [\n          \'match\',\n          [\'get\', \'threatLevel\'],\n          \'critical\',\n          \'#f43f5e\',\n          \'high\',\n          \'#f97316\',\n          \'medium\',\n          \'#eab308\',\n          \'low\',\n          \'#38bdf8\',\n          \'#38bdf8\',\n        ],\n        \'line-width\': 1.6,\n        \'line-opacity\': 0.8,\n        \'line-dasharray\': [3, 2],\n      },\n    });\n  }\n\n  // 3. Clustered Markers Layers\n  if (!map.getLayer(\'threat-clusters\')) {\n    map.addLayer({\n      id: \'threat-clusters\',\n      type: \'circle\',\n      source: \'threat-points\',\n      filter: [\'has\', \'point_count\'],\n      paint: {\n        \'circle-color\': [\n          \'step\',\n          [\'get\', \'point_count\'],\n          THREAT_COLORS.clusterLow, // < 5: Blue\n          5,\n          THREAT_COLORS.clusterMed, // 5 - 14: Amber\n          15,\n          THREAT_COLORS.clusterHigh, // >= 15: Rose\n        ],\n        \'circle-radius\': [\n          \'step\',\n          [\'get\', \'point_count\'],\n          16,\n          5,\n          20,\n          15,\n          26,\n        ],\n        \'circle-stroke-width\': 2.5,\n        \'circle-stroke-color\': \'#0b1329\',\n        \'circle-opacity\': 0.9,\n      },\n    });\n  }\n\n  if (!map.getLayer(\'threat-cluster-count\')) {\n    map.addLayer({\n      id: \'threat-cluster-count\',\n      type: \'symbol\',\n      source: \'threat-points\',\n      filter: [\'has\', \'point_count\'],\n      layout: {\n        \'text-field\': \'{point_count_abbreviated}\',\n        \'text-size\': 11,\n      },\n      paint: {\n        \'text-color\': \'#ffffff\',\n      },\n    });\n  }\n\n  // 4. Unclustered Threat Markers: Outer Glow\n  if (!map.getLayer(\'threat-point-glow\')) {\n    map.addLayer({\n      id: \'threat-point-glow\',\n      type: \'circle\',\n      source: \'threat-points\',\n      filter: [\'!\', [\'has\', \'point_count\']],\n      paint: {\n        \'circle-color\': [\n          \'match\',\n          [\'get\', \'threatLevel\'],\n          \'critical\',\n          \'#f43f5e\',\n          \'high\',\n          \'#f97316\',\n          \'medium\',\n          \'#eab308\',\n          \'low\',\n          \'#38bdf8\',\n          \'#94a3b8\',\n        ],\n        \'circle-radius\': [\n          \'interpolate\',\n          [\'linear\'],\n          [\'get\', \'riskScore\'],\n          0,\n          12,\n          50,\n          15,\n          100,\n          20,\n        ],\n        \'circle-opacity\': 0.22,\n        \'circle-stroke-width\': 1,\n        \'circle-stroke-color\': [\n          \'match\',\n          [\'get\', \'threatLevel\'],\n          \'critical\',\n          \'#fda4af\',\n          \'high\',\n          \'#fed7aa\',\n          \'medium\',\n          \'#fef08a\',\n          \'low\',\n          \'#bae6fd\',\n          \'#cbd5e1\',\n        ],\n        \'circle-stroke-opacity\': 0.45,\n      },\n    });\n  }\n\n  // 5. Unclustered Threat Markers: Inner Core\n  if (!map.getLayer(\'threat-point-core\')) {\n    map.addLayer({\n      id: \'threat-point-core\',\n      type: \'circle\',\n      source: \'threat-points\',\n      filter: [\'!\', [\'has\', \'point_count\']],\n      paint: {\n        \'circle-color\': [\n          \'match\',\n          [\'get\', \'threatLevel\'],\n          \'critical\',\n          \'#f43f5e\',\n          \'high\',\n          \'#f97316\',\n          \'medium\',\n          \'#eab308\',\n          \'low\',\n          \'#38bdf8\',\n          \'#94a3b8\',\n        ],\n        \'circle-radius\': [\n          \'interpolate\',\n          [\'linear\'],\n          [\'get\', \'riskScore\'],\n          0,\n          5,\n          50,\n          7,\n          100,\n          9,\n        ],\n        \'circle-stroke-width\': 2,\n        \'circle-stroke-color\': \'#0b1329\',\n        \'circle-opacity\': 1,\n      },\n    });\n  }\n}\n"
    }
