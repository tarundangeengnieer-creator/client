    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Threat Map Summary Telemetry Stats\n * Highlights active Threat Locations, Countries Affected, Malicious IPs, and Critical Events.\n */\n\nimport React from \'react\';\nimport { ThreatMapStats as StatsData } from \'./types.ts\';\nimport { MapPin, Globe2, ShieldAlert, AlertOctagon } from \'lucide-react\';\n\ninterface ThreatMapStatsProps {\n  stats: StatsData;\n}\n\nexport const ThreatMapStats: React.FC<ThreatMapStatsProps> = ({ stats }) => {\n  return (\n    <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-3\">\n      {/* 1. Threat Locations */}\n      <div className=\"bg-[#0b1329]/90 border border-slate-800/80 rounded-xl p-3.5 flex items-center gap-3 shadow-sm\">\n        <div className=\"w-9 h-9 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0\">\n          <MapPin className=\"w-4 h-4\" />\n        </div>\n        <div className=\"min-w-0\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate\">\n            Threat Locations\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-xl font-bold font-mono text-white tracking-tight\">\n              {stats.threatLocationsCount}\n            </span>\n            <span className=\"text-[10px] text-slate-500\">active nodes</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Countries Affected */}\n      <div className=\"bg-[#0b1329]/90 border border-slate-800/80 rounded-xl p-3.5 flex items-center gap-3 shadow-sm\">\n        <div className=\"w-9 h-9 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center shrink-0\">\n          <Globe2 className=\"w-4 h-4\" />\n        </div>\n        <div className=\"min-w-0\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate\">\n            Countries Affected\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-xl font-bold font-mono text-white tracking-tight\">\n              {stats.countriesAffectedCount}\n            </span>\n            <span className=\"text-[10px] text-slate-500\">jurisdictions</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Malicious IPs */}\n      <div className=\"bg-[#0b1329]/90 border border-slate-800/80 rounded-xl p-3.5 flex items-center gap-3 shadow-sm\">\n        <div className=\"w-9 h-9 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center shrink-0\">\n          <ShieldAlert className=\"w-4 h-4\" />\n        </div>\n        <div className=\"min-w-0\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate\">\n            Malicious IPs\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-xl font-bold font-mono text-orange-400 tracking-tight\">\n              {stats.maliciousIpsCount}\n            </span>\n            <span className=\"text-[10px] text-slate-500\">quarantined</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. Critical Events */}\n      <div className=\"bg-[#0b1329]/90 border border-slate-800/80 rounded-xl p-3.5 flex items-center gap-3 shadow-sm\">\n        <div className=\"w-9 h-9 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center shrink-0\">\n          <AlertOctagon className=\"w-4 h-4\" />\n        </div>\n        <div className=\"min-w-0\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate\">\n            Critical Events\n          </span>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-xl font-bold font-mono text-rose-400 tracking-tight\">\n              {stats.criticalEventsCount}\n            </span>\n            <span className=\"text-[10px] text-rose-400/70 font-semibold animate-pulse\">P0 priority</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
