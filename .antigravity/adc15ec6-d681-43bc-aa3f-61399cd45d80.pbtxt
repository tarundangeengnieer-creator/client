        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Computes a smooth curved arc between source and destination coordinates."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Generates an array of [lon, lat] points creating a subtle parabolic arc over the sphere."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "function createArcPoints("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  startLon: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  startLat: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  endLon: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  endLat: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  steps: number = 32"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "): [number, number][] {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const points: [number, number][] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Intermediate midpoint"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const midLon = (startLon + endLon) / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const midLat = (startLat + endLat) / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Calculate distance between points"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const dLon = endLon - startLon;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const dLat = endLat - startLat;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const distance = Math.sqrt(dLon * dLon + dLat * dLat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Curve height offset perpendicular to the line"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const curveFactor = Math.min(Math.max(distance * 0.18, 5), 28);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const controlLon = midLon;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const controlLat = midLat + (startLat > 0 && endLat > 0 ? curveFactor : -curveFactor);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  for (let i = 0; i <= steps; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const t = i / steps;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Quadratic Bezier interpolation: B(t) = (1-t)^2*P0 + 2(1-t)t*P1 + t^2*P2"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const lon = (1 - t) * (1 - t) * startLon + 2 * (1 - t) * t * controlLon + t * t * endLon;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const lat = (1 - t) * (1 - t) * startLat + 2 * (1 - t) * t * controlLat + t * t * endLat;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    points.push([lon, lat]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return points;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Transforms ThreatLocationEvents into GeoJSON FeatureCollections for MapLibre."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function threatEventsToGeoJson(events: ThreatLocationEvent[]): ThreatGeoJsonData {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const pointFeatures: GeoJsonPointFeature[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const lineFeatures: GeoJsonLineFeature[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  for (const evt of events) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // 1. Point feature"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pointFeatures.push({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      type: \'Feature\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      geometry: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        type: \'Point\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        coordinates: [evt.lon, evt.lat],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      properties: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        id: evt.id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        caseId: evt.caseId,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ip: evt.ip,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        country: evt.country,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        countryCode: evt.countryCode,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        city: evt.city,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        asn: evt.asn || \'N/A\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        organization: evt.organization || \'Unspecified Carrier\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        riskScore: evt.riskScore,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        threatLevel: evt.threatLevel,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        eventCount: evt.eventCount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        source: evt.source,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        lastSeen: evt.lastSeen,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        subject: evt.subject || \'Incident Investigation\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        attackVector: evt.attackVector || \'Network Ingress\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        isTorExit: !!evt.isTorExit,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        hasTarget: evt.targetLat !== undefined && evt.targetLon !== undefined,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // 2. Curved Arc connection line feature (if destination coordinates exist and differ from origin)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      evt.targetLat !== undefined &&"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      evt.targetLon !== undefined &&"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      (Math.abs(evt.lat - evt.targetLat) > 0.5 || Math.abs(evt.lon - evt.targetLon) > 0.5)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const arcCoords = createArcPoints(evt.lon, evt.lat, evt.targetLon, evt.targetLat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      lineFeatures.push({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        type: \'Feature\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        geometry: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          type: \'LineString\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          coordinates: arcCoords,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        properties: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          id: `arc-${evt.id}`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          caseId: evt.caseId,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          sourceIp: evt.ip,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          sourceCity: evt.city,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          sourceCountry: evt.country,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          targetCity: evt.targetCity || \'Recipient Infrastructure\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          targetCountry: evt.targetCountry || \'Enterprise Ingress\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          threatLevel: evt.threatLevel,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          riskScore: evt.riskScore,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          attackVector: evt.attackVector || \'Transit Relay\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      });"
