    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Geolocation Coordinates Resolver\n * Resolves cities, countries, and regional relays to precise WGS84 [lon, lat] coordinates.\n * Prevents invalid/missing coordinates from breaking MapLibre rendering.\n */\n\nexport interface Coordinates {\n  lat: number;\n  lon: number;\n}\n\n// Normalized lookup dictionary for world cities frequently seen in threat telemetry\nconst CITY_COORDINATES: Record<string, Coordinates> = {\n  // Europe\n  \'frankfurt\': { lat: 50.1109, lon: 8.6821 },\n  \'frankfurt am main\': { lat: 50.1109, lon: 8.6821 },\n  \'berlin\': { lat: 52.52, lon: 13.405 },\n  \'munich\': { lat: 48.1351, lon: 11.582 },\n  \'amsterdam\': { lat: 52.3676, lon: 4.9041 },\n  \'london\': { lat: 51.5074, lon: -0.1278 },\n  \'paris\': { lat: 48.8566, lon: 2.3522 },\n  \'moscow\': { lat: 55.7558, lon: 37.6173 },\n  \'saint petersburg\': { lat: 59.9343, lon: 30.3351 },\n  \'bucharest\': { lat: 44.4268, lon: 26.1025 },\n  \'sofia\': { lat: 42.6977, lon: 23.3219 },\n  \'warsaw\': { lat: 52.2297, lon: 21.0122 },\n  \'zurich\': { lat: 47.3769, lon: 8.5417 },\n  \'stockholm\': { lat: 59.3293, lon: 18.0686 },\n  \'dublin\': { lat: 53.3498, lon: -6.2603 },\n  \'kyiv\': { lat: 50.4501, lon: 30.5234 },\n\n  // Asia / Pacific\n  \'mumbai\': { lat: 19.076, lon: 72.8777 },\n  \'delhi\': { lat: 28.6139, lon: 77.209 },\n  \'new delhi\': { lat: 28.6139, lon: 77.209 },\n  \'indore\': { lat: 22.7196, lon: 75.8577 },\n  \'bengaluru\': { lat: 12.9716, lon: 77.5946 },\n  \'bangalore\': { lat: 12.9716, lon: 77.5946 },\n  \'chennai\': { lat: 13.0827, lon: 80.2707 },\n  \'hyderabad\': { lat: 17.385, lon: 78.4867 },\n  \'singapore\': { lat: 1.3521, lon: 103.8198 },\n  \'tokyo\': { lat: 35.6762, lon: 139.6503 },\n  \'beijing\': { lat: 39.9042, lon: 116.4074 },\n  \'shanghai\': { lat: 31.2304, lon: 121.4737 },\n  \'hong kong\': { lat: 22.3193, lon: 114.1694 },\n  \'seoul\': { lat: 37.5665, lon: 126.978 },\n  \'sydney\': { lat: -33.8688, lon: 151.2093 },\n  \'melbourne\': { lat: -37.8136, lon: 144.9631 },\n\n  // Americas\n  \'san francisco\': { lat: 37.7749, lon: -122.4194 },\n  \'ashburn\': { lat: 39.0438, lon: -77.4874 },\n  \'new york\': { lat: 40.7128, lon: -74.006 },\n  \'chicago\': { lat: 41.8781, lon: -87.6298 },\n  \'los angeles\': { lat: 34.0522, lon: -118.2437 },\n  \'seattle\': { lat: 47.6062, lon: -122.3321 },\n  \'austin\': { lat: 30.2672, lon: -97.7431 },\n  \'miami\': { lat: 25.7617, lon: -80.1918 },\n  \'toronto\': { lat: 43.6532, lon: -79.3832 },\n  \'sao paulo\': { lat: -23.5505, lon: -46.6333 },\n  \'buenos aires\': { lat: -34.6037, lon: -58.3816 },\n\n  // Middle East & Africa\n  \'dubai\': { lat: 25.2048, lon: 55.2708 },\n  \'tel aviv\': { lat: 32.0853, lon: 34.7818 },\n  \'cairo\': { lat: 30.0444, lon: 31.2357 },\n  \'johannesburg\': { lat: -26.2041, lon: 28.0473 },\n};\n\n// Fallback country centroid coordinates\nconst COUNTRY_COORDINATES: Record<string, Coordinates> = {\n  \'de\': { lat: 51.1657, lon: 10.4515 },\n  \'germany\': { lat: 51.1657, lon: 10.4515 },\n  \'in\': { lat: 20.5937, lon: 78.9629 },\n  \'india\': { lat: 20.5937, lon: 78.9629 },\n  \'us\': { lat: 37.0902, lon: -95.7129 },\n  \'united states\': { lat: 37.0902, lon: -95.7129 },\n  \'usa\': { lat: 37.0902, lon: -95.7129 },\n  \'ru\': { lat: 61.524, lon: 105.3188 },\n  \'russia\': { lat: 61.524, lon: 105.3188 },\n  \'nl\': { lat: 52.1326, lon: 5.2913 },\n  \'netherlands\': { lat: 52.1326, lon: 5.2913 },\n  \'gb\': { lat: 55.3781, lon: -3.436 },\n  \'united kingdom\': { lat: 55.3781, lon: -3.436 },\n  \'uk\': { lat: 55.3781, lon: -3.436 },\n  \'ro\': { lat: 45.9432, lon: 24.9668 },\n  \'romania\': { lat: 45.9432, lon: 24.9668 },\n  \'cn\': { lat: 35.8617, lon: 104.1954 },\n  \'china\': { lat: 35.8617, lon: 104.1954 },\n  \'fr\': { lat: 46.2276, lon: 2.2137 },\n  \'france\': { lat: 46.2276, lon: 2.2137 },\n  \'jp\': { lat: 36.2048, lon: 138.2529 },\n  \'japan\': { lat: 36.2048, lon: 138.2529 },\n  \'sg\': { lat: 1.3521, lon: 103.8198 },\n  \'singapore\': { lat: 1.3521, lon: 103.8198 },\n  \'br\': { lat: -14.235, lon: -51.9253 },\n  \'brazil\': { lat: -14.235, lon: -51.9253 },\n  \'au\': { lat: -25.2744, lon: 133.7751 },\n  \'australia\': { lat: -25.2744, lon: 133.7751 },\n  \'ca\': { lat: 56.1304, lon: -106.3468 },\n  \'canada\': { lat: 56.1304, lon: -106.3468 },\n  \'bg\': { lat: 42.7339, lon: 25.4858 },\n  \'bulgaria\': { lat: 42.7339, lon: 25.4858 },\n  \'ua\': { lat: 48.3794, lon: 31.1656 },\n  \'ukraine\': { lat: 48.3794, lon: 31.1656 },\n  \'pl\': { lat: 51.9194, lon: 19.1451 },\n  \'poland\': { lat: 51.9194, lon: 19.1451 },\n};\n\n/**\n * Validates and clamps coordinates to legitimate Geographic Bounds.\n */\nexport function isValidCoordinate(lat: unknown, lon: unknown): boolean {\n  if (typeof lat !== \'number\' || typeof lon !== \'number\') return false;\n  if (isNaN(lat) || isNaN(lon)) return false;\n  if (lat < -85 || lat > 85) return false;\n  if (lon < -180 || lon > 180) return false;\n  return true;\n}\n\n/**\n * Resolves coordinates from given city and country, with safe fallback.\n */\nexport function resolveCoordinates(\n  city?: string | null,\n  country?: string | null,\n  countryCode?: string | null,\n  fallbackSeed?: string\n): Coordinates {\n  if (city) {\n    const cityKey = city.toLowerCase().trim();\n    if (CITY_COORDINATES[cityKey]) {\n      return CITY_COORDINATES[cityKey];\n    }\n  }\n\n  if (countryCode) {\n    const codeKey = countryCode.toLowerCase().trim();\n    if (COUNTRY_COORDINATES[codeKey]) {\n      return COUNTRY_COORDINATES[codeKey];\n    }\n  }\n\n  if (country) {\n    const countryKey = country.toLowerCase().trim();\n    if (COUNTRY_COORDINATES[countryKey]) {\n      return COUNTRY_COORDINATES[countryKey];\n    }\n  }\n\n  // Deterministic fallback if location text is unknown (jitter around central Europe/Equator)\n  if (fallbackSeed) {\n    let hash = 0;\n    for (let i = 0; i < fallbackSeed.length; i++) {\n      hash = (hash << 5) - hash + fallbackSeed.charCodeAt(i);\n      hash |= 0;\n    }\n    const lat = 20 + ((Math.abs(hash) % 40) - 20);\n    const lon = ((Math.abs(hash >> 3) % 180) - 90);\n    return { lat, lon };\n  }\n\n  // Default coordinate (Frankfurt, major EU internet exchange hub)\n  return { lat: 50.1109, lon: 8.6821 };\n}\n"
    }
