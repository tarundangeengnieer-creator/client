    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Threat Map Legend\n * Compact, subtle SOC legend indicating severity levels, marker clusters, and connection arcs.\n */\n\nimport React from \'react\';\n\nexport const MapLegend: React.FC = () => {\n  return (\n    <div\n      id=\"threat-map-legend\"\n      className=\"bg-[#0b1329]/90 backdrop-blur-sm border border-slate-800/90 rounded-lg px-3 py-2 text-[11px] text-slate-300 shadow-lg flex flex-wrap items-center gap-x-4 gap-y-1.5 select-none\"\n    >\n      <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n        Severity:\n      </span>\n\n      {/* Critical */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-rose-500/20\" />\n        <span className=\"font-medium text-slate-300\">Critical</span>\n      </div>\n\n      {/* High */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"w-2.5 h-2.5 rounded-full bg-orange-500 ring-2 ring-orange-500/20\" />\n        <span className=\"font-medium text-slate-300\">High</span>\n      </div>\n\n      {/* Medium */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"w-2.5 h-2.5 rounded-full bg-amber-400 ring-2 ring-amber-400/20\" />\n        <span className=\"font-medium text-slate-300\">Medium</span>\n      </div>\n\n      {/* Low */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"w-2.5 h-2.5 rounded-full bg-sky-400 ring-2 ring-sky-400/20\" />\n        <span className=\"font-medium text-slate-300\">Low / Benign</span>\n      </div>\n\n      {/* Cluster */}\n      <div className=\"hidden sm:flex items-center gap-1.5 pl-2 border-l border-slate-800\">\n        <span className=\"w-3.5 h-3.5 rounded-full bg-blue-600/80 border border-blue-400 text-[9px] font-bold text-white flex items-center justify-center\">\n          +\n        </span>\n        <span className=\"text-slate-400\">Cluster Node</span>\n      </div>\n\n      {/* Attack Arc */}\n      <div className=\"hidden md:flex items-center gap-1.5\">\n        <span className=\"w-4 h-0.5 border-t-2 border-dashed border-rose-400\" />\n        <span className=\"text-slate-400\">Transit Arc</span>\n      </div>\n    </div>\n  );\n};\n"
    }
