  file_change {
    absolute_path_uri: "file:///src/features/dashboard/threat-map/ThreatPopup.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Threat Details Popup Card\n * Displays defanged IoC telemetry, RFC 822 relay information, and risk score.\n * Features a direct \"View Evidence\" action integrated into ASHielder case routing.\n */\n\nimport React, { useState } from \'react\';\nimport { ThreatLocationEvent } from \'./types.ts\';\nimport { defangIp } from \'../../../lib/defang.ts\';\nimport { formatTimestamp } from \'../../../lib/formatters.ts\';\nimport { uiStore } from \'../../../stores/ui-store.ts\';\nimport {\n  ShieldAlert,\n  AlertTriangle,\n  Shield,\n  Copy,\n  Check,\n  ExternalLink,\n  X,\n  Radio,\n  Server,\n  Network,\n  Calendar,\n  Layers,\n  ArrowUpRight,\n} from \'lucide-react\';\n\ninterface ThreatPopupProps {\n  threat: ThreatLocationEvent;\n  onClose: () => void;\n}\n\nexport const ThreatPopup: React.FC<ThreatPopupProps> = ({ threat, onClose }) => {\n  const [copied, setCopied] = useState(false);\n\n  const handleCopyRawIp = () => {\n    navigator.clipboard.writeText(threat.ip);\n    setCopied(true);\n    uiStore.addToast(\'info\', `Copied raw IP: ${threat.ip}`);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleViewEvidence = () => {\n    uiStore.setActiveCase(threat.caseId);\n    uiStore.navigate(`/case/${threat.caseId}`);\n  };\n\n  // Severity style tokens\n  const getSeverityBadge = () => {\n    switch (threat.threatLevel) {\n      case \'critical\':\n        return {\n          bg: \'bg-rose-950/80 text-rose-300 border-rose-500/50\',\n          dot: \'bg-rose-500\',\n          label: \'CRITICAL THREAT\',\n        };\n      case \'high\':\n        return {\n          bg: \'bg-orange-950/80 text-orange-300 border-orange-500/50\',\n          dot: \'bg-orange-500\',\n          label: \'HIGH SEVERITY\',\n        };\n      case \'medium\':\n        return {\n          bg: \'bg-amber-950/80 text-amber-300 border-amber-500/50\',\n          dot: \'bg-amber-500\',\n          label: \'SUSPICIOUS / MED\',\n        };\n      default:\n        return {\n          bg: \'bg-sky-950/80 text-sky-300 border-sky-500/50\',\n          dot: \'bg-sky-400\',\n          label: \'LOW / BENIGN\',\n        };\n    }\n  };\n\n  const badge = getSeverityBadge();\n\n  return (\n    <div\n      id={`threat-popup-${threat.id}`}\n      className=\"absolute bottom-4 right-4 sm:bottom-6 sm:right-6 z-30 w-88 max-w-[calc(100vw-2rem)] bg-[#0b1329]/95 backdrop-blur-md border border-slate-700/80 rounded-xl shadow-2xl overflow-hidden animate-fadeIn\"\n    >\n      {/* Header */}\n      <div className=\"px-4 py-3 border-b border-slate-800 flex items-center justify-between bg-slate-900/60\">\n        <div className=\"flex items-center gap-2\">\n          <span className={`px-2 py-0.5 rounded text-[10px] font-bold border flex items-center gap-1.5 ${badge.bg}`}>\n            <span className={`w-1.5 h-1.5 rounded-full ${badge.dot} animate-pulse`} />\n            {badge.label}\n          </span>\n          <span className=\"text-[11px] font-mono text-slate-400\">\n            Case #{threat.caseId}\n          </span>\n        </div>\n        <button\n          type=\"button\"\n          onClick={onClose}\n          className=\"p-1 rounded-md text-slate-400 hover:text-white hover:bg-slate-800/80 transition-colors cursor-pointer\"\n          title=\"Close details\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Body Content */}\n      <div className=\"p-4 space-y-3.5 text-xs text-slate-300\">\n        {/* IP Address & Copy action */}\n        <div>\n          <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 flex items-center justify-between\">\n            <span>Defanged IP Address</span>\n            {threat.isTorExit && (\n              <span className=\"text-[10px] font-semibold text-rose-400 bg-rose-950/60 px-1.5 py-0.2 rounded border border-rose-800/60\">\n                Tor Exit Node\n              </span>\n            )}\n          </div>\n          <div className=\"flex items-center justify-between bg-slate-950/80 px-2.5 py-1.5 rounded-lg border border-slate-800\">\n            <span className=\"font-mono text-sm font-bold text-white tracking-wide select-all\">\n              {defangIp(threat.ip)}\n            </span>\n            <button\n              type=\"button\"\n              onClick={handleCopyRawIp}\n              className=\"p-1 text-slate-400 hover:text-white rounded hover:bg-slate-800 transition-colors flex items-center gap-1 text-[11px] cursor-pointer\"\n              title=\"Copy raw IP\"\n            >\n              {copied ? (\n                <>\n                  <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  <span className=\"text-emerald-400 text-[10px]\">Copied</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-3.5 h-3.5\" />\n                  <span className=\"text-[10px]\">Raw</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Location & ASN Grid */}\n        <div className=\"grid grid-cols-2 gap-2 text-xs\">\n          {/* Location */}\n          <div className=\"bg-slate-900/50 p-2.5 rounded-lg border border-slate-800/80\">\n            <span className=\"text-[10px] font-medium text-slate-400 block mb-0.5\">Location</span>\n            <p className=\"font-semibold text-white truncate\" title={`${threat.city}, ${threat.country}`}>\n              {threat.city}, {threat.country}\n            </p>\n            <p className=\"text-[10px] text-slate-400 mt-0.5\">\n              Lat: {threat.lat.toFixed(2)} | Lon: {threat.lon.toFixed(2)}\n            </p>\n          </div>\n\n          {/* ASN & Org */}\n          <div className=\"bg-slate-900/50 p-2.5 rounded-lg border border-slate-800/80\">\n            <span className=\"text-[10px] font-medium text-slate-400 block mb-0.5\">Network / ASN</span>\n            <p className=\"font-semibold text-white truncate\" title={threat.asn || \'N/A\'}>\n              {threat.asn || \'Unknown ASN\'}\n            </p>\n            <p className=\"text-[10px] text-slate-400 truncate mt-0.5\" title={threat.organization || \'Carrier\'}>\n              {threat.organization || \'Carrier\'}\n            </p>\n          </div>\n        </div>\n\n        {/* Risk Metrics & Telemetry Details */}\n        <div className=\"space-y-1.5 pt-1 text-[11px]\">\n          <div className=\"flex items-center justify-between py-1 border-b border-slate-800/60\">\n            <span className=\"text-slate-400 flex items-center gap-1.5\">\n              <Shield className=\"w-3.5 h-3.5 text-slate-500\" />\n              Risk Score\n            </span>\n            <div className=\"flex items-center gap-1.5\">\n              <span className={`font-bold ${threat.riskScore >= 80 ? \'text-rose-400\' : threat.riskScore >= 50 ? \'text-amber-400\' : \'text-sky-400\'}`}>\n                {threat.riskScore}/100\n              </span>\n              <div className=\"w-12 h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n                <div\n                  className={`h-full rounded-full ${threat.riskScore >= 80 ? \'bg-rose-500\' : threat.riskScore >= 50 ? \'bg-amber-400\' : \'bg-sky-400\'}`}\n                  style={{ width: `${Math.min(threat.riskScore, 100)}%` }}\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between py-1 border-b border-slate-800/60\">\n            <span className=\"text-slate-400 flex items-center gap-1.5\">\n              <Layers className=\"w-3.5 h-3.5 text-slate-500\" />\n              Event Count\n            </span>\n            <span className=\"font-mono font-semibold text-white\">\n              {threat.eventCount} occurrences\n            </span>\n          </div>\n\n          <div className=\"flex items-center justify-between py-1 border-b border-slate-800/60\">\n            <span className=\"text-slate-400 flex items-center gap-1.5\">\n              <Radio className=\"w-3.5 h-3.5 text-slate-500\" />\n              Ingress Source\n            </span>\n            <span className=\"font-mono text-slate-300 truncate max-w-[170px]\" title={threat.source}>\n              {threat.source}\n            </span>\n          </div>\n\n          <div className=\"flex items-center justify-between py-1\">\n            <span className=\"text-slate-400 flex items-center gap-1.5\">\n              <Calendar className=\"w-3.5 h-3.5 text-slate-500\" />\n              Last Seen\n            </span>\n            <span className=\"font-mono text-slate-300\">\n              {formatTimestamp(threat.lastSeen)}\n            </span>\n          </div>\n        </div>\n\n        {/* Attack Vector Highlight */}\n        {threat.attackVector && (\n          <div className=\"p-2.5 rounded-lg bg-slate-900/80 border border-slate-800 text-[11px] text-slate-300\">\n            <span className=\"text-[10px] font-bold text-slate-400 block mb-0.5\">Primary Hypothesis</span>\n            <p className=\"font-medium text-slate-200 line-clamp-2\">\n              {threat.attackVector}\n            </p>\n          </div>\n        )}\n      </div>\n\n      {/* Footer Action: View Evidence */}\n      <div className=\"px-4 py-3 bg-slate-900/90 border-t border-slate-800 flex items-center justify-between gap-3\">\n        <span className=\"text-[11px] text-slate-400\">\n          Forensic Telemetry\n        </span>\n        <button\n          type=\"button\"\n          onClick={handleViewEvidence}\n          className=\"px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs flex items-center gap-1.5 transition-all shadow-md cursor-pointer hover:shadow-blue-500/20\"\n        >\n          <span>View Evidence</span>\n          <ArrowUpRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
