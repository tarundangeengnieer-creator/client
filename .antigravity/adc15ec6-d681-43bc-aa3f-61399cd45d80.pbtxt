    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * ASHIELDER Map Interactive Controls\n * Zoom in, Zoom out, Reset/Home View, Fullscreen toggle, and Arc display toggle.\n */\n\nimport React from \'react\';\nimport { Plus, Minus, RotateCcw, Maximize2, Minimize2, GitCommit } from \'lucide-react\';\n\ninterface MapControlsProps {\n  onZoomIn: () => void;\n  onZoomOut: () => void;\n  onResetView: () => void;\n  onToggleFullscreen: () => void;\n  isFullscreen: boolean;\n  showArcs: boolean;\n  onToggleArcs: () => void;\n}\n\nexport const MapControls: React.FC<MapControlsProps> = ({\n  onZoomIn,\n  onZoomOut,\n  onResetView,\n  onToggleFullscreen,\n  isFullscreen,\n  showArcs,\n  onToggleArcs,\n}) => {\n  return (\n    <div className=\"flex flex-col gap-1.5 select-none\">\n      {/* Zoom In & Out Button Group */}\n      <div className=\"bg-[#0b1329]/90 backdrop-blur-sm border border-slate-800 rounded-lg shadow-lg overflow-hidden flex flex-col\">\n        <button\n          type=\"button\"\n          onClick={onZoomIn}\n          className=\"p-2 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors border-b border-slate-800/80 cursor-pointer\"\n          title=\"Zoom in\"\n          aria-label=\"Zoom in\"\n        >\n          <Plus className=\"w-4 h-4\" />\n        </button>\n        <button\n          type=\"button\"\n          onClick={onZoomOut}\n          className=\"p-2 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer\"\n          title=\"Zoom out\"\n          aria-label=\"Zoom out\"\n        >\n          <Minus className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Reset / Home View */}\n      <div className=\"bg-[#0b1329]/90 backdrop-blur-sm border border-slate-800 rounded-lg shadow-lg overflow-hidden\">\n        <button\n          type=\"button\"\n          onClick={onResetView}\n          className=\"p-2 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors flex items-center justify-center cursor-pointer w-full\"\n          title=\"Reset map view to default\"\n          aria-label=\"Reset map view\"\n        >\n          <RotateCcw className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Toggle Attack Arcs */}\n      <div className=\"bg-[#0b1329]/90 backdrop-blur-sm border border-slate-800 rounded-lg shadow-lg overflow-hidden\">\n        <button\n          type=\"button\"\n          onClick={onToggleArcs}\n          className={`p-2 transition-colors flex items-center justify-center cursor-pointer w-full ${\n            showArcs ? \'text-sky-400 bg-sky-950/40 hover:bg-sky-950/60\' : \'text-slate-500 hover:text-slate-300 hover:bg-slate-800\'\n          }`}\n          title={showArcs ? \'Hide attack connection arcs\' : \'Show attack connection arcs\'}\n          aria-label=\"Toggle connection arcs\"\n        >\n          <GitCommit className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Fullscreen Toggle */}\n      <div className=\"bg-[#0b1329]/90 backdrop-blur-sm border border-slate-800 rounded-lg shadow-lg overflow-hidden\">\n        <button\n          type=\"button\"\n          onClick={onToggleFullscreen}\n          className=\"p-2 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors flex items-center justify-center cursor-pointer w-full\"\n          title={isFullscreen ? \'Exit fullscreen\' : \'Expand map fullscreen\'}\n          aria-label=\"Toggle fullscreen\"\n        >\n          {isFullscreen ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
