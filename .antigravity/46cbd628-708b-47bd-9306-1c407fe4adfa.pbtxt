        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Cybersecurity analysts frequently work 12-hour shifts in varied lighting conditions. The interface adheres strictly to **WCAG 2.1 Level AA** standards."
