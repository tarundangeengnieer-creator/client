        lines {
          text: "# SECTION 2 \342\200\224 FRONTEND FEATURE \342\206\222 API MAPPING"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This matrix directly maps every functional area defined in Stage 1 (`ASHIELDER_FRONTEND_PRODUCT_SPEC.md`) to the actual backend capabilities discovered during Phase 1\342\200\2234 runtime audits."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Frontend Feature | Required API | Backend Status | Data Required | Missing Dependency | Frontend Fallback Strategy |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| :--- | :--- | :--- | :--- | :--- | :--- |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Authentication** | `POST /api/v1/investigations/*` | \342\234\205 IMPLEMENTED | `X-API-Key` | Backend lacks multi-user RBAC. | Store API key in secure client session storage; prompt analyst if unset. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Case Inbox / List** | `GET /api/v1/investigations` | \360\237\224\264 NOT IMPLEMENTED | List of cases with pagination | Backend lacks a global `GET /investigations` list endpoint. | Maintain indexed local history of analyzed cases in browser IndexedDB/LocalStorage. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Case Filtering / Search** | Client-side query engine | \360\237\237\241 PARTIALLY IMPLEMENTED | Filter parameters | No backend search endpoint exists. | Filter client-side against the local case cache and loaded investigation results. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Case Workspace HUD** | `POST /analyze` or `GET /{id}` | \342\234\205 IMPLEMENTED | `case_id`, `verdict`, `risk_score`, `confidence` | None. | Direct binding to `InvestigationResult`. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **EML Ingestion** | `POST /api/v1/investigations/analyze` | \342\234\205 IMPLEMENTED | Multipart Form `.eml` | None. | Direct binding to standard browser `FormData` file upload. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Investigation Journey** | `InvestigationResult.budget`, `tools_used`, `tools_failed` | \342\234\205 IMPLEMENTED | Step progression telemetry | Granular per-step timestamps are aggregated, not individual step objects. | Derive journey steps deterministically from `tools_used`, `tools_failed`, and `iteration_count`. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Risk / Confidence / Verdict** | `InvestigationResult` | \342\234\205 IMPLEMENTED | `risk_score`, `confidence`, `verdict` | None. | Direct binding to 2D Risk-Confidence HUD widgets. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Key Findings** | `GET /{id}/evidence` | \342\234\205 IMPLEMENTED | Highest weighted `EvidenceItem` records | None. | Filter evidence where `severity == \'CRITICAL\' \\|\\| \'HIGH\'` or score weight $\\ge 20$. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Evidence Explorer** | `GET /api/v1/investigations/{id}/evidence` | \342\234\205 IMPLEMENTED | Full array of `EvidenceItem` | None. | Render filterable, sortable forensic datatable. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Header Forensics Matrix** | `GET /{id}/evidence` & `POST /emails/analyze` | \342\234\205 IMPLEMENTED | `FACT` items from `spf_dkim_dmarc`, `header_parse` | None. | Extract `auth_spf_result`, `auth_dkim_result`, `auth_dmarc_result`. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Received Hop Route** | `GET /{id}/evidence` | \342\234\205 IMPLEMENTED | `FACT` items from `relay_reconstruction` | None. | Parse `received_hops` evidence items into node diagram. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **URL Analysis** | `GET /{id}/evidence` | \342\234\205 IMPLEMENTED | `url_canonicalizer`, `url_ml` outputs | `urlhaus_feed_lookup` is disabled. | Display extracted URLs with M4 LightURLNet risk scores; defang automatically. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Domain Intelligence** | `GET /{id}/evidence` | \360\237\237\241 PARTIALLY IMPLEMENTED | `rdap_domain_lookup` | `domain_intelligence` handler disabled; RDAP requires network. | Show RDAP domain age if present; flag degraded indicator if missing. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **IP Intelligence** | `GET /{id}/evidence` | \360\237\237\241 PARTIALLY IMPLEMENTED | `ip_classifier`, `abuseipdb_lookup` | External threat feeds require live API keys. | Show IP classification (Public/Private/Tor); mark external reputation as degraded if unconfigured. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Geolocation** | `InvestigationResult.geolocation` | \342\234\205 IMPLEMENTED | `origin_ip`, `country`, `asn`, `coords` | None. | Bind directly to interactive world map and country flag badges. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Attachments Lab** | `GET /{id}/evidence` & `ParsedEmail.attachments` | \360\237\237\241 PARTIALLY IMPLEMENTED | `attachment_hasher` (SHA-256) | `attachment_static_analysis` is disabled in backend registry. | Display file hashes and MIME mismatches; state that deep sandbox execution was skipped. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Historical Intelligence** | `GET /{id}/evidence` | \360\237\237\241 PARTIALLY IMPLEMENTED | `historical_cases_found` evidence item | Supabase PostgreSQL matching requires live DB; local tests use SQLite. | Display historical cluster matches if present; state \"No Historical Precedent Found\" if empty. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Re-investigation** | `POST /api/v1/investigations/{id}/reinvestigate` | \342\234\205 IMPLEMENTED | New case ID, diff evidence | None. | Trigger re-run and open side-by-side diff against the original case snapshot. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Forensic Report** | `GET /api/v1/investigations/{id}/report` | \342\234\205 IMPLEMENTED | Structured report JSON | PDF binary download endpoint not implemented in backend. | Render interactive forensic report view with browser print stylesheet for PDF generation. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **AI Copilot** | `GET /report` (Groq summary) | \360\237\237\241 PARTIALLY IMPLEMENTED | `groq_narrative` in report endpoint | Standalone interactive conversational `/chat` endpoint is NOT implemented. | Provide an Evidence Question Answerer that queries local loaded evidence facts deterministically. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **INCONCLUSIVE State** | `InvestigationResult.verdict` | \342\234\205 IMPLEMENTED | `verdict == \'INCONCLUSIVE\'`, `missing_evidence` | None. | Render dedicated Missing Evidence Checklist and degraded tool banner. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Audit Chain** | `InvestigationResult.audit_chain_last_hash` | \342\234\205 IMPLEMENTED | SHA-256 genesis-chained hashes | None. | Display chain integrity seal and last record SHA-256 hash. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
