        }
        lines {
          text: "- **Zero Alerts in Inbox:** Displays clean status, last queue synchronization timestamp, and direct shortcuts to threat hunting or historical case search."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Zero Attachments in Case:** Clear informative panel: *\"No file attachments present in MIME payload. Static and dynamic attachment inspection bypassed.\"*"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Zero URLs Extracted:** Plaintext email confirmation: *\"Zero external HTTP/HTTPS hyperlinks detected in email body or headers.\"*"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **No Historical Matches:** *\"Unique Threat Signature: No correlated campaigns or matching IOCs found in historical database. This may indicate a targeted, novel zero-day operation.\"*"
