        lines {
          text: "#### EP-03: Get Investigation Details"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path:** `GET /api/v1/investigations/{investigation_id}`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Purpose:** Retrieve a previously executed investigation by its unique `case_id`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Authentication:** `X-API-Key: <SECRET_KEY>`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Required Headers:** `X-API-Key`, `X-Request-ID`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path Parameters:** `investigation_id` (string, e.g., `case_20260905_181402_a1b2c3d4`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Response Schema:** Returns the `InvestigationResult` model matching EP-02, supplemented with database timestamps (`created_at`, `updated_at`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Status Codes:** `200 OK`, `401 Unauthorized`, `404 Not Found`, `429 Too Many Requests`, `500 Internal Server Error`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Backend Status:** \342\234\205 Fully Implemented (backed by SQLite in local/test and Supabase PostgreSQL in staging/prod)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
