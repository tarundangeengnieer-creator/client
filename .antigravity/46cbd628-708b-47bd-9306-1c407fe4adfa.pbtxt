        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 4.2 Authentication Header Injection"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "All calls to `/api/v1/investigations/*` require the `X-API-Key` header. The frontend manages this key via secure in-memory state or session storage. It is **never** committed into public source repositories or `.env` files exposed to client builds."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```typescript"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
