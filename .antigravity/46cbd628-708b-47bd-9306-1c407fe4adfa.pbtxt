        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 20.2 Real-time Diagnostic Pipeline Stepper"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "During initial case ingestion (which may take 2 to 5 seconds for full sandbox detonation), the workspace displays a live execution stepper:"
