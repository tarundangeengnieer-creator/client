        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 25.1 Color Blindness Safe Semantics (Never Color Alone)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Status, risk, and verification indicators **never** rely exclusively on color hue:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `Malicious / High Risk`: Solid Red + Octagon Icon + Bold Monospace Label `[MALICIOUS]`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `Suspicious / Caution`: Amber + Warning Triangle + Monospace Label `[SUSPICIOUS]`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `Safe / Clean`: Emerald Teal + Shield Check Icon + Monospace Label `[BENIGN]`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
