        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 20.1 Progressive Structural Skeletons"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Standard rectangular pulsating bone skeletons that match the exact visual geometry of the final cards, tables, and gauges."
