        }
        lines {
          text: "3. The analyst clicks the **Missing Artifact Checklist**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Discovers that the attachment is a password-protected RAR file."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
