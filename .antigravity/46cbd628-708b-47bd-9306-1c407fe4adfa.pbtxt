        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 27.1 Color Token Architecture"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```css"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/* Core Neutrals - Deep Slate / Obsidian Archetype */"
