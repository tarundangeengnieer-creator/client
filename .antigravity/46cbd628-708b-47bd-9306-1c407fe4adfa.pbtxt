          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `X-Request-ID` (Optional but recommended): Client-generated UUIDv4 for distributed tracing."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Request Body (Multipart Form):**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `file`: Binary file stream of the `.eml` email message."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
