        }
        lines {
          text: "#### EP-06: Re-investigate Case"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path:** `POST /api/v1/investigations/{investigation_id}/reinvestigate`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **File & Function:** `app/api/v1/investigation.py:reinvestigate_case()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Purpose:** Re-executes the full Stage 1 adaptive investigation pipeline against an existing case\'s normalized package. Generates a new case ID with lineage back-reference to `original_case_id`, bypassing cached results."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Authentication:** `X-API-Key: <SECRET_KEY>`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Required Headers:** `X-API-Key`, `Content-Type: application/json`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Path Parameters:** `investigation_id` (string)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Request Body (JSON):**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"reason\": \"New threat intelligence feeds available for origin IP 185.220.101.5\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"requested_by\": \"analyst_priya\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Response Schema:** Returns a fresh `InvestigationResult` model (EP-02 schema) where:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `case_id`: Newly generated case identifier (prefixed with `reinv_` or timestamp UUID)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `original_case_id`: String containing the target `investigation_id`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Evidence list includes a `FACT` item of category `REINVESTIGATION` capturing the trigger reason and timestamp."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Status Codes:** `200 OK`, `401 Unauthorized`, `404 Not Found`, `422 Unprocessable Entity`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Frontend Consumer:** Case Workspace Re-investigate Button, Diff Comparison Modal."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Backend Status:** \342\234\205 Fully Implemented (upgraded from 501 stub in Phase 3/4)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
