        }
        lines {
          text: "Power analysts can operate the entire workstation without touching a mouse:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `J` / `K`: Move down / up through Case Inbox rows."
