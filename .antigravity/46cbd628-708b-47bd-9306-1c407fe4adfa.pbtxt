        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "### 10.1 Authentication Validation Matrix"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Structured grid of authentication badges:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **SPF (Sender Policy Framework):** Status (`PASS`, `FAIL`, `SOFTFAIL`, `NEUTRAL`, `PERMERROR`, `NONE`), evaluated IP, evaluated sender domain, mechanism matched (e.g., `-all`)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **DKIM (DomainKeys Identified Mail):** Status (`PASS`, `FAIL`, `PERMERROR`), Signing Domain (`d=`), Selector (`s=`), Canonicalization algorithm, Body Hash verification status (`bh`)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **DMARC:** Status (`PASS`, `FAIL`), Published Policy (`reject`, `quarantine`, `none`), Alignment status (SPF Identifier Alignment and DKIM Identifier Alignment)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **ARC (Authenticated Received Chain):** Evaluates whether an intermediary forwarder preserved validation integrity."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **BIMI (Brand Indicators for Message Identification):** Displays whether official VMC (Verified Mark Certificate) and logo were authenticated."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "### 10.2 Received Hop Visualizer"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Visual Hop Route:** Horizontal interactive node diagram showing each transmission leg from origin to corporate perimeter."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Hop Latency Calculator:** Computes delta time between sequential `Date:` headers on `Received:` lines. Anomalous delays (> 300 seconds) highlight potential relay injection or store-and-forward tampering."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Relay Reputation Scoring:** Each hop displays reverse DNS status, Geo-IP country, and ASN."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "### 10.3 Header Anomaly Detection Engine"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Automatic visual callouts for:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Date Skew:** Timestamp variance of $> 24$ hours between local server time and message origination time."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Subject Encoding Tricks:** Base64 or Quoted-Printable strings hiding homoglyphs or excessive invisible zero-width spaces (`U+200B`)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **Header Injection:** Multiple `Subject:`, `To:`, or `From:` lines present within a single RFC 5322 header block."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
