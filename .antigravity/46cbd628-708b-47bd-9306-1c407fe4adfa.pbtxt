        lines {
          text: "### 9.1 Evidence Registry Taxonomy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "All artifacts follow an immutable identifier schema:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-RAW-***`: Raw email file, raw headers, original message body."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-HDR-***`: Individual header fields, Received hops, Message-ID, Date values."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-AUT-***`: SPF, DKIM, DMARC, ARC cryptographic authentication results."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-NET-***`: IP addresses, ASNs, BGP routes, reverse DNS pointers."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-GEO-***`: Country, city, latitude/longitude, ISP jurisdiction."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-URL-***`: Extracted URLs, unshortened links, redirect chains, domain ages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-ATT-***`: Files, hashes, MIME mismatches, extracted macros, sandbox logs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `EVD-BEH-***`: Heuristic behavior (urgency language, payment redirection requests)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
