        lines {
          text: "# User Journeys"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 30.1 Journey 1: Rapid 60-Second L1 Triage & Clean Resolution"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Priya** opens the Case Inbox; uses `J`/`K` keys to navigate to alert `#ASH-2026-9040` (*\"Annual Benefits Enrollment Confirmation\"*)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Taps `Spacebar` to open **Quick-Peek Drawer**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Verdict: `BENIGN`, Risk: `4/100`, Confidence: `98/100`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Authentication Matrix shows: SPF `PASS`, DKIM `PASS`, DMARC `PASS` (Strict Alignment)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Domain `benefits.targetcorp.in` is verified corporate internal domain."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Presses `C` to confirm benign classification and archive alert. Total elapsed time: **18 seconds**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 30.2 Journey 2: L2 Investigation of Sophisticated BEC & Homograph Attack"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Arjun** receives escalated alert `#ASH-2026-9012` (*\"URGENT: Executive Wire Authorization\"*)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Lands in **Case Workspace**; the HUD instantly alerts: `MALICIOUS`, Risk `92/100`, Confidence `84/100`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Reviews **Key Findings**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - `[EVD-HDR-001]`: Domain `micro-soft.top` registered 4 hours ago."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - `[EVD-AUT-002]`: DMARC Failed; Return-Path domain does not align with From header."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. Switches to **Header Forensics Tab**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Reviews **Received Hop Visualizer**: Discovers origin IP `185.220.101.5` routed directly from a Russian Federation Tor exit relay."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. Switches to **URL & Domain Tab**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Inspects redirect chain: bit.ly shortened link unpacks into a credential harvesting portal imitating corporate Microsoft 365 login."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. Clicks `Ask Assistant`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Enters: *\"What other mailboxes received emails from this origin IP in the past 7 days?\"*"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Copilot checks historical intelligence and identifies 2 additional finance employees targeted 20 minutes prior."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. Clicks `Escalate Case`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - System triggers containment protocol to pull all matching messages from user inboxes. Total elapsed time: **4 minutes**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 30.3 Journey 3: Digital Forensics Examiner Compiling Court-Admissible Dossier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Dr. Mehta** is assigned case `#ASH-2026-8841` involving corporate IP theft."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Navigates to **Evidence Explorer**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Verifies each of the 32 generated Evidence IDs. Pins critical artifacts (`EVD-HDR-004`, `EVD-ATT-002`) to the formal report."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Opens **Attachment Forensics Tab**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Inspects sandbox process tree of the payload; verifies cryptographic hashes against local hardware tokens."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. Navigates to **Forensic Report Tab**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
