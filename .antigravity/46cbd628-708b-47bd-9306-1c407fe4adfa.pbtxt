        lines {
          text: "### 13.2 Claimed vs Actual Geolocation Discrepancy"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Compares the timezone asserted in the client\'s `Date:` header (e.g., `-0500 EST` representing New York) against the physical network timezone of the first authenticated `Received:` IP address. A severe timezone mismatch ($\\Delta > 4$ hours) is flagged as an evasive masquerade indicator."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
