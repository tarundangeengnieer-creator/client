          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 4.3 Universal HTTP Response Handler & Error Interceptor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The frontend API client implements a unified status code interceptor:"
