          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **DKIM (DomainKeys Identified Mail):** Status (`PASS`, `FAIL`, `PERMERROR`), Signing Domain (`d=`), Selector (`s=`), Canonicalization algorithm, Body Hash verification status (`bh`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **DMARC:** Status (`PASS`, `FAIL`), Published Policy (`reject`, `quarantine`, `none`), Alignment status (SPF Identifier Alignment and DKIM Identifier Alignment)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **ARC (Authenticated Received Chain):** Evaluates whether an intermediary forwarder preserved validation integrity."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **BIMI (Brand Indicators for Message Identification):** Displays whether official VMC (Verified Mark Certificate) and logo were authenticated."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 10.2 Received Hop Visualizer"
