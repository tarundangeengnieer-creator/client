        }
        lines {
          text: "`[\342\234\223 Unpacking EML] \342\224\200\342\224\200> [\342\234\223 Parsing 14 Headers] \342\224\200\342\224\200> [\342\237\263 Detonating Attachment in Sandbox (12s)] \342\224\200\342\224\200> [Pending AI Summary]`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The analyst can immediately begin reading parsed headers and URLs while the attachment sandbox finishes in the background."
