        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```typescript"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export async function apiRequest<T>("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
