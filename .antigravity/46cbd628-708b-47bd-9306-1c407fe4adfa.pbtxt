        }
        lines {
          text: "### 17.1 Report Sections Architecture"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Header & Metadata:** Case ID, Target Entity, Date of Incident, Investigating Analyst Name, Clearance Level, Report Generation Timestamp, Cryptographic SHA-256 Dossier Hash."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Executive Summary:** High-level narrative summary of the incident for non-technical leadership and legal counsel."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Verdict & Risk Matrix:** Dual-metric display of final Verdict, Risk Score ($0-100$), and Confidence Score ($0-100$)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Key Evidentiary Findings:** Bulleted, prioritized list with direct Evidence ID citations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. **Authentication Analysis:** SPF, DKIM, DMARC, ARC, BIMI results with raw alignment reasons."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. **Header Analysis & Received Transit:** Full hop route table, transit delays, origin IP verification."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. **Extracted Link & URL Analysis:** Defanged URLs, redirect hops, domain registration timelines."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "8. **Attachment Forensics:** File hashes, MIME integrity, sandbox process execution trees."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "9. **Infrastructure & Geolocation:** Autonomous systems, reverse DNS, geographical route map."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "10. **Investigation Journey Audit:** Log of all automated pipeline steps executed and tool performance."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "11. **Missing Evidence & Failed Tools Disclosure:** Explicit disclosure of any tool timeouts, missing network logs, or encrypted payloads that could not be inspected."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "12. **Chain of Custody & Cryptographic Audit Seal:** Digital signature block, hash of the raw `.eml` file, and analyst sign-off."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
