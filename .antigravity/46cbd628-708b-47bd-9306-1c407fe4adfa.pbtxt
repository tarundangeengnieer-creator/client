        lines {
          text: "### 27.2 Typographic Hierarchy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Display & Interface UI:** `Inter`, `Plus Jakarta Sans`, or `system-ui` (Clean, highly legible neo-grotesque sans-serif)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Evidence & Code Telemetry:** `JetBrains Mono` or `IBM Plex Mono` (Distinguished tabular numerals, unambiguous zero `0` vs `O` glyphs, clear punctuation)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Type Scale:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - HUD Verdict Title: `20px` / Line-Height `28px` / Weight `700`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Section Headings: `16px` / Line-Height `24px` / Weight `600`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Body & Table Text: `14px` / Line-Height `20px` / Weight `400`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Telemetry Monospace: `13px` / Line-Height `18px` / Weight `500`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Micro Footnotes & Tags: `11px` / Line-Height `14px` / Weight `600` / Tracking `+0.5px`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 27.3 Component Geometries & Spacing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Corner Radii:** Strictly bounded between `4px` (inner chips/inputs) and `8px` (outer cards/modals). No playful pill buttons or bubble cards."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Spacing Grid:** 4px baseline unit with strict steps: `4px`, `8px`, `12px`, `16px`, `24px`, `32px`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Elevation:** Flat surfaces separated by subtle 1px border lines (`#232D42`). Shadows are reserved exclusively for floating dropdowns and top modals (`0 8px 24px rgba(0,0,0,0.5)`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
