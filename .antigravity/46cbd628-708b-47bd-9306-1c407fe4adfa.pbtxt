        lines {
          text: "# Component Inventory"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A unified catalog of 32 purpose-built forensic client components:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **`CaseHUD`**: Persistent top header displaying case ID, verdict, risk gauge, confidence meter, sender, and action buttons."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **`VerdictBadge`**: Accessible high-contrast status badge (`Malicious`, `Suspicious`, `Inconclusive`, `Benign`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **`RiskGauge`**: Segmented radial or horizontal bar illustrating threat severity ($0-100$)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **`ConfidenceMeter`**: Segmented evidentiary completeness meter ($0-100$)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. **`AuthMatrix`**: 5-column cryptographic authentication grid (SPF, DKIM, DMARC, ARC, BIMI)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. **`HopVisualizer`**: Interactive node-and-connector chain showing mail transmission legs and latency deltas."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. **`EvidenceChip`**: Clickable pill component displaying Evidence ID (`[EVD-HDR-001]`), severity dot, and trigger link."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "8. **`EvidenceDrawer`**: Slideout inspector displaying raw bytes, SHA-256 hash, and provenance metadata."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "9. **`DefangedLink`**: Interactive URL component with defanged display, safety copy actions, and redirect inspection trigger."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "10. **`RedirectChain`**: Multi-step flow visualizer showing HTTP status codes, unshortened domains, and landing targets."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "11. **`HomographDissector`**: Text comparator highlighting punycode and lookalike Cyrillic/Greek characters in domain names."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "12. **`GeoFlightMap`**: High-contrast vector world map with curved hop trajectories and jurisdiction flags."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "13. **`AttachmentCard`**: File card with magic byte validation, entropy gauge, hash copy triggers, and sandbox status."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "14. **`SandboxProcessTree`**: Hierarchical tree visualizer showing spawned processes and network callbacks during payload execution."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "15. **`DiffInspector`**: Side-by-side snapshot comparator showing changed evidence, delta risk, and newly resolved feeds."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "16. **`CopilotDock`**: Right-hand conversational assistant drawer with grounded evidence citation mechanics."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "17. **`EvidenceFootnote`**: Hyperlinked citation tag rendered inside AI explanations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "18. **`TriageTable`**: High-performance virtualized table supporting sorting, filtering, and density toggle modes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "19. **`QuickPeekDrawer`**: Sub-second keyboard-driven preview slideout for rapid alert triage."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "20. **`CommandPalette`**: Global `Cmd+K` keyboard modal for fast search, indicator lookup, and workflow actions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "21. **`JourneyTimeline`**: Chronological stepper visualizing the execution health of pipeline detection modules."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "22. **`MissingArtifactCard`**: Warning card detailing what data is absent and why confidence is degraded."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "23. **`ToolFailureAlert`**: Actionable error card displaying tool latency, failure codes, and retry buttons."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "24. **`HistoricalClusterCard`**: Contextually isolated card highlighting past related campaigns and blast radius."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "25. **`HexViewer`**: Raw byte and character offset inspector with search and copy capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "26. **`HeaderAnomalyTag`**: Warning tag highlighting date skews, duplicate headers, or suspicious X-mailer scripts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "27. **`ReportPreview`**: Live printable preview of the comprehensive forensic investigation report."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "28. **`AuditSeal`**: Cryptographic footer displaying SHA-256 report verification hash and investigator digital signature."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "29. **`SkeletonCard`**: Zero-layout-shift placeholder skeleton mimicking final forensic card geometry."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "30. **`KeyboardLegend`**: Modal cheat sheet displaying all hotkey bindings across inbox and workspace."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "31. **`PiiMaskToggle`**: Privacy toggle allowing authorized investigators to unmask or mask sensitive recipient identifiers."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "32. **`SlaIndicator`**: Dynamic countdown timer showing remaining triage time before operational SLA breach."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
