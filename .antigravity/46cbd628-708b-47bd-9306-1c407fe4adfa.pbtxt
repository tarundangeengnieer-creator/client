        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 25.3 Contrast Ratios & Typography Standards"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
