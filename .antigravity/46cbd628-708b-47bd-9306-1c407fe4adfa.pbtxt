        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 4.1 Base URL & Environment Configuration"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The frontend communicates directly with the FastAPI service. In development, the Vite proxy or Express bridge forwards requests to port `8001` (or the internal backend port). In containerized production, requests route via reverse proxy or configured base URL:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```typescript"
