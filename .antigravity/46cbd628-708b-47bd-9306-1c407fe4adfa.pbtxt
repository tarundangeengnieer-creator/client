        }
        lines {
          text: "  *`\"Requires Role: Tier 2 Incident Responder or higher to download live malware samples.\"`*"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- PII Redaction Mode: Analysts in lower-clearance roles view recipient email addresses and body text with partial masking (e.g., `c**@targetcorp.in`) to protect executive privacy."
